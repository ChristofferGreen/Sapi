{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_scouting.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "space_name",
    "question_id",
    "question_text",
    "candidates",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "source_scouting_v1"},
    "space_name": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^question-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "question_text": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "venue",
        "publication_year",
        "doi",
        "landing_url",
        "pdf_url",
        "public_access",
        "citation_signal",
        "ranking"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12}$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "venue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "reputation_rationale"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "type": {"enum": ["journal", "conference", "book", "preprint", "other"]},
            "publisher": {"type": ["string", "null"]},
            "reputation_rationale": {"type": "string", "minLength": 1}
          }
        },
        "publication_year": {"type": ["integer", "null"], "minimum": 1500, "maximum": 2100},
        "doi": {"type": ["string", "null"], "pattern": "^(10\\.\\S+|)$"},
        "landing_url": {"type": "string", "minLength": 1},
        "pdf_url": {"type": ["string", "null"]},
        "public_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_public_pdf", "access_status", "evidence"],
          "properties": {
            "has_public_pdf": {"type": "boolean"},
            "access_status": {"enum": ["public_pdf", "landing_page_only", "restricted", "unknown"]},
            "evidence": {"type": "string", "minLength": 1}
          }
        },
        "citation_signal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "provider", "as_of", "confidence"],
          "properties": {
            "count": {"type": ["integer", "null"], "minimum": 0},
            "provider": {"type": "string", "minLength": 1},
            "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "confidence": {"enum": ["unknown", "low", "medium", "high"]}
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank",
            "answer_fit_score",
            "venue_reputation_score",
            "citation_score",
            "interestingness_score",
            "overall_score",
            "answer_fit_rationale",
            "interestingness_rationale",
            "overall_rationale"
          ],
          "properties": {
            "rank": {"type": "integer", "minimum": 1},
            "answer_fit_score": {"type": "integer", "minimum": 0, "maximum": 5},
            "venue_reputation_score": {"type": "integer", "minimum": 0, "maximum": 5},
            "citation_score": {"type": "integer", "minimum": 0, "maximum": 5},
            "interestingness_score": {"type": "integer", "minimum": 0, "maximum": 5},
            "overall_score": {"type": "integer", "minimum": 0, "maximum": 20},
            "answer_fit_rationale": {"type": "string", "minLength": 1},
            "interestingness_rationale": {"type": "string", "minLength": 1},
            "overall_rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
