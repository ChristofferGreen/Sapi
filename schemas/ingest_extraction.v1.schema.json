{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingest_extraction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_date_inference",
    "source",
    "claims",
    "evidence_items",
    "relations",
    "summary",
    "warnings",
    "source_dossier"
  ],
  "properties": {
    "source_date_inference": {
      "type": [
        "object",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "display_title"
      ],
      "properties": {
        "display_title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "evidence_excerpts": {
                "type": "array",
                "description": "Compatibility mirror for claim-level evidence text. Canonical evidence pages are driven by top-level evidence_items.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "excerpt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "description": "Compatibility alias of evidence_excerpts.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "excerpt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "short_title": {
                "type": "string",
                "description": "Short proposition label for UI claim links. Prefer 3-7 words in compact truth-apt style (for example `X is Y`, `X implies Y`, `X constrains Y`) and avoid process narration (`the paper claims...`).",
                "minLength": 5,
                "maxLength": 96,
                "pattern": "^\\s*\\S+(?:\\s+\\S+){2,6}\\s*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Truth-apt proposition stated by the source content. Avoid publication-process narration (`the paper presents...`); rewrite to the underlying claim."
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "description": "Alias of text with the same truth-apt proposition expectations."
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "description": "Alias of text with the same truth-apt proposition expectations."
              }
            }
          }
        ]
      }
    },
    "evidence_items": {
      "type": "array",
      "description": "Canonical evidence objects for site evidence pages. These are authored by the semantic LLM and persisted as-is (validation only; no deterministic title/id derivation).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "title",
          "excerpt",
          "overview",
          "evidence_type",
          "claim_refs",
          "source_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^evidence-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$",
            "description": "Stable canonical evidence identifier; must already be slug+hash format."
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 96,
            "description": "Human-readable evidence label for cards and links."
          },
          "excerpt": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2400,
            "description": "Concrete evidence artifact text (measurement/proof/equation/table/figure/formal argument), not a generic claim paraphrase."
          },
          "overview": {
            "type": "string",
            "minLength": 80,
            "maxLength": 2600,
            "description": "Reader-facing explanation of why the evidence matters and what it establishes."
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "measurement",
              "statistical_result",
              "theorem",
              "proof_step",
              "formal_argument",
              "equation",
              "table_result",
              "figure_result",
              "observational_result",
              "model_constraint"
            ]
          },
          "claim_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Claim references (index, claim_key, or claim_id) resolved to canonical claim IDs during deterministic validation."
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "page_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": "Optional page references (for example `p.4`, `pp.4-5`, `Eq.7`)."
          }
        }
      }
    },
    "relations": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array"
    },
    "source_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_short",
        "summary_long",
        "sections"
      ],
      "properties": {
        "summary_short": {
          "type": "string",
          "minLength": 40,
          "maxLength": 420
        },
        "summary_long": {
          "type": "string",
          "minLength": 900,
          "maxLength": 12000
        },
        "sections": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "body",
              "grounding_claim_ids"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "body": {
                "type": "string",
                "minLength": 140,
                "maxLength": 2600
              },
              "grounding_claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
