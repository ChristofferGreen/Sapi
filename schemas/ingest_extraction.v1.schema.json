{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingest_extraction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_date_inference",
    "source",
    "claims",
    "relations",
    "summary",
    "warnings",
    "source_dossier"
  ],
  "properties": {
    "source_date_inference": {"type": ["object", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["display_title"],
      "properties": {
        "display_title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "evidence_excerpts": {
                "type": "array",
                "description": "Optional supporting evidence excerpts. Use only formal arguments/proofs, measurements/statistics, equations, or similarly concrete evidence artifacts; do not restate the claim text.",
                "items": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "excerpt": {"type": "string", "minLength": 1},
                        "quote": {"type": "string", "minLength": 1},
                        "text": {"type": "string", "minLength": 1},
                        "content": {"type": "string", "minLength": 1}
                      }
                    }
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "description": "Compatibility alias of `evidence_excerpts` with the same evidence-quality expectations.",
                "items": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "excerpt": {"type": "string", "minLength": 1},
                        "quote": {"type": "string", "minLength": 1},
                        "text": {"type": "string", "minLength": 1},
                        "content": {"type": "string", "minLength": 1}
                      }
                    }
                  ]
                }
              },
              "short_title": {
                "type": "string",
                "description": "Short proposition label for UI claim links. Prefer 3-7 words in compact truth-apt style (for example `X is Y`, `X implies Y`, `X constrains Y`) and avoid process narration (`the paper claims...`).",
                "minLength": 5,
                "maxLength": 96,
                "pattern": "^\\s*\\S+(?:\\s+\\S+){2,6}\\s*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Truth-apt proposition stated by the source content. Avoid publication-process narration (`the paper presents...`); rewrite to the underlying claim."
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "description": "Alias of `text` with the same truth-apt proposition expectations."
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "description": "Alias of `text` with the same truth-apt proposition expectations."
              }
            }
          }
        ]
      }
    },
    "relations": {"type": "array"},
    "summary": {"type": "string"},
    "warnings": {"type": "array"},
    "source_dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_short", "summary_long", "sections"],
      "properties": {
        "summary_short": {"type": "string", "minLength": 40, "maxLength": 420},
        "summary_long": {"type": "string", "minLength": 900, "maxLength": 12000},
        "sections": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "body", "grounding_claim_ids"],
            "properties": {
              "heading": {"type": "string", "minLength": 3, "maxLength": 120},
              "body": {"type": "string", "minLength": 140, "maxLength": 2600},
              "grounding_claim_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
