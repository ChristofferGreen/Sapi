{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question_measurement_extraction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "measurements",
    "chart_groups",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "question_measurement_extraction_v1"
    },
    "question_id": {
      "$ref": "#/$defs/question_id"
    },
    "measurements": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_id",
          "source_id",
          "claim_id",
          "evidence_id",
          "measure_name",
          "value",
          "value_max",
          "unit",
          "population",
          "outcome",
          "comparator",
          "uncertainty",
          "question_relevance"
        ],
        "properties": {
          "measurement_id": {
            "$ref": "#/$defs/measurement_id"
          },
          "source_id": {
            "$ref": "#/$defs/source_id"
          },
          "claim_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/claim_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/evidence_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "measure_name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "value_max": {
            "type": ["number", "null"]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "comparator": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "question_relevance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "anyOf": [
          {
            "properties": {
              "claim_id": {
                "$ref": "#/$defs/claim_id"
              }
            }
          },
          {
            "properties": {
              "evidence_id": {
                "$ref": "#/$defs/evidence_id"
              }
            }
          }
        ]
      }
    },
    "chart_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chart_group_id",
          "measure_name",
          "unit",
          "outcome",
          "population",
          "measurement_ids"
        ],
        "properties": {
          "chart_group_id": {
            "type": "string",
            "pattern": "^chart-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "measure_name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string"
          },
          "measurement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/measurement_id"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "question_id": {
      "type": "string",
      "pattern": "^question-[a-z0-9]+(?:-[a-z0-9]+)*(?:--[0-9a-f]{12,})?$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^measurement-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    }
  }
}
