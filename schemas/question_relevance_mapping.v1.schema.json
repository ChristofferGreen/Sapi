{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question_relevance_mapping.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "question_matches",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "question_relevance_mapping_v1"
    },
    "source_id": {
      "$ref": "#/$defs/source_id"
    },
    "question_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "relevance",
          "rationale",
          "claim_ids",
          "evidence_ids"
        ],
        "properties": {
          "question_id": {
            "$ref": "#/$defs/question_id"
          },
          "relevance": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/claim_id"
            }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidence_id"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "question_id": {
      "type": "string",
      "pattern": "^question-[a-z0-9]+(?:-[a-z0-9]+)*(?:--[0-9a-f]{12,})?$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-[a-z0-9]+(?:-[a-z0-9]+)*--[0-9a-f]{12,}$"
    }
  }
}

