{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comment_section_generation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["page_ref", "requested_count", "comments"],
  "properties": {
    "page_ref": {"type": "string"},
    "requested_count": {"type": "integer", "minimum": 5, "maximum": 50},
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["persona_id", "body"],
        "properties": {
          "comment_ref": {"type": "string"},
          "persona_id": {"type": "string"},
          "body": {"type": "string"},
          "parent_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
