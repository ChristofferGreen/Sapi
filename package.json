{
  "name": "sapi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Sapi reconstruction workspace",
  "scripts": {
    "test": "npm run test:pr",
    "test:pr": "pytest -q tests/unit tests/integration/failure tests/integration/pipelines -m \"not live_llm\"",
    "test:tier4-5": "pytest -q tests/integration/build tests/golden -m \"not live_llm\"",
    "test:golden": "npm run test:tier4-5",
    "test:live": "pytest -q tests/live -m \"live_llm\""
  }
}
