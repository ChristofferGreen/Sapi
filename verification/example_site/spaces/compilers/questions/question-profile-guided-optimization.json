        ],
        "support": "strong",
        "text": "Aestimo provides a credible evaluation method for workload sensitivity by isolating individual feedback-directed transformations, comparing optimization-log decision vectors, and running each generated binary across every workload input five times against a static baseline."
      },
      {
        "claim_ids": [
          "claim-workloads-extend-beyond-spec-inputs--d4e5f6a7b8c9",
          "claim-single-input-fdo-evaluation-is-unreliable--d0e1f2a3b4c5"
        ],
        "evidence_ids": [
          "evidence-spec-plus-additional-inputs--c409e7a11b8f"
        ],
        "source_ids": [
          "source-aestimo-a-feedback-directed-optimization-evaluation-tool--e1d344900b12"
        ],
        "support": "strong",
        "text": "The study's workload design strengthens the conclusion that reliability must be judged across many inputs, because it uses 116 total inputs, only 32 of which are SPEC-provided, rather than relying only on the standard benchmark input sets."
      },
      {
        "claim_ids": [
          "claim-training-inputs-change-fdo-outcomes--e5f6a7b8c9d0",
          "claim-itanium-fdo-inlining-improves-average-performance--f6a7b8c9d0e1"
        ],
        "evidence_ids": [
          "evidence-itanium-inlining-gains--d7b3409e6a21"
        ],
        "source_ids": [
          "source-aestimo-a-feedback-directed-optimization-evaluation-tool--e1d344900b12"
        ],
        "support": "moderate",
        "text": "Feedback-directed inlining shows meaningful potential but not uniform reliability: on Itanium it improves performance by about 6 percent on average, is slower than static in only 6 of 116 best-case cases, and exceeds a 10 percent gain in 41 cases."
      },
      {
        "claim_ids": [
          "claim-bzip2-inlining-logs-split-by-alignment--a7b8c9d0e1f2",
          "claim-bzip2-performance-varies-by-training-input--b8c9d0e1f2a3",
          "claim-single-input-fdo-evaluation-is-unreliable--d0e1f2a3b4c5"
        ],
        "evidence_ids": [
          "evidence-bzip2-inlining-metric-tables--0f6e2c99aa54",
          "evidence-bzip2-training-performance-range--b4a75e0f3d18"
        ],
        "source_ids": [
          "source-aestimo-a-feedback-directed-optimization-evaluation-tool--e1d344900b12"
        ],
        "support": "strong",
        "text": "Across bzip2 workloads, reliability is limited by training-input sensitivity: inlining decisions split sharply by alignment group, no callsite has universal yes consensus, and measured performance varies from about 2 percent gain for xml training to about 8 percent for combined training, with best-case gains ranging about 4 to 13 percent."
      },
      {
        "claim_ids": [
          "claim-resubstitution-does-not-predict-best-bzip2-performance--c9d0e1f2a3b4"
        ],
        "evidence_ids": [
          "evidence-bzip2-resubstitution-ranks--e52d196cc9b0"
        ],
        "source_ids": [
          "source-aestimo-a-feedback-directed-optimization-evaluation-tool--e1d344900b12"
        ],
        "support": "moderate",
        "text": "Same-input feedback quality does not reliably predict the fastest bzip2 binary in this ORC study, because resubstitution ranks are distributed across the possible range rather than consistently near the top."
      }
    ],
    "disagreements": [
      {
        "claim_ids": [
