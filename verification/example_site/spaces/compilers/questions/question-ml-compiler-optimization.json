        ],
        "source_ids": [
          "source-ansor-generating-high-performance-tensor-programs-for-deep-learning--839fb7edb551"
        ],
        "support": "moderate",
        "text": "The evidence also indicates that Ansor uses machine learning after generating complete valid programs, rather than relying on estimates of incomplete programs, which supports better optimization decisions within its search loop."
      }
