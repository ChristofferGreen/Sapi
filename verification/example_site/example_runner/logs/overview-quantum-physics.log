{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"set -euo pipefail\nprintf '%s\\\\n' '--- context.json ---'\ncat '/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/outputs/space_overview/subspace--quantum-physics/context.json'\nprintf '%s\\\\n' '--- records ---'\nfind '/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/sources/records' -maxdepth 1 -type f -print | sort\nprintf '%s\\\\n' '--- claims ---'\nfind '/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/claims' -maxdepth 1 -type f -print | sort\nprintf '%s\\\\n' '--- relations ---'\nfind '/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/relations' -maxdepth 1 -type f -print | sort\nprintf '%s\\\\n' '--- topics ---'\nfind '/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/topics' -maxdepth 1 -type f -print | sort\"","aggregated_output":"--- context.json ---\n{\n  \"claims\": [\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-agreement-among-full-patch-elided-and-predicted-fidelities-on-classically-verifi--c34d4d1d9279\",\n      \"evidence_excerpts\": [\n        \"The predicted, patch and elided fidelities all show good agreement with the fidelities of the corresponding full circuits, despite the vast differences in computational complexity and entanglement.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Verification supports extrapolation\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"Agreement among full, patch, elided, and predicted fidelities on classically verifiable circuits supports using elided circuits to estimate fidelity in the supremacy regime.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-atomic-ensemble-experiments-had-achieved-stored-heralded-entanglement-high-retri--7d38956d9ede\",\n      \"evidence_excerpts\": [\n        \"Conditional readout efficiencies of 74% in free space and 84% in a cavity were realized for state transfer from a single collective spin excitation to a single photon.\",\n        \"Heralded entanglement between distant ensembles was achieved in 2005, with the entangled state stored in quantum memories located in distinct apparatuses separated by 3 m; later work inferred C = 0.9 \\u00b1 0.3 for the concurrence.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Ensemble experiments store entanglement\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Atomic-ensemble experiments had achieved stored heralded entanglement, high retrieval efficiencies, and minimal scalable-node functionality by the time of the source discussion.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-circuit-depth-and-implementation-overhead-can-become-prohibitive-for-nominally-e--07b698d82789\",\n      \"evidence_excerpts\": [\n        \"One proposed realization of HHL is described as ballooning to approximately 10^25 circuit-size and depth overhead before optimization.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Overheads threaten practical speedups\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Circuit depth and implementation overhead can become prohibitive for nominally exponential quantum machine learning speedups without substantial algorithmic optimization and realistic cost estimates.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-controlled-cavity-pulses-can-generate-entanglement-first-between-an-atom-and-an--ee045e1c7175\",\n      \"evidence_excerpts\": [\n        \"An initial control field \\u03a91(t1) produces entanglement between internal atomic states and the polarization state of a flying photon; a second control field \\u03a92(t2) returns the atom to its initial state while generating a second flying photon, thereby leading to entanglement between the two emitted fields.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Cavity pulses entangle photons\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Controlled cavity pulses can generate entanglement first between an atom and an emitted photon and then between sequentially emitted photon polarizations.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-current-two-qubit-gate-and-measurement-error-rates-imply-that-uncorrected-nisq-c--68f47af68b82\",\n      \"evidence_excerpts\": [\n        \"With the best hardware we have now for controlling trapped ions or superconducting circuits, the error rate per gate for two-qubit gates is above the .1% level (and often much worse).\",\n        \"With these noisy devices we don\\u2019t expect to be able to execute a circuit that contains many more than about 1000 gates.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Gate errors cap circuits\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Current two-qubit gate and measurement error rates imply that uncorrected NISQ circuits cannot grow much beyond about one thousand fundamental two-qubit operations before noise overwhelms the signal.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-dark-state-adiabatic-control-can-reversibly-map-a-single-photon-optical-field-in--55c6ef7fe1ba\",\n      \"evidence_excerpts\": [\n        \"The dark state is |D\\u27e9 = cos \\u03b8 |a\\u27e9|0\\u27e9 + sin \\u03b8 |b\\u27e9|1\\u27e9, with the control field \\u03a9(t) steering the mapping between atomic and photonic components.\",\n        \"In the ideal case, |\\u03c6field(t)\\u27e9|b\\u27e9 \\u2192 |0\\u27e9(c1|a\\u27e9 + c0|b\\u27e9) ... \\u2192 |\\u03c6field(t + \\u03c4)\\u27e9|b\\u27e9.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Dark states map photons reversibly\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Dark-state adiabatic control can reversibly map a single-photon optical field into a trapped atom and later map the stored atomic state back into a flying optical field.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-deep-quantum-learning-can-use-quantum-annealers-programmable-photonic-circuits-a--0bdb973219c3\",\n      \"evidence_excerpts\": [\n        \"The review states that quantum annealers are easier to construct and scale than general-purpose quantum computers and are suited to deep quantum learners.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Special hardware supports deep learning\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Deep quantum learning can use quantum annealers, programmable photonic circuits, and quantum Boltzmann machines rather than requiring a large universal quantum computer.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-device-ansatz-strategies-can-provide-variationally-optimal-solutions-for-the-ava--64cad93bb7ab\",\n      \"evidence_excerpts\": [\n        \"The discussion proposes constructing the device first, defining its preparable states as a device ansatz, and obtaining a variationally optimal solution for the available quantum resources with circuit depth fixed by qubit coherence time.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Device ansatz optimizes resources\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Device ansatz strategies can provide variationally optimal solutions for the available quantum resources even when the ansatz differs from traditional chemistry-motivated forms.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-electromagnetically-induced-transparency-enables-deterministic-reversible-mappin--b76e4e96d4f0\",\n      \"evidence_excerpts\": [\n        \"Deterministic mapping of quantum states of light to and from atomic ensembles is possible by way of electromagnetically induced transparency.\",\n        \"Reversible mapping of photonic entanglement into and out of pairs of quantum memories was realized by an EIT process.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"EIT maps photonic memories\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Electromagnetically induced transparency enables deterministic reversible mapping of photonic states and photonic entanglement into and out of atomic-ensemble quantum memories.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-experimental-energy-estimates-are-limited-by-photon-source-impurity-photon-disti--780254eb8ba5\",\n      \"evidence_excerpts\": [\n        \"The systematic-error section reports a constant reproducible shift of 50 kJ mol^-1 in measured expectation values relative to theoretical energy, attributed to source, circuit, calibration, and coupling effects.\",\n        \"The paper notes that error magnitude increases with R because the first and second excited states become degenerate, making classical minimization harder and increasing estimation variance.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Noise shifts measured energies\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Experimental energy estimates are limited by photon-source impurity, photon distinguishability, circuit imperfections, coupling imbalance, and increasing degeneracy-related difficulty at larger bond separations.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-for-the-demonstrated-4x4-hamiltonian-the-quantum-expectation-estimation-approach--8aea71f20a05\",\n      \"evidence_excerpts\": [\n        \"The discussion states that a QPE circuit for a 4x4 Hamiltonian such as the one demonstrated would require at least 12 CNOT gates, while the reported method requires one.\",\n        \"The paper attributes this resource saving to replacing a serial sequence of controlled operations with parallelizable short coherent calculations and repeated state preparations.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"QEE reduces CNOT requirements\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"For the demonstrated 4x4 Hamiltonian, the quantum expectation-estimation approach uses fewer entangling-gate resources than phase estimation, requiring one CNOT gate instead of at least twelve.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-for-the-hardest-reported-random-circuit-sampling-task-sycamore-produced-one-mill--07db9778c4a3\",\n      \"evidence_excerpts\": [\n        \"For m = 20, obtaining a million samples on the quantum processor takes 200 seconds, whereas an equal-fidelity classical sampling would take 10,000 years on a million cores.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum sampling outpaces classical\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"For the hardest reported random-circuit sampling task, Sycamore produced one million samples in about 200 seconds while the authors estimated equal-fidelity classical sampling would take about 10,000 years on one million cores.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-full-density-matrix-characterization-becomes-an-impractical-verification-strateg--65a0be3566e1\",\n      \"evidence_excerpts\": [\n        \"Attempting to determine the density matrix \\u03c1(t) for the network surely fails because of the exponential growth in \\u03c1(t) with the size of the network.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Verification scales poorly\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Full density-matrix characterization becomes an impractical verification strategy as quantum networks grow because the state description scales exponentially with network size.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-hamiltonian-expectation-values-for-a-broad-class-of-physical-systems-reduce-to-s--ed045d2a43b4\",\n      \"evidence_excerpts\": [\n        \"Any Hamiltonian may be written as a sum of one- and multi-subsystem Pauli terms, and by linearity the expectation value becomes a weighted sum of corresponding Pauli-product expectation values.\",\n        \"The paper states that Hamiltonians with polynomially many terms include electronic-structure Hamiltonians, quantum Ising models, Heisenberg models, tensor-product approximable matrices, and more general k-sparse Hamiltonians.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Hamiltonians decompose into Pauli expectations\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Hamiltonian expectation values for a broad class of physical systems reduce to sums of Pauli-product expectation values measured on a quantum state.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-highly-entangled-quantum-dynamics-is-the-most-natural-arena-for-meaningful-quant--3b6f2f5ba268\",\n      \"evidence_excerpts\": [\n        \"The simulation of highly entangled quantum matter is the natural arena where quantum computers seem to have a clear advantage over classical ones.\",\n        \"Valuable insights might already be gleaned using noisy devices with of order 100 qubits.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum dynamics is promising\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Highly entangled quantum dynamics is the most natural arena for meaningful quantum advantage, and noisy devices around one hundred qubits may already yield valuable physical insight.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-hybrid-qaoa-and-vqe-approaches-are-plausible-nisq-era-testbeds-but-their-ability--31ec67369767\",\n      \"evidence_excerpts\": [\n        \"Will NISQ technology running QAOA or VQE be able to outperform classical algorithms that find approximate solutions to the same problems? Nobody knows.\",\n        \"The classical methods we use to solve these problems are well honed after decades of development.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"NISQ speedups remain uncertain\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Hybrid QAOA and VQE approaches are plausible NISQ-era testbeds, but their ability to outperform mature classical approximation methods remains unresolved.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-large-quantum-networks-require-reversible-interconnects-that-convert-quantum-sta--03b0b3a11218\",\n      \"evidence_excerpts\": [\n        \"Fundamental to this endeavor are quantum interconnects that convert quantum states from one physical system to those of another in a reversible fashion.\",\n        \"Desiderata for a quantum interface include user-controlled coupling, robustness against imperfections, efficient error detection, and the rate hierarchy \\u03c7 >> \\u03ba >> \\u03b3.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Networks require quantum interconnects\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Large quantum networks require reversible interconnects that convert quantum states between matter and light while preserving coherence and entanglement.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-large-scale-quantum-random-access-memory-and-quantum-state-readout-constraints-c--fa6ae1d801a4\",\n      \"evidence_excerpts\": [\n        \"Loading large classical data sets can require exponential time without qRAM, and reading full solution vectors or principal components can be exponentially hard.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Input output bottlenecks dominate\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Large-scale quantum random access memory and quantum-state readout constraints can erase practical advantages for many linear-algebra-based quantum machine learning algorithms on classical data.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-linear-cross-entropy-benchmarking-provides-a-fidelity-measure-by-comparing-exper--4abac38b173d\",\n      \"evidence_excerpts\": [\n        \"F_XEB = 2^n <P(x_i)>_i - 1, where n is the number of qubits, P(x_i) is the probability of bitstring x_i computed for the ideal quantum circuit, and the average is over the observed bitstrings.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"XEB measures circuit fidelity\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"Linear cross-entropy benchmarking provides a fidelity measure by comparing experimentally observed bitstrings with ideal probabilities computed by classical simulation.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-lower-gate-error-rates-matter-both-because-they-allow-larger-uncorrected-nisq-ci--043e58605f51\",\n      \"evidence_excerpts\": [\n        \"With more accurate quantum gates, quantum computers operating without error correction will be able to go further by executing larger circuits.\",\n        \"Better gates will also lower the overhead cost of doing quantum error correction when we eventually move on to fault-tolerant quantum computing.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Better gates enable scale\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Lower gate error rates matter both because they allow larger uncorrected NISQ circuits and because they reduce the future overhead of fault-tolerant error correction.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-measured-component-error-rates-under-simultaneous-operation-were-low-enough-to-s--6d6ae35745de\",\n      \"evidence_excerpts\": [\n        \"Average error values under simultaneous operation were single-qubit e1 = 0.16%, two-qubit e2 = 0.62%, two-qubit cycle e2c = 0.93%, and readout er = 3.8%.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Gate errors predict fidelity\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"Measured component error rates under simultaneous operation were low enough to support a model predicting measurable fidelity for full random circuits.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-nelder-mead-direct-search-was-more-robust-than-gradient-descent-for-the-noisy-ph--c886fbe39dc2\",\n      \"evidence_excerpts\": [\n        \"The methods section says gradient descent could not converge to the ground state under experimental conditions, mainly because of Poissonian source noise and accidental detection counts, while Nelder-Mead converged to the global minimum in most optimization runs.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Nelder Mead handles photon noise\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Nelder-Mead direct search was more robust than gradient descent for the noisy photonic optimization landscape and converged to the global minimum in most runs.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-nisq-computers-with-roughly-50-to-a-few-hundred-qubits-mark-a-classically-hard-s--2d5ec194bedf\",\n      \"evidence_excerpts\": [\n        \"50 qubits is a significant milestone, because that\\u2019s beyond what can be simulated by brute force using the most powerful existing digital supercomputers.\",\n        \"Noisy emphasizes that we\\u2019ll have imperfect control over those qubits; the noise will place serious limitations on what quantum devices can achieve in the near term.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Noise limits NISQ depth\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"NISQ computers with roughly 50 to a few hundred qubits mark a classically hard simulation regime, but noisy gates place serious near-term limits on what they can compute.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-nisq-devices-are-best-understood-as-experimental-tools-for-exploring-many-body-q--fde7f9646dbb\",\n      \"evidence_excerpts\": [\n        \"Physicists are excited about this NISQ technology, which gives us new tools for exploring the physics of many entangled particles.\",\n        \"NISQ is not likely to change the world all by itself. Instead, the primary goal for near-term quantum platforms should be to pave the way for bigger payoffs.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"NISQ enables quantum exploration\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"NISQ devices are best understood as experimental tools for exploring many-body quantum physics and as stepping stones toward more powerful quantum technologies, not as near-term world-changing machines.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-noise-resilient-circuit-design-can-extend-nisq-computational-reach-but-it-may-tr--aed4bcfeaa39\",\n      \"evidence_excerpts\": [\n        \"There is a substantial opportunity for experimentalists and theorists, working together over the next few years, to find better ways of making quantum circuits noise resilient.\",\n        \"Making a quantum circuit more noise resilient may also make it easier to simulate classically.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Noise resilience has tradeoffs\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Noise-resilient circuit design can extend NISQ computational reach, but it may trade off against classical simulability.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-quantum-basic-linear-algebra-subroutines-provide-exponential-speedups-for-fourie--009e83ff60b6\",\n      \"evidence_excerpts\": [\n        \"The review identifies quantum Fourier transforms, eigenvector and eigenvalue routines, and linear-system solvers as qBLAS primitives with exponential speedups.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"qBLAS enables exponential speedups\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Quantum basic linear algebra subroutines provide exponential speedups for Fourier transforms, eigenvalue estimation, eigenvector finding, and linear equation solving relative to the best known classical counterparts.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-quantum-boltzmann-machine-training-can-gain-quadratic-improvements-in-thermaliza--2d6a13e72831\",\n      \"evidence_excerpts\": [\n        \"Quantum methods can make Boltzmann systems thermalize quadratically faster and can quadratically reduce samples and training-data accesses.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum Boltzmann training accelerates\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Quantum Boltzmann machine training can gain quadratic improvements in thermalization, sampling, and training-data access under quantum-coherent or qRAM access assumptions.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-quantum-computers-are-not-expected-to-efficiently-solve-hard-np-hard-combinatori--0d5f718c4d47\",\n      \"evidence_excerpts\": [\n        \"We don\\u2019t expect, for example, that a quantum computer will be able to solve efficiently the hard instances of NP-hard problems like the traveling salesman problem.\",\n        \"Quantum computers can speed up exhaustive search, but only modestly, so NP-hard problems are likely to be quantumly hard as well as classically hard.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"NP-hard problems remain hard\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Quantum computers are not expected to efficiently solve hard NP-hard combinatorial optimization instances, although they may provide modest search speedups or useful heuristic approximations.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-quantum-computers-have-credible-grounds-for-super-classical-power-because-of-kno--2f85bd581bbb\",\n      \"evidence_excerpts\": [\n        \"We have at least three good reasons for thinking that quantum computers have capabilities surpassing what classical computers can do.\",\n        \"The theoretical computer scientists have provided arguments, based on complexity theory, showing under reasonable assumptions that quantum states which are easy to prepare with a quantum computer have super-classical properties.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum advantage has grounds\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Quantum computers have credible grounds for super-classical power because of known quantum algorithms, complexity-theoretic sampling arguments, and the absence of efficient classical simulations of general quantum computation.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-quantum-connectivity-gives-linked-nodes-a-state-space-that-scales-exponentially--50cc8b700a70\",\n      \"evidence_excerpts\": [\n        \"A network of quantum nodes linked by classical channels comprised of k nodes each with n qubits has a state space of dimension k2n, whereas a fully quantum network linked by quantum channels has an exponentially larger dimension 2kn.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum channels expand state space\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Quantum connectivity gives linked nodes a state space that scales exponentially across all nodes, unlike classically connected quantum processors whose state spaces remain separate by node.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-quantum-expectation-estimation-reduces-coherent-evolution-demands-relative-to-ph--e17864953251\",\n      \"evidence_excerpts\": [\n        \"The approach gives O(1) coherence time for a single measurement after state preparation, while requiring O(|hmax|^2 M p^-2) repetitions to estimate a Hamiltonian term to precision p.\",\n        \"The source contrasts this with standard quantum phase estimation, where O(p^-1) successive applications of e^-iHt determine the coherent runtime.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"QEE reduces coherent evolution\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Quantum expectation estimation reduces coherent-evolution demands relative to phase estimation by replacing one long coherent evolution with many short expectation-value measurements.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-quantum-machine-learning-can-outperform-classical-algorithms-on-specific-pattern--ade088c638d0\",\n      \"evidence_excerpts\": [\n        \"Quantum speedup is defined by lower query or gate complexity for a quantum algorithm than for the corresponding classical algorithm.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum learning can accelerate analysis\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Quantum machine learning can outperform classical algorithms on specific pattern-recognition and data-analysis tasks when quantum algorithms exploit coherence, entanglement, or quantum access models.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-quantum-machine-learning-for-quantum-data-can-reduce-tomography-and-characteriza--b02ec76133c0\",\n      \"evidence_excerpts\": [\n        \"Quantum analysis of density matrices can reveal principal components and dynamics with exponentially fewer measurements than full quantum state reconstruction.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Quantum data avoids full tomography\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Quantum machine learning for quantum data can reduce tomography and characterization costs by extracting principal components, dynamics, or expectation-value summaries without full state reconstruction.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-quantum-principal-component-analysis-can-diagonalize-a-covariance-like-density-m--6ee32a171ac2\",\n      \"evidence_excerpts\": [\n        \"qRAM maps classical vectors into quantum states, repeated sampling forms a density matrix proportional to covariance, and phase estimation extracts principal-component information.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"qPCA diagonalizes quantum covariance\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"Quantum principal component analysis can diagonalize a covariance-like density matrix and estimate principal components exponentially more efficiently than classical PCA when data are available in quantum form.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-random-quantum-circuits-become-exponentially-harder-to-simulate-classically-as-q--f7cd81f80f31\",\n      \"evidence_excerpts\": [\n        \"Random circuits are a suitable choice for benchmarking because they do not possess structure and therefore allow for limited guarantees of computational hardness. Classically computing this probability distribution becomes exponentially more difficult as the number of qubits and number of gate cycles grow.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Random circuits scale exponentially\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"Random quantum circuits become exponentially harder to simulate classically as qubit count and circuit depth increase because their output distributions lack exploitable structure.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:52:46Z\",\n      \"claim_id\": \"claim-scalable-fault-tolerant-quantum-computing-depends-on-quantum-error-correction-bu--cf48bc246343\",\n      \"evidence_excerpts\": [\n        \"Quantum error correction imposes a heavy overhead cost in number of qubits and number of gates, scaling up using quantum error correction is a more distant goal.\",\n        \"To run algorithms involving thousands of protected qubits we\\u2019ll need a number of physical qubits which is in the millions, or more.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Error correction remains distant\",\n      \"source_id\": \"source-01-quantum-computing-in-the-nisq-era-and-beyond--2ce59b8ba8bb\",\n      \"text\": \"Scalable fault-tolerant quantum computing depends on quantum error correction, but the physical-qubit overhead makes that era a longer-term objective rather than a near-term NISQ capability.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-scalable-quantum-networks-are-likely-to-be-heterogeneous-systems-that-combine-ca--dfe53fef0772\",\n      \"evidence_excerpts\": [\n        \"The current state of the art is primitive relative to that required for robust and scalable implementation of sophisticated network protocols; quantum memories, local quantum processing, quantum repeaters, and error-corrected teleportation remain ambitious goals.\",\n        \"Quantum networks will evolve as heterogeneous entities, and a critical task is the development of unambiguous procedures for entanglement verification.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Heterogeneous networks need verification\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Scalable quantum networks are likely to be heterogeneous systems that combine cavity-QED nodes, ensemble memories, repeaters, local processing, error-corrected teleportation, and stronger entanglement-verification procedures.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-strong-cavity-qed-coupling-supplies-a-physical-regime-in-which-individual-atoms--9807d4e35625\",\n      \"evidence_excerpts\": [\n        \"Experiments in cavity QED explore strong coupling with g > (\\u03b3, \\u03ba), where \\u03b3 is the atomic decay rate to modes other than the cavity mode and \\u03ba is the decay rate of the cavity mode itself.\",\n        \"The number of photons required to saturate the intracavity atom is n0 \\u223c \\u03b3\\u00b2/g\\u00b2, and the number of atoms required to affect the intracavity field is N0 \\u223c \\u03ba\\u03b3/g\\u00b2; strong coupling explores the regime (n0, N0) << 1.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Strong coupling enables interfaces\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"Strong cavity-QED coupling supplies a physical regime in which individual atoms and photons can interact coherently enough to function as quantum-network nodes and interfaces.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-the-demonstrated-integrated-photonic-processor-prepares-and-measures-arbitrary-t--f41a0c8f645b\",\n      \"evidence_excerpts\": [\n        \"Figure 2 reports quantum-state preparation and Pauli-basis measurement on a photonic chip using thermal phase shifters, one CNOT gate, spontaneous-parametric-downconversion photon pairs, and detectors D1-D4.\",\n        \"The text states that state preparation and measurement in the Pauli basis is achieved by setting eight voltage-driven phase shifters and counting photon detection events with silicon single-photon detectors.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Photonic chip prepares two qubits\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"The demonstrated integrated photonic processor prepares and measures arbitrary two-qubit pure states using voltage-controlled phase shifters, one CNOT gate, photon-pair inputs, and detector count rates.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-the-demonstrated-speedup-is-specific-to-random-circuit-sampling-and-does-not-rem--47d4f349751e\",\n      \"evidence_excerpts\": [\n        \"Realizing the full promise of quantum computing using Shor's algorithm for factoring, for example, still requires technical leaps to engineer fault-tolerant logical qubits.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Fault tolerance remains necessary\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"The demonstrated speedup is specific to random circuit sampling and does not remove the need for fault-tolerant logical qubits for applications such as Shor-style factoring.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:12:22Z\",\n      \"claim_id\": \"claim-the-dlcz-protocol-creates-heralded-entanglement-between-atomic-ensembles-by-inte--aa516185d3b2\",\n      \"evidence_excerpts\": [\n        \"A photoelectric detection event at either detector projects the ensembles into |\\u03a8L,R\\u27e9 = 1/\\u221a2 [|0a\\u27e9L|1a\\u27e9R \\u00b1 ei\\u03b71|1a\\u27e9L|0a\\u27e9R].\",\n        \"Detection of a photon from one or the other atomic ensemble in an indistinguishable fashion results in an entangled state with one collective spin excitation shared coherently between the ensembles.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"DLCZ heralds ensemble entanglement\",\n      \"source_id\": \"source-03-the-quantum-internet--cd7f6b2f11e2\",\n      \"text\": \"The DLCZ protocol creates heralded entanglement between atomic ensembles by interfering emitted single-photon fields and conditioning on a detector event.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-the-hhl-linear-system-algorithm-can-output-a-quantum-state-proportional-to-a-sol--9531ddbd1acc\",\n      \"evidence_excerpts\": [\n        \"HHL takes O((log N)^2) quantum steps to output |x>, but full recovery of x can require many measurements and suitable state preparation.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"HHL has conditional advantage\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"The HHL linear-system algorithm can output a quantum state proportional to a solution vector in polylogarithmic time under sparsity, conditioning, input-preparation, and readout assumptions.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-the-largest-elided-53-qubit-20-cycle-circuits-yielded-f-xeb-2-24-0-21-10-3-over--0a24f12d0686\",\n      \"evidence_excerpts\": [\n        \"For the largest circuit with 53 qubits and 20 cycles, we collected N_s = 30 \\u00d7 10^6 samples over ten circuit instances, obtaining F_XEB = (2.24 \\u00b10.21) \\u00d7 10^-3 for the elided circuits. With 5\\u03c3 confidence, we assert that the average fidelity of running these circuits on the quantum processor is greater than at least 0.1%.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Elided circuits retain fidelity\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"The largest elided 53-qubit, 20-cycle circuits yielded F_XEB = (2.24 \\u00b1 0.21) \\u00d7 10^-3 over 30 million samples, supporting an average fidelity above 0.1% with 5\\u03c3 confidence.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-the-largest-random-circuits-combined-53-qubits-1-113-single-qubit-gates-430-two--c8ece98aae87\",\n      \"evidence_excerpts\": [\n        \"Our largest random quantum circuits have 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and a measurement on each qubit, for which we predict a total fidelity of 0.2%.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Large circuits remain measurable\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"The largest random circuits combined 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and one measurement per qubit, for which the authors predicted a total fidelity of 0.2%.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:29:01Z\",\n      \"claim_id\": \"claim-the-near-term-viability-of-quantum-machine-learning-depends-on-solving-input-out--0091df09ad90\",\n      \"evidence_excerpts\": [\n        \"The review distills four caveats for future work: input problem, output problem, costing problem, and benchmarking problem.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Viability needs practical benchmarks\",\n      \"source_id\": \"source-05-quantum-machine-learning--a91f0184eb29\",\n      \"text\": \"The near-term viability of quantum machine learning depends on solving input, output, costing, and benchmarking problems rather than only proving asymptotic speedups.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-the-photonic-variational-eigensolver-experimentally-recovered-the-he-h-bond-diss--5898494f9b1f\",\n      \"evidence_excerpts\": [\n        \"The paper reports that, after correcting computed energies for experimental errors, the equilibrium bond length was R = 92.3\\u00b10.1 pm with ground-state electronic energy E = -2.865\\u00b10.008 MJ mol^-1.\",\n        \"More than 96% of the experimental data are reported to fall within chemical accuracy relative to theoretical values.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"QVE resolves He-H+ energy\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"The photonic variational eigensolver experimentally recovered the He-H+ bond-dissociation curve, finding an equilibrium bond length of 92.3\\u00b10.1 pm and a ground-state electronic energy of -2.865\\u00b10.008 MJ mol^-1 after correction.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-the-quantum-variational-eigensolver-prepares-approximate-ground-states-by-using--0037de1d8464\",\n      \"evidence_excerpts\": [\n        \"Figure 1 describes quantum modules passing expectation values to a CPU, which computes the Hamiltonian expectation and feeds new state parameters back to the quantum processing unit.\",\n        \"The text states that varying experimental state-preparation parameters and computing the Rayleigh-Ritz quotient using QEE as a subroutine can prepare unknown eigenvectors.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"QVE minimizes Rayleigh Ritz energy\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"The quantum variational eigensolver prepares approximate ground states by using quantum expectation estimation inside a classical minimization of the Rayleigh-Ritz quotient.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T15:59:28Z\",\n      \"claim_id\": \"claim-the-sycamore-superconducting-processor-created-random-circuit-quantum-states-on--2b4eeabd4063\",\n      \"evidence_excerpts\": [\n        \"Here we report the use of a processor with programmable superconducting qubits to create quantum states on 53 qubits, corresponding to a computational state-space of dimension 2^53 (about 10^16).\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Sycamore reaches 53 qubits\",\n      \"source_id\": \"source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8\",\n      \"text\": \"The Sycamore superconducting processor created random-circuit quantum states on 53 qubits, corresponding to a computational state space of 2^53, about 10^16 basis states.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T16:22:43Z\",\n      \"claim_id\": \"claim-unitary-coupled-cluster-ansatz-states-can-be-represented-with-polynomially-many--7f92a3b77387\",\n      \"evidence_excerpts\": [\n        \"For fixed excitation level k, the reduced cluster operator contains O(N^k(M-N)^k) terms, and after Jordan-Wigner transformation the preparation problem becomes simulation of a Hamiltonian that is a polynomial sum of Pauli products.\",\n        \"The paper states that no efficient classical implementation of this ansatz has been developed even for low-order cluster operators, while the state may be prepared efficiently on a quantum device.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"UCC states favor quantum preparation\",\n      \"source_id\": \"source-04-a-variational-eigenvalue-solver-on-a-photonic-quantum-processor--4678297edf5b\",\n      \"text\": \"Unitary coupled-cluster ansatz states can be represented with polynomially many reduced cluster terms and are efficiently preparable on quantum hardware despite lacking a known efficient classical implementation.\"\n    }\n  ],\n  \"freshness\": {\n    \"claim_count\": 49,\n    \"generated_at\": \"2026-04-26T18:16:07Z\",\n    \"input_signature\": \"sha256:8e11fe08c698fcb6e5974c22c9aef0fb96800d40aa6bbcf7dc07bc93454d0ea9\",\n    \"relation_count\": 30,\n    \"source_record_count\": 5,\n    \"topic_count\": 15\n  },\n  \"metadata\": {\n    \"overview_id\": \"subspace--quantum-physics\",\n    \"parent_space_name\": \"physics\",\n    \"scope_kind\": \"subspace\",\n    \"scope_name\": \"quantum-physics\",\n    \"scope_title\": \"Quantum Physics\",\n    \"space_name\": \"quantum-physics\"\n  },\n  \"relations\": [\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-large-quantum-networks-require-reversible-interconnects-that-convert-quantum-sta--03b0b3a11218\",\n      \"dst_claim_ref\": \"0\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"The dark-state mapping protocol instantiates the general reversible-interconnect requirement.\",\n      \"relation_file_id\": \"rel-9b905f7254c175c67d7f994b7420bf84490519ffa6b20c2a11e25f8ba745c26f\",\n      \"relation_id\": \"derived_from:claim-dark-state-adiabatic-control-can-reversibly-map-a-single-photon-optical-field-in--55c6ef7fe1ba->claim-large-quantum-networks-require-reversible-interconnects-that-convert-quantum-sta--03b0b3a11218\",\n      \"relation_