ti--780254eb8ba5'\nclaim_ansatz = 'claim-device-ansatz-strategies-can-provide-variationally-optimal-solutions-for-the-ava--64cad93bb7ab'\n\nclaim_qml_specific = 'claim-quantum-machine-learning-can-outperform-classical-algorithms-on-specific-pattern--ade088c638d0'\nclaim_qblas = 'claim-quantum-basic-linear-algebra-subroutines-provide-exponential-speedups-for-fourie--009e83ff60b6'\nclaim_hhl = 'claim-the-hhl-linear-system-algorithm-can-output-a-quantum-state-proportional-to-a-sol--9531ddbd1acc'\nclaim_io_bottleneck = 'claim-large-scale-quantum-random-access-memory-and-quantum-state-readout-constraints-c--fa6ae1d801a4'\nclaim_overheads = 'claim-circuit-depth-and-implementation-overhead-can-become-prohibitive-for-nominally-e--07b698d82789'\nclaim_qml_benchmarks = 'claim-the-near-term-viability-of-quantum-machine-learning-depends-on-solving-input-out--0091df09ad90'\nclaim_quantum_data = 'claim-quantum-machine-learning-for-quantum-data-can-reduce-tomography-and-characteriza--b02ec76133c0'\n\nclaim_ids = [\n    claim_nisq_scale,\n    claim_gate_errors,\n    claim_nisq_tools,\n    claim_error_correction,\n    claim_hybrid_uncertain,\n    claim_advantage_grounds,\n    claim_sycamore_53,\n    claim_random_hard,\n    claim_xeb,\n    claim_verification,\n    claim_sampling_gap,\n    claim_speedup_specific,\n    claim_elided_fidelity,\n    claim_component_errors,\n    claim_networks,\n    claim_cavity,\n    claim_eit,\n    claim_verification_scales,\n    claim_heterogeneous,\n    claim_entangled_nodes,\n    claim_dlcz,\n    claim_photonic_chip,\n    claim_qve,\n    claim_qee,\n    claim_hamiltonian,\n    claim_noise_energy,\n    claim_ansatz,\n    claim_qml_specific,\n    claim_qblas,\n    claim_hhl,\n    claim_io_bottleneck,\n    claim_overheads,\n    claim_qml_benchmarks,\n    claim_quantum_data,\n]\n\nobj = {\n    'schema_version': 'space_overview_v1',\n    'metadata': {\n        'overview_id': 'subspace--quantum-physics',\n        'scope_kind': 'subspace',\n        'space_name': 'quantum-physics',\n        'scope_name': 'quantum-physics',\n        'title': 'State of the Evidence in Quantum Physics',\n        'summary': 'The collected quantum-physics evidence presents near-term quantum systems as scientifically valuable but constrained: noisy processors can reach classically hard sampling regimes, hybrid algorithms can reduce coherence demands, quantum networks require reliable light-matter interfaces, and machine-learning speedups remain conditional on access, readout, and benchmarking assumptions.'\n    },\n    'sections': [\n        {\n            'section_id': 'topic_framing',\n            'heading': 'Topic Framing',\n            'body': 'This subspace is framed around the transition from theoretical quantum advantage to experimentally constrained quantum technologies. The NISQ evidence treats devices with roughly 50 to a few hundred noisy qubits as a classically hard regime, but not as general-purpose fault-tolerant machines. The Sycamore evidence supplies a concrete random-circuit sampling milestone, while the network, variational, and machine-learning sources broaden the frame from isolated processors to interfaces, short-coherence algorithms, and conditional data-analysis speedups.',\n            'source_ids': [source_01, source_02, source_03, source_04, source_05],\n            'claim_ids': [claim_nisq_scale, claim_gate_errors, claim_nisq_tools, claim_sycamore_53, claim_networks, claim_qve, claim_qml_specific],\n            'citation_anchor_ids': ['anchor-nisq-scale', 'anchor-random-circuit-sampling', 'anchor-quantum-networks', 'anchor-photonic-vqe', 'anchor-qml-bottlenecks']\n        },\n        {\n            'section_id': 'key_themes',\n            'heading': 'Key Themes',\n            'body': 'The dominant themes are scale, noise, verification, and hardware-native adaptation. Random circuits become harder to simulate as qubits and depth grow, but their claims depend on cross-entropy benchmarking, component-error models, and extrapolation from verifiable circuits. Hybrid variational methods respond to short coherence by replacing long coherent evolution with repeated expectation measurements and classical optimization. Quantum-network claims likewise center on preserving coherence across matter-light interfaces, while quantum machine learning turns on whether qBLAS, HHL, qPCA, or quantum-data workflows can avoid data-loading and readout bottlenecks.',\n            'source_ids': [source_02, source_04, source_03, source_05],\n            'claim_ids': [claim_random_hard, claim_xeb, claim_verification, claim_component_errors, claim_qee, claim_hamiltonian, claim_networks, claim_cavity, claim_qblas, claim_hhl, claim_quantum_data],\n            'citation_anchor_ids': ['anchor-random-circuit-sampling', 'anchor-photonic-vqe', 'anchor-quantum-networks', 'anchor-qml-bottlenecks']\n        },\n        {\n            'section_id': 'agreement_and_disagreement',\n            'heading': 'Agreement and Disagreement',\n            'body': 'Across the sources there is broad agreement that quantum systems can access regimes with poor classical simulability, especially through entanglement, sampling, and quantum data. The tensions are mostly about scope rather than the existence of quantum effects: NISQ and Sycamore evidence agree that near-term demonstrations do not remove the need for fault tolerance; QML speedup claims are explicitly weakened by circuit-depth, qRAM, input, output, and costing constraints; and network proposals agree on the promise of distributed entanglement while warning that full density-matrix verification will not scale.',\n            'source_ids': [source_01, source_02, source_05, source_03],\n            'claim_ids': [claim_advantage_grounds, claim_hybrid_uncertain, claim_error_correction, claim_sampling_gap, claim_speedup_specific, claim_qml_specific, claim_io_bottleneck, claim_overheads, claim_verification_scales, claim_heterogeneous],\n            'citation_anchor_ids': ['anchor-nisq-scale', 'anchor-random-circuit-sampling', 'anchor-qml-bottlenecks', 'anchor-quantum-networks']\n        },\n        {\n            'section_id': 'methods_and_evidence',\n            'heading': 'Methods and Evidence',\n            'body': 'The evidence base mixes review synthesis with laboratory demonstrations. Preskill supplies a conceptual and error-budget framing for NISQ limits. The Sycamore source uses a programmable 53-qubit superconducting processor, XEB, elided-circuit fidelity estimates, and classical simulation comparisons. Kimble surveys cavity-QED, EIT, and DLCZ-style interfaces for quantum networking. The photonic VQE work demonstrates a two-qubit integrated processor and expectation-estimation loop for He-H+ energies, while the QML review catalogs algorithmic primitives and the assumptions needed for end-to-end advantage.',\n            'source_ids': [source_01, source_02, source_03, source_04, source_05],\n            'claim_ids': [claim_gate_errors, claim_xeb, claim_elided_fidelity, claim_sampling_gap, claim_cavity, claim_eit, claim_dlcz, claim_photonic_chip, claim_qve, claim_noise_energy, claim_qblas, claim_hhl],\n            'citation_anchor_ids': ['anchor-nisq-scale', 'anchor-random-circuit-sampling', 'anchor-quantum-networks', 'anchor-photonic-vqe', 'anchor-qml-bottlenecks']\n        },\n        {\n            'section_id': 'open_questions',\n            'heading': 'Open Questions',\n            'body': 'The open questions are practical and comparative. The corpus does not resolve whether NISQ hybrid algorithms can beat mature classical heuristics, how quickly lower error rates can reduce fault-tolerance overhead, or which benchmarks establish useful quantum advantage beyond random sampling. It also leaves open how scalable networks should verify entanglement without exponential tomography, and whether quantum machine-learning pipelines can supply input, preserve speedups through circuit implementation, and extract useful classical outputs