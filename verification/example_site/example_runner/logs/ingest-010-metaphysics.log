tion/example_site/spaces/metaphysics/claims/claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4.json\nverification/example_site/spaces/metaphysics/claims/claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d.json\nverification/example_site/spaces/metaphysics/relations/rel-14833df26d3af3df2179637f4f8a9004b4d2c8b59184695970bbb8175af48a4b.json\nverification/example_site/spaces/metaphysics/relations/rel-1887e471d0c6bca41ab4d303b82973be0280997bb7312352e6ded8b488e7839c.json\nverification/example_site/spaces/metaphysics/relations/rel-297478f9e860c398d6428ff1335cbdaeee74b51498299c179ccc3a0e2a0baf2c.json\nverification/example_site/spaces/metaphysics/relations/rel-2d609042b0c42b3477d6c2afe1f8de05328f73d710a3324322cb70690f8b923f.json\nverification/example_site/spaces/metaphysics/relations/rel-36ef724159190a46cace6a927af6cbdafcf4fe73fd0aad36094fa6956d97b569.json\nverification/example_site/spaces/metaphysics/relations/rel-64140bcb5a4e30ab2c5491abfb14611c14f337a33058a66b5b7cc01932803f34.json\nverification/example_site/spaces/metaphysics/relations/rel-65e504212a9c029c999e049e3f08217d4aae2701fce83a8fa3977f001d963564.json\nverification/example_site/spaces/metaphysics/relations/rel-79c129b7960eaf0be7729619662a407c8d067a3dc6dfc68703c520bcb8a8379e.json\nverification/example_site/spaces/metaphysics/relations/rel-79e0c8d5f111557dd929758b02485f6e61fd9cc9fae0a8ed83822ae8b8fb09d4.json\nverification/example_site/spaces/metaphysics/relations/rel-88c5729456db9ecad96481135821dcc403ff887537ab02b205b87c537cf12c74.json\nverification/example_site/spaces/metaphysics/relations/rel-8e5aba11a9eae1c477e65715f38cb35eeee6a9fab1ff413f1c324cb20b0e093d.json\nverification/example_site/spaces/metaphysics/relations/rel-90cc659ab02d83f477c7c7a02f365b79e7ddedc7a9ffa998606fdf782eabf6b6.json\nverification/example_site/spaces/metaphysics/relations/rel-92fe7e399f01e3c73d2115874f8c711566c2487e967518b977ed8906e8cb6041.json\n