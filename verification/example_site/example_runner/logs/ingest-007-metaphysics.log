i/verification/example_site/spaces/metaphysics/relations/rel-1887e471d0c6bca41ab4d303b82973be0280997bb7312352e6ded8b488e7839c.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-36ef724159190a46cace6a927af6cbdafcf4fe73fd0aad36094fa6956d97b569.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-64140bcb5a4e30ab2c5491abfb14611c14f337a33058a66b5b7cc01932803f34.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-79e0c8d5f111557dd929758b02485f6e61fd9cc9fae0a8ed83822ae8b8fb09d4.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-8e5aba11a9eae1c477e65715f38cb35eeee6a9fab1ff413f1c324cb20b0e093d.json\n","exit_code":0,"status":"completed"}}
