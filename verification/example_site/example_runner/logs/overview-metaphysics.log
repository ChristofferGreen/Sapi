s/claim-greater-lifetime-psychedelic-use-correlates-with-stronger-baseline-panpsychist-b--a024d2968b54.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-ground-theoretic-status-is-preserved-under-factual-identity-because-the-proposed--4aecebbdb4a2.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-and-essence-can-both-be-analyzed-in-terms-of-generalized-identity-yiel--e2abdab353f9.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-does-not-entail-being-more-fundamental-than-so-appeals-to-relative-fun--0468a01c8a45.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-necessity-is-not-secured-merely-by-treating-grounding-as-a-determinati--23325d0a6e99.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-if-a-fact-p-is-fully-grounded-in-a-plurality-of-facts-d-then-the-conjunction-of--dbb969101dbd.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-if-being-f-grounds-being-g-then-the-fact-that-being-f-necessitates-being-g-can-b--685ae4dcbfb4.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-in-a-randomized-controlled-depression-trial-psilocybin-therapy-produced-shifts-a--7cfb0c0f75e7.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-most-psychedelic-associated-shifts-in-non-physicalist-metaphysical-beliefs-persi--9591d5bd7c0c.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-necessary-entailment-or-equivalence-is-not-sufficient-for-essence-because-genera--162946956228.json\n/Users/chrgre01/src/Sapi/verification/example_site/s