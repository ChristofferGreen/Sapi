asymmetry.\",\n      \"relation_file_id\": \"rel-957366ee9951a19ce9186176a2ee739da5516eab0b7fd08b17a0356e9548051e\",\n      \"relation_id\": \"supports:claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5->claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5\",\n      \"src_claim_ref\": \"7\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"dst_claim_ref\": \"0\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"If truthmaking is a grounding species, its non-transitivity bears on grounding's strict-order status.\",\n      \"relation_file_id\": \"rel-fae0542d4f5bb8fc520b8c849f3505f240f95eedd61b7b37da9996e8569f0945\",\n      \"relation_id\": \"supports:claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf->claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf\",\n      \"src_claim_ref\": \"1\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"dst_claim_ref\": \"0\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Self-truthmaking supplies a case against irreflexivity.\",\n      \"relation_file_id\": \"rel-d320fa93571942b877ed906822139f1808dca9a7281b397a8db9751a399943be\",\n      \"relation_id\": \"supports:claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4->claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4\",\n      \"src_claim_ref\": \"5\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"dst_claim_ref\": \"0\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"The truthmaking chain supplies the source's positive case against transitivity.\",\n      \"relation_file_id\": \"rel-14833df26d3af3df2179637f4f8a9004b4d2c8b59184695970bbb8175af48a4b\",\n      \"relation_id\": \"supports:claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d->claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d\",\n      \"src_claim_ref\": \"4\",\n      \"status\": \"open\"\n    }\n  ],\n  \"schema_version\": \"space_overview_context_v1\",\n  \"source_records\": [\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Kelly Trogdon\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Grounding Is Necessary Through Essence\",\n      \"external_related_links\": [\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"doi.org\",\n          \"link_type\": \"canonical_paper\",\n          \"provenance\": {\n            \"origin\": \"reference_doi\",\n            \"source_field\": \"references[1].doi\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from a DOI found in the source references.\",\n          \"title\": \"Pacific Philosophical Quarterly 94 465\\u2013485\",\n          \"url\": \"https://doi.org/10.1111/papq.12009\"\n        }\n      ],\n      \"ingested_at\": \"2026-04-26T15:04:12Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"Philosophy Spring Edition . Available online at: /\",\n          \"url\": \"http://plato.stanford.edu/entries\",\n          \"year\": 2010\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": \"10.1111/papq.12009\",\n          \"linked_source_ids\": [],\n          \"title\": \"Pacific Philosophical Quarterly 94 465\\u2013485\",\n          \"url\": null,\n          \"year\": 2013\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": null,\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"enriched\",\n        \"warnings\": [\n          \"Skipped 1 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"unknown\",\n        \"date\": null,\n        \"origin\": \"unknown\",\n        \"rationale\": null\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The article\\u2019s central thesis is not that grounding is a modal relation in every possible respect, but that full grounds necessitate what they ground. Formally, when [p] is fully grounded in D, the conjunction of propositions corresponding to D metaphysically entails p. This makes necessity a constraint on complete explanations rather than on every partial explanatory factor.\",\n            \"grounding_claim_ids\": [\n              \"0\"\n            ],\n            \"heading\": \"Target Thesis\"\n          },\n          {\n            \"body\": \"Trogdon rejects two quick routes to the conclusion. A determination-relation argument is too broad because causation can determine without the relevant necessity. A definitional route is also unstable because necessary truths can have partial grounds that satisfy modal entailment trivially. The necessity thesis therefore needs a non-circular explanation.\",\n            \"grounding_claim_ids\": [\n              \"1\"\n            ],\n            \"heading\": \"Why Shortcuts Fail\"\n          },\n          {\n            \"body\": \"The significance principle introduces the epistemic constraint: full grounding rules out a cognitively significant connecting question. If a suitably informed rational subject could still find it substantively open why [p] obtains given D, then D has not supplied a full ground for [p]. Paradigm logical grounding cases are used to motivate this generalization.\",\n            \"grounding_claim_ids\": [\n              \"2\",\n              \"6\"\n            ],\n            \"heading\": \"Cognitive Significance\"\n          },\n          {\n            \"body\": \"The essence principle explains why the connecting question disappears. On the Finean picture, real definitions or essential truths disclose what the relevant facts and entities are. When those truths include or entail \\u2227D \\u2192 p, grasping the natures involved makes the connection intelligible rather than arbitrarily modal.\",\n            \"grounding_claim_ids\": [\n              \"3\"\n            ],\n            \"heading\": \"Essence Link\"\n          },\n          {\n            \"body\": \"The proof combines the two principles with the necessity of essential truths. Full grounding gives cognitive insignificance; cognitive insignificance points to essential truths by which D entails p; and essential truths hold metaphysically necessarily. The result is \\u25a1(\\u2227D \\u2192 p), which is the article\\u2019s target form of grounding necessity.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"2\",\n              \"3\",\n              \"4\"\n            ],\n            \"heading\": \"Necessity Argument\"\n          },\n          {\n            \"body\": \"Because the account uses epistemic notions, the paper addresses whether grounding becomes subjective. The answer is no: the relevant condition is about general epistemic facts concerning rational subjects who meet idealized information conditions. It is not about what any actual person happens to know, wonder, or be able to process.\",\n            \"grounding_claim_ids\": [\n              \"5\"\n            ],\n            \"heading\": \"Objectivity Concern\"\n          },\n          {\n            \"body\": \"The final section treats apparent counterexamples as diagnostic tests for explanatory completeness. Some cases omit enablers, totality facts, or marriage facts that are needed for full grounding. Another case involving a rose and its redness is treated more strongly: the alleged substance ground is not even a partial ground of the mode\\u2019s existence.\",\n            \"grounding_claim_ids\": [\n              \"7\"\n            ],\n            \"heading\": \"Counterexample Strategy\"\n          }\n        ],\n        \"summary_long\": \"The source develops a metaphysical argument for the thesis that full grounding is necessary: if [p] is fully grounded in D, then it is metaphysically necessary that the conjunction of the propositions corresponding to D entails p. Trogdon first separates this target from weaker or different modal ideas, such as the thought that the same grounding relation must hold whenever the grounds obtain, or that some grounded fact must result whenever the grounds obtain. The argument is needed because two tempting shortcuts fail. Grounding cannot simply inherit necessity from being a determination relation, since causation is plausibly a determination relation without the relevant modal force. Nor can full grounding be defined as grounding plus modal entailment, because necessary truths can have merely partial grounds that satisfy entailment trivially. The positive argument turns on two principles. The significance principle says full grounding requires the relevant connecting question to lack cognitive significance: once the relevant nature of the facts and entities is understood, the question why [p] obtains given D should no longer remain a substantive explanatory demand. The essence principle then says that this absence of cognitive significance is explained by Fine-style essential truths characteristic of [p], D, their plurality, or the entities involved, and those truths yield \\u2227D \\u2192 p. Since essential truths are metaphysically necessary, the grounded proposition follows necessarily from the full grounds. The paper treats this epistemic vocabulary as compatible with objective grounding because the constraint concerns general facts about what questions could have substantive content for rationally informed subjects, not the ignorance of a particular person. In closing, Trogdon considers counterexamples involving moral reasons and enablers, universal facts, widowhood, and substance-mode dependence. The response is that the first group omits additional explanatorily relevant facts needed for full grounding, while the substance-mode case misidentifies a non-ground as a ground. The resulting picture is that grounding has modal consequences because essence closes the relevant explanatory gap.\",\n        \"summary_short\": \"Kelly Trogdon\\u2019s article asks whether grounding is necessary in the sense that full grounds metaphysically entail what they ground. It answers yes, arguing from a constraint on cognitively significant connecting questions and a Fine-style account of essence. The paper also explains why familiar counterexamples are best treated as partial-ground or non-ground cases rather than failures of necessity.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-01-grounding-necessary-or-contingent--6e8195a096f0\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"01-grounding-necessary-or-contingent.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Kelly Trogdon\"\n        ],\n        \"display_title\": \"Grounding Is Necessary Through Essence\",\n        \"doi\": \"10.1111/papq.12009\",\n        \"journal\": \"Pacific Philosophical Quarterly\",\n        \"record_display_title\": \"Untitled Source\",\n        \"source_id\": \"source-01-grounding-necessary-or-contingent--6e8195a096f0\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Kelly Trogdon argues that full grounding is necessary: whenever [p] is fully grounded in D, the propositions corresponding to D metaphysically entail p. The argument relies on an epistemic significance constraint and a Fine-style essence principle, then answers apparent counterexamples by distinguishing full grounds from partial grounds and non-grounds.\",\n      \"title\": \"01-grounding-necessary-or-contingent\",\n      \"warnings\": [\n        {\n          \"code\": \"missing_publication_date\",\n          \"message\": \"Publication date could not be resolved from the source record; source_date_inference.date is null.\"\n        }\n      ]\n    },\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-02-grounding-is-not-a-strict-order--7c76f525b4e3/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Gonzalo Rodriguez-Pereyra\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Grounding Is Not a Strict Order\",\n      \"external_related_links\": [\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"dx.doi.org\",\n          \"link_type\": \"canonical_paper\",\n          \"provenance\": {\n            \"origin\": \"reference_url\",\n            \"source_field\": \"references[1].url\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Captured from normalized source references.\",\n          \"title\": \"http://dx.doi.org/ \\u00ad\\u2010\",\n          \"url\": \"http://dx.doi.org/10.7710/1526-\\u00ad\\u20100569.1453\"\n        },\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"doi.org\",\n          \"link_type\": \"canonical_paper\",\n          \"provenance\": {\n            \"origin\": \"reference_doi\",\n            \"source_field\": \"references[1].doi\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from a DOI found in the source references.\",\n          \"title\": \"http://dx.doi.org/ \\u00ad\\u2010\",\n          \"url\": \"https://doi.org/10.7710/1526-\"\n        },\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"arxiv.org\",\n          \"link_type\": \"research_index\",\n          \"provenance\": {\n            \"origin\": \"reference_arxiv\",\n            \"source_field\": \"references[1].arxiv\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from an arXiv identifier found in the source references.\",\n          \"title\": \"http://dx.doi.org/ \\u00ad\\u2010\",\n          \"url\": \"https://arxiv.org/abs/0569.1453\"\n        }\n      ],\n      \"ingested_at\": \"2026-04-26T15:10:38Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": null,\n          \"url\": \"http://www.personal.leeds.ac.uk/~phlejb/symmetric%20dependence.pdf\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": \"0569.1453\",\n          \"authors\": [],\n          \"doi\": \"10.7710/1526-\",\n          \"linked_source_ids\": [],\n          \"title\": \"http://dx.doi.org/ \\u00ad\\u2010\",\n          \"url\": \"http://dx.doi.org/10.7710/1526-\\u00ad\\u20100569.1453\",\n          \"year\": null\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": null,\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"enriched\",\n        \"warnings\": [\n          \"Skipped 1 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"unknown\",\n        \"date\": null,\n        \"origin\": \"unknown\",\n        \"rationale\": null\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The source's central thesis is that grounding is not a strict order. Since strict orders are transitive, irreflexive, and asymmetric, the paper aims to defeat each formal feature rather than merely challenge one controversial assumption about grounding.\",\n            \"grounding_claim_ids\": [\n              \"0\"\n            ],\n            \"heading\": \"Core Thesis\"\n          },\n          {\n            \"body\": \"The argument depends on classifying truthmaking and alethic-fact grounding as cases of grounding. Truthmaking connects what is true with that in virtue of which it is true; alethic-fact grounding connects a truthmaker with the fact that the truthmade proposition is true.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"2\"\n            ],\n            \"heading\": \"Species Strategy\"\n          },\n          {\n            \"body\": \"The paper distinguishes its own argument from Schaffer's. Schaffer's set example is rejected as inconclusive, while the Socrates/proposition chain is used to show that two plausible truthmaking links need not compose into a third truthmaking link.\",\n            \"grounding_claim_ids\": [\n              \"3\",\n              \"4\"\n            ],\n            \"heading\": \"Transitivity Argument\"\n          },\n          {\n            \"body\": \"Against irreflexivity, the paper relies on formal constructions involving existence and truth. If proposition A exists, then <A exists> can be made true by A itself; if B says that B is true, then the fact that B is true can ground itself.\",\n            \"grounding_claim_ids\": [\n              \"5\",\n              \"6\"\n            ],\n            \"heading\": \"Reflexivity Cases\"\n          },\n          {\n            \"body\": \"The asymmetry challenge is stronger than mere self-grounding. The source constructs distinct propositions C and D that truthmake one another's existence claims, and distinct propositions E and F whose truth facts ground one another.\",\n            \"grounding_claim_ids\": [\n              \"7\"\n            ],\n            \"heading\": \"Asymmetry Cases\"\n          },\n          {\n            \"body\": \"The paper anticipates the objection that grounding must be asymmetric because grounds are more fundamental than what they ground. It replies that grounding need not entail relative fundamentality, especially in bottomless or dense grounding chains without an ungrounded first element.\",\n            \"grounding_claim_ids\": [\n              \"8\"\n            ],\n            \"heading\": \"Fundamentality Objection\"\n          },\n          {\n            \"body\": \"A contrastive or differential version of grounding also fails to restore strict orderhood. The same self-truth and mutual-truth examples can be reformulated as differences that violate differential irreflexivity and differential asymmetry.\",\n            \"grounding_claim_ids\": [\n              \"9\"\n            ],\n            \"heading\": \"Contrastive Grounding\"\n          }\n        ],\n        \"summary_long\": \"This source is a sustained metaphysical argument against the influential assumption that grounding is a strict order. It begins from the standard definition of a strict order as transitive, irreflexive, and asymmetric, then argues that grounding lacks all three features. The strategy is indirect but systematic: truthmaking and alethic-fact grounding are presented as species or cases of grounding, so formal failures in those species have consequences for the genus. Rodriguez-Pereyra first criticizes Schaffer's proposed non-transitivity cases, especially the set S = {a, b, c}, because the argument appears to rely on an unstable counterfactual-necessity test. The paper then offers its own non-transitivity case for truthmaking: Socrates' being white makes the proposition that Socrates is white true, and that proposition can make true the existential proposition that there are propositions, but Socrates' being white is not what makes it true that there are propositions. For irreflexivity, the paper uses self-referential existence and truth propositions: if an existing proposition is itself the entity whose existence is asserted, truthmaker theory permits self-truthmaking; if a true proposition says of itself that it is true, alethic-fact grounding permits the fact of its truth to ground itself. For asymmetry, the paper uses paired propositions that mutually truthmake or mutually ground each other's truth facts. It also answers the worry that grounding must track relative fundamentality or explanatory asymmetry, arguing that bottomless or dense grounding chains show that grounding need not always mark greater fundamentality. Finally, it argues that Schaffer's contrastive, quaternary treatment of grounding does not rescue strict orderhood, because the same self-grounding and mutual-grounding patterns violate differential irreflexivity and differential asymmetry.\",\n        \"summary_short\": \"Gonzalo Rodriguez-Pereyra argues that grounding should not be classified as a strict order. The source challenges transitivity, irreflexivity, and asymmetry by treating truthmaking and alethic-fact grounding as species of grounding, then constructing cases in which those relations fail strict-order constraints.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"02-grounding-is-not-a-strict-order.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Gonzalo Rodriguez-Pereyra\"\n        ],\n        \"display_title\": \"Grounding Is Not a Strict Order\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Gonzalo Rodriguez-Pereyra argues that grounding is not a strict order. The paper builds the case through truthmaking and alethic-fact grounding, rejects Schaffer's set-based transitivity counterexample as inconclusive, then offers formal examples against transitivity, irreflexivity, and asymmetry.\",\n      \"title\": \"02-grounding-is-not-a-strict-order\",\n      \"warnings\": [\n        {\n          \"code\": \"missing_publication_date\",\n          \"message\": \"Publication date could not be resolved; continuing with date=null.\"\n        },\n        {\n          \"code\": \"title_recovered_from_pdf_text\",\n          \"message\": \"The source record title was generic, so the display title and author were recovered from the extracted first page.\"\n        }\n      ]\n    },\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-03-grounding-essence-and-identity--e857615fb05e/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Fabrice Correia\",\n        \"Alexander Skiles\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Grounding and Essence as Generalized Identity\",\n      \"external_related_links\": [],\n      \"ingested_at\": \"2026-04-26T15:17:52Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"/\",\n          \"url\": \"http://plato.stanford.edu/archives/spr2016/entries/grounding\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"/\",\n          \"url\": \"http://plato.stanford.edu/archives/sum2016/entries/essential-accidental\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"phy URL /\",\n          \"url\": \"http://plato.stanford.edu/entries/facts\",\n          \"year\": null\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": \"no_curated_links_found\",\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"skipped\",\n        \"warnings\": [\n          \"Skipped 3 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"unknown\",\n        \"date\": null,\n        \"origin\": \"unknown\",\n        \"rationale\": null\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The paper\\u2019s governing claim is that grounding and essence can be analyzed by one identity-like notion rather than by separate primitives. Generalized identity supplies the common form: it can state what it is for something to be a certain way, and it can also support analyses of explanatory dependence. This gives the framework its intended unity and explains why the source repeatedly moves between essence, grounding, and identity rather than treating them as isolated topics.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"1\"\n            ],\n            \"heading\": \"Central Unification\"\n          },\n          {\n            \"body\": \"Generalized identity is not ordinary objectual identity in disguise. The authors use an operator that connects open or closed sentences and read it non-factively, so the truth of a generalized identity does not require both sides to be instantiated or true. Its no-difference behavior, including symmetry and transitivity, is crucial because later definitions rely on substituting identity-equivalent contents while avoiding opaque contexts such as belief reports.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"7\"\n            ],\n            \"heading\": \"Generalized Identity\"\n          },\n          {\n            \"body\": \"The essence account distinguishes full from partial essence. Full generic essence is directly identified with generalized identity, while partial essence is explained through conjunctive structure: something is partly what G is when it appears as a conjunct in what it is to be G. This lets the authors preserve the intuition that essence is more than necessity while also explaining why essentialist claims can resemble real definitions.\",\n            \"grounding_claim_ids\": [\n              \"2\",\n              \"3\",\n              \"4\"\n            ],\n            \"heading\": \"Essence Analysis\"\n          },\n          {\n            \"body\": \"Grounding is initially characterized through disjunctive parthood: a plurality grounds q when its conjunction is a disjunctive part of q, subject to an exclusion condition preventing q from being contained in the grounds in the wrong way. The later subsumption formulation sharpens this by connecting grounds to wholly relevant ways for the grounded fact to obtain, making relevance part of the metaphysical structure rather than an afterthought.\",\n            \"grounding_claim_ids\": [\n              \"5\",\n              \"6\"\n            ],\n            \"heading\": \"Grounding Analysis\"\n          },\n          {\n            \"body\": \"One payoff is that ground-theoretic status is preserved under factual identity, because generalized identity is governed by identity-like structural principles. Another is that grounding implies an essence-based necessitation pattern: if being F grounds being G, then being G is being F or some H, which yields the modal result that F necessitates G. The necessity is derived from essence, not merely stipulated.\",\n            \"grounding_claim_ids\": [\n              \"7\",\n              \"8\"\n            ],\n            \"heading\": \"Preservation And Necessitation\"\n          },\n          {\n            \"body\": \"The paper resists reducing essence to necessity. The Socrates-plus-infinitely-many-primes example shows that necessary entailment and equivalence can hold even where essential structure is absent, because the augmented condition is tied to arithmetic in a way bare Socrates is not. Grounding structure therefore helps separate genuinely essential conditions from merely necessary companions.\",\n            \"grounding_claim_ids\": [\n              \"9\"\n            ],\n            \"heading\": \"Limits Of Modality\"\n          },\n          {\n            \"body\": \"The authors position their proposal against Fine\\u2019s unification of grounding and essence. Their main complaint is not that Fine cannot be supplemented, but that his primitive constitutive relations leave important explanatory links underdescribed. By contrast, generalized identity lets the authors derive several constraints, including asymmetries between grounding and essence, from a more uniform formal base.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"6\",\n              \"8\",\n              \"9\"\n            ],\n            \"heading\": \"Comparison With Fine\"\n          }\n        ],\n        \"summary_long\": \"This source develops a metaphysical framework in which grounding and essence are analyzed through generalized identity, a non-objectual identity-like operator expressed by the idiom 'For ... is for ...'. Correia and Skiles begin from the thought that grounding and essence are both Aristotelian notions often treated as closely related but not clearly unified. Their proposal is to use generalized identity as the common machinery: it can relate factual and generic contents without requiring ordinary entities such as facts or properties as relata, and it is governed by identity-like principles such as reflexivity, symmetry, transitivity, and restricted Leibniz-style substitutivity. On the essence side, full generic essence is identified with generalized identity: being F is what it is to be G in full exactly when for a thing to be G is for it to be F. Partial generic essence is then modeled by conjunctive parthood: F is partially what it is to be G when being G is being both F and some H. Objectual essence is routed through the generic essence of being identical to the object. On the grounding side, the authors first analyze factual grounding using disjunctive parthood and then present a subsumption-theoretic analogue that emphasizes relevance: the grounds must collectively constitute a way for q to obtain, while q must not be quasi-subsumed by the grounds in the wrong direction. These definitions allow them to explain why grounding status is preserved under factual identity and why grounding often carries an essence-based necessitation pattern. The account also distinguishes essence from mere modal necessity. Necessary equivalence does not guarantee essence when the relevant conditions differ in grounding structure, as in the Socrates-plus-primes example. The paper\\u2019s comparison with Fine is therefore not simply terminological; it argues that generalized identity offers a more transparent and uniform explanation of the constitutive relations Fine leaves comparatively primitive.\",\n        \"summary_short\": \"Fabrice Correia and Alexander Skiles propose that grounding and essence can be unified through generalized identity. Their account treats essence through full and partial generic identity, and grounding through disjunctive parthood and subsumption. The paper\\u2019s main payoff is an explanation of how grounding, essence, and identity constrain one another without reducing essence to mere necessity.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-03-grounding-essence-and-identity--e857615fb05e\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"03-grounding-essence-and-identity.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Fabrice Correia\",\n          \"Alexander Skiles\"\n        ],\n        \"display_title\": \"Grounding and Essence as Generalized Identity\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Correia and Skiles argue that generalized identity can provide a unified analysis of grounding and essence. Full and partial essence are modeled through generic identity and conjunctive parthood, while grounding is modeled through disjunctive parthood and subsumption. The resulting framework aims to explain why grounding implies certain essence-based necessitation patterns without collapsing essence into mere modal equivalence.\",\n      \"title\": \"03-grounding-essence-and-identity\",\n      \"warnings\": [\n        {\n          \"code\": \"missing_publication_date\",\n          \"message\": \"Publication date could not be resolved; continuing with date=null.\"\n        }\n      ]\n    },\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Christopher Timmermann\",\n        \"Hannes Kettner\",\n        \"Chris Letheby\",\n        \"Leor Roseman\",\n        \"Fernando E. Rosas\",\n        \"Robin L. Carhart-Harris\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Psychedelics Shift Beliefs Beyond Hard Materialism\",\n      \"external_related_links\": [\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"doi.org\",\n          \"link_type\": \"canonical_paper\",\n          \"provenance\": {\n            \"origin\": \"reference_url\",\n            \"source_field\": \"references[13].url\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Captured from normalized source references.\",\n          \"title\": \"Scientific Reports | 11:22166 | https://doi.org/ 1\",\n          \"url\": \"https://doi.org/10.1038/s41598-021-01209-2\"\n        }\n      ],\n      \"ingested_at\": \"2026-04-26T15:25:19Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"the copyright holder. To view a copy of this licence visit /\",\n          \"url\": \"http://\\u200bcreat\\u200biveco\\u200bmmons.\\u200borg/\\u200blicen\\u200bses/\\u200bby/4.\\u200b0\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"Supplementary Information The online version contains supplementary material available at\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"55. Haijen E. C. H. M. et al. Predicting responses to psychedelics: A prospective study. Front. Pharmacol. 9 897\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"ness mediate the mood-enhancing effects of psychedelic use in naturalistic settings. Proc. Natl. Acad. Sci\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b1073/\\u200b\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"sions with psilocybin. J. Psychopharmacol\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b1177/\\u200b02698\\u200b81115\\u200b609019\",\n          \"year\": 2015\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"interpretation and enduring effects. J. Psychopharmacol\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b1177/\\u200b02698\\u200b81120\\u200b916143\",\n          \"year\": 2020\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"15. Brouwer A. & Carhart-Harris R. L. Pivotal mental states. J. Psychopharmacol\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b1177/\\u200b02698\\u200b81120\\u200b959637\",\n          \"year\": 2020\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"e30800\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b1371/\\u200bjourn\\u200bal.\\u200bpone.\\u200b00308\\u200b00\",\n          \"year\": 2012\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"validation of psychedelic-induced insights and revelations. Transcult. Psychiatry\",\n          \"url\": \"https://\\u200bdoi.\\u200borg/\\u200b10.\\u200b31234/\\u200bosf.\\u200bio/\\u200bj5768\",\n          \"year\": 2020\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"38. Wikitionary. Ontological shock. . Accessed 6 February\",\n          \"url\": \"https://\\u200ben.\\u200bwikti\\u200bonary.\\u200borg/\\u200bwiki/\\u200bontol\\u200bogical_\\u200bshock\",\n          \"year\": 2021\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"1. van Inwagen P. & Sullivan M. Metaphysics. The Stanford Encyclopedia of Philosophy\",\n          \"url\": \"https://\\u200bplato.\\u200bstanf\\u200bord.\\u200bedu/\\u200barchi\\u200bves/\\u200b\",\n          \"year\": 2018\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"12. O\\u2019Connor T. & Franklin C. Free Will. The Stanford Encyclopedia of Philosophy\",\n          \"url\": \"https://\\u200bplato.\\u200bstanf\\u200bord.\\u200bedu/\\u200barchi\\u200bves/\\u200bspr20\\u200b21/\\u200bentri\\u200b\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"/\",\n          \"url\": \"https://\\u200bwww.\\u200bscien\\u200btific\\u200bameri\\u200bcan.\\u200bcom/\\u200bartic\\u200ble/\\u200btheres-\\u200bno-\\u200bgood-\\u200bevide\\u200bnce-\\u200bthat-\\u200bpsych\\u200bedeli\\u200bcs-\\u200bcan-\\u200bchange-\\u200byour-\\u200bpolit\\u200bics-\\u200bor-\\u200brelig\\u200bion\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": \"10.1038/s41598-021-01209-2\",\n          \"linked_source_ids\": [],\n          \"title\": \"Scientific Reports | 11:22166 | https://doi.org/ 1\",\n          \"url\": \"https://doi.org/10.1038/s41598-021-01209-2\",\n          \"year\": 2021\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": null,\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"enriched\",\n        \"warnings\": [\n          \"Skipped 13 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"unknown\",\n        \"date\": null,\n        \"origin\": \"unknown\",\n        \"rationale\": null\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The paper\\u2019s central argument is that psychedelic use can move people away from hard physicalist or materialist metaphysical positions. This is not framed as a purely philosophical thesis; it is operationalized through questionnaire items and tested before and after psychedelic exposure, then compared with a controlled psilocybin therapy dataset.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"7\",\n              \"9\"\n            ],\n            \"heading\": \"Central Argument\"\n          },\n          {\n            \"body\": \"The main measurement device is a Metaphysical Beliefs Questionnaire whose items are reduced to a Non-physicalist Beliefs factor. The factor\\u2019s positive side includes supernatural realms, non-natural unifying principles, panpsychism, dualism, and idealism, while its negative side includes hard materialist and naturalist commitments. This makes the results interpretable as movement along a materialist-to-non-physicalist axis rather than a single-item endorsement change.\",\n            \"grounding_claim_ids\": [\n              \"0\"\n            ],\n            \"heading\": \"Measurement Strategy\"\n          },\n          {\n            \"body\": \"The ceremony cohort supplies the main temporal evidence: respondents\\u2019 non-physicalist scores increase four weeks after psychedelic use and remain elevated at six months. The effect is stronger among psychedelic-naive participants, which supports the possibility that new exposure matters rather than only pre-existing psychedelic-culture affiliation.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"2\",\n              \"9\"\n            ],\n            \"heading\": \"Prospective Findings\"\n          },\n          {\n            \"body\": \"The belief changes are not uniform. Panpsychist, dualist, transcendentalist, and related non-physicalist tendencies show durability, while fatalistic determinism rises more transiently in the overall sample. This distinction matters because it suggests psychedelics may alter several metaphysical domains differently, depending on cultural reinforcement, prior exposure, and interpretive context.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"3\",\n              \"4\"\n            ],\n            \"heading\": \"Belief Domains\"\n          },\n          {\n            \"body\": \"The path model emphasizes social experience during the ceremony. Perceived emotional synchrony predicts later non-physicalist belief change, with peer conformity moderating the pathway and traits such as absorption, age, gender, baseline beliefs, and identity fusion feeding into synchrony. The source therefore treats psychedelic belief change as a drug-context interaction rather than an isolated pharmacological effect.\",\n            \"grounding_claim_ids\": [\n              \"6\",\n              \"9\"\n            ],\n            \"heading\": \"Mechanism and Context\"\n          },\n          {\n            \"body\": \"The paper connects metaphysical movement away from hard materialism with better mental-health outcomes. In the ceremony data, such shifts correlate with well-being improvements at four weeks and six months. In the controlled depression trial, psilocybin responders show larger belief shifts than escitalopram responders, raising the possibility that belief flexibility, spiritual interpretation, or related therapeutic processes accompany clinical improvement.\",\n            \"grounding_claim_ids\": [\n              \"5\",\n              \"8\"\n            ],\n            \"heading\": \"Mental-Health Link\"\n          },\n          {\n            \"body\": \"The authors stress that the samples are not demographically or culturally neutral and that religious affiliation, environmental susceptibility, and surrounding metaphysical views were not fully measured. These limits temper causal certainty but also sharpen the ethical issue: if psychedelics can catalyze changes in core beliefs, participants and service users may need to be informed of that possibility before exposure.\",\n            \"grounding_claim_ids\": [\n              \"9\"\n            ],\n            \"heading\": \"Limits and Ethics\"\n          }\n        ],\n        \"summary_long\": \"The source investigates a question often asserted in psychedelic culture but rarely tested quantitatively: whether psychedelic experiences alter deep metaphysical commitments. The authors use a large prospective online survey of people planning guided or ceremonial psychedelic experiences, measuring beliefs before the event and again afterward, and they supplement this with data from a randomized controlled depression trial comparing psilocybin therapy with escitalopram. The main construct is a Non-physicalist Beliefs factor built from questionnaire items about supernatural realms, non-natural unifying principles, panpsychism, dualism, idealism, materialism, and naturalism. Across the ceremony sample, scores shift significantly away from hard physicalism at four weeks and remain shifted at six months, with larger effects in psychedelic-naive participants. Fatalistic determinism also rises after ceremonies, but its durability is weaker in the overall sample. The paper further reports that baseline lifetime psychedelic exposure correlates with stronger panpsychist and weaker materialist views, that shifts away from hard materialism correlate with improved well-being, and that a path model identifies perceived emotional synchrony during the ceremony as a mediator of later non-physicalist belief change. The controlled trial adds an important check: psilocybin therapy, but not escitalopram, is associated with movement away from hard materialism at six weeks, and psilocybin responders show greater shifts than escitalopram responders. The authors therefore argue that psychedelic use may causally influence metaphysical beliefs, but they do not treat the causal case as settled. They flag limitations including atypical, largely Western and well-educated samples, missing religious-affiliation and environmental-susceptibility measures, and incomplete measurement of the cultural milieu around ceremonies and therapy. The practical upshot is both scientific and ethical: psychedelic experiences may affect core beliefs, and informed consent in psychedelic services may need to mention that possibility.\",\n        \"summary_short\": \"This Scientific Reports article examines whether psychedelics change metaphysical beliefs. It reports shifts away from hard materialism toward non-physicalist views, supported by a ceremony survey and a smaller psilocybin trial. The findings are linked to emotional synchrony and mental-health improvement but remain context-limited.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"04-psychedelics-alter-metaphysical-beliefs.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Christopher Timmermann\",\n          \"Hannes Kettner\",\n          \"Chris Letheby\",\n          \"Leor Roseman\",\n          \"Fernando E. Rosas\",\n          \"Robin L. Carhart-Harris\"\n        ],\n        \"display_title\": \"Psychedelics Shift Beliefs Beyond Hard Materialism\",\n        \"doi\": \"10.1038/s41598-021-01209-2\",\n        \"journal\": \"Scientific Reports\",\n        \"source_id\": \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Timmermann and colleagues report that psychedelic use is associated with shifts away from hard materialist metaphysical beliefs toward non-physicalist views, with convergent evidence from a prospective ceremony survey and a smaller controlled psilocybin therapy trial. The strongest results concern non-physicalist belief change, persistence to six months, mediation by emotional synchrony, and association with improved well-being or depression response, while publication date metadata could not be resolved from the local record.\",\n      \"title\": \"04-psychedelics-alter-metaphysical-beliefs\",\n      \"warnings\": [\n        {\n          \"code\": \"missing_publication_date\",\n          \"message\": \"Publication date could not be resolved from the provided source record; source_date_inference.date is null.\"\n        },\n        {\n          \"code\": \"contextual_causality_limit\",\n          \"message\": \"The observational ceremony data are prospective but remain vulnerable to ceremony culture, expectancy, sample-selection, and unmeasured religious or metaphysical-interest confounds.\"\n        }\n      ]\n    },\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Stanley B. Klein\",\n        \"Shaun Nichols\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Memory and the Sense of Personal Identity\",\n      \"external_related_links\": [\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"doi.org\",\n          \"link_type\": \"canonical_paper\",\n          \"provenance\": {\n            \"origin\": \"reference_doi\",\n            \"source_field\": \"references[2].doi\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from a DOI found in the source references.\",\n          \"title\": \"Advance Access publication 30 October\",\n          \"url\": \"https://doi.org/10.1093/mind/fzs080\"\n        }\n      ],\n      \"ingested_at\": \"2026-04-26T15:38:14Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"Downloaded from / at University of California Santa Barbara on January 8\",\n          \"url\": \"http://mind.oxfordjournals.org\",\n          \"year\": 2013\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"Edition ed. Edward N. Zalta\",\n          \"url\": \"http://plato.stanford.edu/arch\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": \"10.1093/mind/fzs080\",\n          \"linked_source_ids\": [],\n          \"title\": \"Advance Access publication 30 October\",\n          \"url\": null,\n          \"year\": 2012\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": null,\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"enriched\",\n        \"warnings\": [\n          \"Skipped 2 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"medium\",\n        \"date\": \"2012-07\",\n        \"origin\": \"source_markdown\",\n        \"rationale\": \"The extracted source text identifies the article as Mind, Vol. 121, No. 483, July 2012, while also noting Advance Access publication on 30 October 2012.\"\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The paper's central argument is that the felt sense of being identical with a past person is not built into episodic memory as an indivisible necessity. R.B. could recall autobiographical scenes with time, place, and self-involving content, but the scenes did not feel owned. This supports a model in which content retrieval and mineness are separable contributors to personal identity experience.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"1\",\n              \"4\"\n            ],\n            \"heading\": \"Central Argument\"\n          },\n          {\n            \"body\": \"R.B. is treated as an unusually probative neurological case because his reports are not merely about lost memory. He describes vivid scenes, voluntary recall, and intellectual acceptance that the events fit his life history, while denying that they feel like his own memories. The beach and MIT examples make the deficit specific: ownership is absent even where scene-like recollection remains.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"3\",\n              \"5\"\n            ],\n            \"heading\": \"Case Evidence\"\n          },\n          {\n            \"body\": \"The authors situate the case within a multiple-systems view of long-term memory. Semantic memory can contain factual and trait self-knowledge, while episodic memory normally supports re-experiencing events. D.B. and related findings show that trait self-knowledge can persist without a robust memory-based sense of past existence, helping isolate different self-related memory systems.\",\n            \"grounding_claim_ids\": [\n              \"2\",\n              \"3\"\n            ],\n            \"heading\": \"Memory Architecture\"\n          },\n          {\n            \"body\": \"The proposed explanation is not that R.B. lacked all self-representation. He knew the memories were about R.B. and could connect them with facts about his biography. What was missing was a first-person ownership representation, described as an I-concept or self-tag inserted into the agent slot of episodic attribution. This makes mineness a contingent cognitive product.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"4\",\n              \"7\"\n            ],\n            \"heading\": \"Model Of Mineness\"\n          },\n          {\n            \"body\": \"The case matters for quasi-memory because Schechtman's dilemma says apparent memory must be either delusional or identity-presupposing. R.B.'s recollections appear to avoid both horns: they are accurate autobiographical recollections, yet he does not experience them as straightforwardly his. That gives psychological-continuity theorists a more concrete resource than bare conceivability arguments.\",\n            \"grounding_claim_ids\": [\n              \"5\",\n              \"6\"\n            ],\n            \"heading\": \"Quasi-Memory Implications\"\n          },\n          {\n            \"body\": \"The argument is cautious about what follows for metaphysics. R.B. does not settle whether personal identity is psychological, biological, or something else, and the neural details of the ownership mechanism remain incomplete. The practical lesson is narrower but important: before treating memory as evidence for identity, philosophers should ask how the ownership-producing system works and how reliable it is.\",\n            \"grounding_claim_ids\": [\n              \"6\",\n              \"7\"\n            ],\n            \"heading\": \"Limits And Interpretation\"\n          }\n        ],\n        \"summary_long\": \"This article connects empirical memory science with classic debates about personal identity. Klein and Nichols begin from the familiar thought that memory seems to tell a person that they are identical with someone in the past. Philosophers such as Locke, Reid, Butler, Hume, Parfit, and Schechtman treat memory as central either to constituting identity, evidencing identity, or explaining the illusion of identity. The authors argue that these debates need a more fine-grained account of the sense of identity delivered by memory. Contemporary psychology distinguishes procedural, semantic, and episodic memory, and also distinguishes factual self-knowledge and trait self-knowledge from recollective re-experience. That framework makes it possible to ask whether autobiographical content, self-reference, and ownership are one package or separable components. The case of R.B. is used to answer that question. After a serious bicycle accident and head trauma, R.B. could intentionally retrieve temporally and spatially situated scenes from before the injury, and he often intellectually accepted that the events were part of his life. Yet he reported that the memories lacked ownership: they were like scenes from someone else's vacation or experiences described by another person. He also retained trait self-knowledge, present ownership, some future planning, and eventual recovery of ownership memory by memory. On this basis, Klein and Nichols propose that the sense of numerical personal identity is not guaranteed by episodic memory itself. Instead, a memory system may supply scene content while another mechanism supplies the first-person I-tag or mineness. Philosophically, this weakens claims that memory necessarily presupposes identity and gives quasi-memory theorists a real case that lies between delusion and identity-presupposing memory. At the same time, the case raises a further burden: theories of psychological continuity must say which self-representational elements matter for constituting personal identity.\",\n        \"summary_short\": \"Klein and Nichols argue that autobiographical memory does not always carry a felt sense of ownership. Their central evidence is patient R.B., who could recall vivid pre-injury scenes but experienced them as not really his. The case supports a two-component model in which memory content and mineness can separate, with consequences for quasi-memory and philosophical claims about identity over time.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"05-memory-and-the-sense-of-personal-identity.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Stanley B. Klein\",\n          \"Shaun Nichols\"\n        ],\n        \"display_title\": \"Memory and the Sense of Personal Identity\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Klein and Nichols use the neurological case of patient R.B. to argue that episodic memory content can be dissociated from the sense of personal ownership or mineness. The paper proposes a component model of memory-based personal identity and applies it to debates over quasi-memory and the evidential value of memory for persistence of self.\",\n      \"title\": \"05-memory-and-the-sense-of-personal-identity\",\n      \"warnings\": [\n        {\n          \"code\": \"source_record_title_low_quality\",\n          \"message\": \"The source record supplied 'Untitled Source', so the display title was recovered from the source markdown title and article header.\"\n        },\n        {\n          \"code\": \"publication_date_inferred_from_markdown\",\n          \"message\": \"Task context reported an unresolved date; the markdown masthead supports July 2012 while the DOI line reports Advance Access publication on 30 October 2012.\"\n        }\n      ]\n    }\n  ],\n  \"topics\": [\n    {\n      \"claim_ids\": [\n        \"claim-if-a-fact-p-is-fully-grounded-in-a-plurality-of-facts-d-then-the-conjunction-of--dbb969101dbd\",\n        \"claim-the-conjunction-of-the-significance-principle-the-essence-principle-and-the-meta--4f212a9f1869\",\n        \"claim-grounding-necessity-is-not-secured-merely-by-treating-grounding-as-a-determinati--23325d0a6e99\",\n        \"claim-apparent-counterexamples-to-grounding-necessity-fail-when-alleged-full-grounds-a--8cbbd720ef13\",\n        \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n        \"claim-schaffer-s-set-based-counterexample-does-not-establish-grounding-non-transitivit--49174a1f51f7\",\n        \"claim-grounding-does-not-entail-being-more-fundamental-than-so-appeals-to-relative-fun--0468a01c8a45\",\n        \"claim-schaffer-s-contrastive-or-differential-formulation-of-grounding-still-fails-to-m--7fd859e88bdc\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"Both sources treat grounding as constrained by modal or explanatory structure, but they press that structure in different directions: one defends metaphysical necessitation for full grounding, while the other argues that grounding should not be modeled as a strict order.\",\n          \"heading\": \"Shared Concept\"\n        },\n        {\n          \"body\": \"The necessity-focused source argues that if a fact is fully grounded in a plurality of facts, the corresponding conjunction metaphysically necessitates the grounded fact, deriving this from significance, essence, and the necessity of essential truths.\",\n          \"heading\": \"Necessity and Full Grounding\"\n        },\n        {\n          \"body\": \"The strict-order source argues that grounding is not transitive, irreflexive, or asymmetric, and it treats appeals to counterfactual necessity and relative fundamentality as insufficient to secure strict-order behavior.\",\n          \"heading\": \"Strict-Order Pressure\"\n        },\n        {\n          \"body\": \"A synthesis page could ask whether grounding necessity is a thesis about full grounding that remains compatible with failures of strict-order principles, especially when alleged counterexamples involve partial grounds, non-grounds, truthmaking, or alethic-fact grounding.\",\n          \"heading\": \"Synthesis Question\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-01-grounding-necessary-or-contingent--6e8195a096f0\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Grounding Necessity and Structural Order\",\n      \"topic_id\": \"grounding-necessity-and-structural-order\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-the-evidential-force-of-memory-for-personal-identity-depends-on-the-contingent-c--ef23d993b2fe\",\n        \"claim-the-memory-based-sense-of-personal-identity-depends-on-at-least-two-separable-co--f9eaee4ce165\",\n        \"claim-psychedelic-use-is-associated-with-significant-shifts-away-from-hard-physicalist--b7e61a4e9b3c\",\n        \"claim-perceived-emotional-synchrony-during-the-psychedelic-ceremony-mediates-later-cha--adcb9ca374b4\",\n        \"claim-the-combined-prospective-correlational-mechanistic-and-controlled-trial-evidence--bb114d52608c\",\n        \"claim-in-a-randomized-controlled-depression-trial-psilocybin-therapy-produced-shifts-a--7cfb0c0f75e7\",\n        \"claim-shifts-away-from-hard-materialism-are-positively-associated-with-increases-in-ps--4bb5f88069f2\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The memory and psychedelic-belief sources jointly support a topic on how metaphysical commitments may be shaped by contingent psychological systems rather than by argument alone. In the memory case, ownership feelings affect the evidential force of memory for personal identity; in the psychedelic studies, ceremonies and psilocybin therapy are associated with shifts away from hard materialism.\",\n          \"heading\": \"Psychological Conditions on Metaphysical Commitment\"\n        },\n        {\n          \"body\": \"The shared concept is mediation. R.B.'s dissociation suggests that the sense of diachronic identity depends on mechanisms supplying mineness, while the psychedelic source reports emotional synchrony and baseline peer conformity as predictors or mediators of later non-physicalist belief change.\",\n          \"heading\": \"Mediating Mechanisms\"\n        },\n        {\n          \"body\": \"The topic should not claim that these mechanisms refute the metaphysical views involved. The stronger supported point is epistemic: local evidence suggests that some intuitions or commitments about selfhood, physicalism, and identity are sensitive to cognitive and social conditions.\",\n          \"heading\": \"Epistemic Rather Than Refutational Force\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n        \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Cognitive Mediators of Metaphysical Commitment\",\n      \"topic_id\": \"topic-cognitive-mediators-of-metaphysical-commitment\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-episodic-recollection-can-preserve-temporally-and-spatially-situated-autobiograp--43867278649d\",\n        \"claim-the-memory-based-sense-of-personal-identity-depends-on-at-least-two-separable-co--f9eaee4ce165\",\n        \"claim-the-sense-of-numerical-personal-identity-is-a-contingent-feature-of-episodic-mem--b672a3618f23\",\n        \"claim-r-b-retained-factual-self-knowledge-trait-self-knowledge-voluntary-scene-recall--fc36edde2153\",\n        \"claim-if-a-fact-p-is-fully-grounded-in-a-plurality-of-facts-d-then-the-conjunction-of--dbb969101dbd\",\n        \"claim-the-conjunction-of-the-significance-principle-the-essence-principle-and-the-meta--4f212a9f1869\",\n        \"claim-necessary-entailment-or-equivalence-is-not-sufficient-for-essence-because-genera--162946956228\",\n        \"claim-grounding-and-essence-can-both-be-analyzed-in-terms-of-generalized-identity-yiel--e2abdab353f9\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"R.B.'s case supports a page on how apparently necessary links between episodic recollection and numerical personal identity can turn out to be contingent. The memory evidence says autobiographical event content, factual self-knowledge, trait self-knowledge, voluntary recall, and some future planning can persist while the felt mineness normally taken to certify identity is absent.\",\n          \"heading\": \"Dissociation of Episodic Content and Identity\"\n        },\n        {\n          \"body\": \"The grounding and essence sources provide a contrast class for this contingency claim. Trogdon's account treats full grounding as metaphysically necessitating what is grounded through essence, while Correia and Skiles argue that generalized identity can distinguish genuine essence from merely necessary entailment or coextension.\",\n          \"heading\": \"Essence, Necessity, and Explanation\"\n        },\n        {\n          \"body\": \"The synthesis should be careful: the memory source does not present a formal grounding theory, and the grounding sources do not analyze episodic memory. The shared topic is that identity-involving appearances may need decomposition before they can support claims of essence-like necessity.\",\n          \"heading\": \"Synthesis Constraint\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n        \"source-01-grounding-necessary-or-contingent--6e8195a096f0\",\n        \"source-03-grounding-essence-and-identity--e857615fb05e\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Contingent Selfhood and Essential Explanation\",\n      \"topic_id\": \"topic-contingent-selfhood-and-essential-explanation\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-shifts-away-from-hard-materialism-are-positively-associated-with-increases-in-ps--4bb5f88069f2\",\n        \"claim-perceived-emotional-synchrony-during-the-psychedelic-ceremony-mediates-later-cha--adcb9ca374b4\",\n        \"claim-ceremonial-psychedelic-use-increased-fatalistic-determinism-at-four-weeks-in-the--f71a027b70cc\",\n        \"claim-the-combined-prospective-correlational-mechanistic-and-controlled-trial-evidence--bb114d52608c\",\n        \"claim-generalized-identity-is-a-non-factive-no-difference-operator-that-can-apply-to-f--7cb985988184\",\n        \"claim-grounding-and-essence-can-both-be-analyzed-in-terms-of-generalized-identity-yiel--e2abdab353f9\",\n        \"claim-necessary-entailment-or-equivalence-is-not-sufficient-for-essence-because-genera--162946956228\",\n        \"claim-full-generic-essence-is-captured-by-generalized-identity-being-f-is-what-it-is-t--96f5798ed301\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The psychedelic-belief source links shifts away from hard materialism with increases in psychological well-being after ceremonies and reports that emotional synchrony during a ceremony mediates later changes in non-physicalist beliefs, with peer conformity moderating that pathway. It also reports a temporary overall increase in fatalistic determinism and notes that possible causal interpretation remains limited by sample selection and contextual confounds.\",\n          \"heading\": \"Experience and Well-Being\"\n        },\n        {\n          \"body\": \"The generalized-identity source analyzes grounding and essence through a non-factive no-difference operator that can apply to factual and generic contents. On that account, full generic essence is captured by generalized identity, while necessary entailment or equivalence alone is not sufficient for essence because identity and grounding can distinguish essential structure from merely necessary coextension.\",\n          \"heading\": \"Generalized Identity Framework\"\n        },\n        {\n          \"body\": \"This topic can synthesize empirical change in metaphysical self-orientation with a philosophical framework for essence, identity, and grounding. The connection is conceptual rather than evidential: the psychedelic source does not use generalized identity, but its findings concern changed commitments about mind, matter, and reality that can be framed against a theory separating essential structure from mere modal equivalence.\",\n          \"heading\": \"Synthesis Boundary\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\",\n        \"source-03-grounding-essence-and-identity--e857615fb05e\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Experience, Well-Being, and Generalized Identity\",\n      \"topic_id\": \"topic-experience-wellbeing-and-generalized-identity\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-factual-grounding-is-analyzed-through-disjunctive-parthood-a-plurality-of-facts--d0a2dc4b2f48\",\n        \"claim-a-subsumption-theoretic-version-of-grounding-says-that-p1-p2-and-so-on-ground-q--fe650fc0cecd\",\n        \"claim-ground-theoretic-status-is-preserved-under-factual-identity-because-the-proposed--4aecebbdb4a2\",\n        \"claim-generalized-identity-is-a-non-factive-no-difference-operator-that-can-apply-to-f--7cb985988184\",\n        \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n        \"claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d\",\n        \"claim-alethic-fact-grounding-is-non-irreflexive-because-if-proposition-b-is-true-and-s--0f3a01a46967\",\n        \"claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5\",\n        \"claim-grounding-does-not-entail-being-more-fundamental-than-so-appeals-to-relative-fun--0468a01c8a45\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The generalized-identity source offers formal analyses of grounding through disjunctive parthood, quasi-subsumption, and preservation under factual identity. The strict-order source instead challenges familiar structural assumptions by arguing that grounding is not transitive, irreflexive, or asymmetric.\",\n          \"heading\": \"Core synthesis\"\n        },\n        {\n          \"body\": \"Together the sources make the formal profile of grounding a live issue: grounding may need a precise structural account, but that account cannot simply assume the strict-order behavior often associated with fundamentality.\",\n          \"heading\": \"Key tension\"\n        },\n        {\n          \"body\": \"A page could map candidate formal constraints on grounding and explain how identity-preservation, parthood, subsumption, non-transitivity, reflexivity, and symmetry claims pull in different directions.\",\n          \"heading\": \"Page angle\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-03-grounding-essence-and-identity--e857615fb05e\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Formal Structure of Grounding Relations\",\n      \"topic_id\": \"topic-formal-structure-of-grounding\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-grounding-and-essence-can-both-be-analyzed-in-terms-of-generalized-identity-yiel--e2abdab353f9\",\n        \"claim-if-being-f-grounds-being-g-then-the-fact-that-being-f-necessitates-being-g-can-b--685ae4dcbfb4\",\n        \"claim-necessary-entailment-or-equivalence-is-not-sufficient-for-essence-because-genera--162946956228\",\n        \"claim-full-generic-essence-is-captured-by-generalized-identity-being-f-is-what-it-is-t--96f5798ed301\",\n        \"claim-partial-generic-essence-is-captured-by-conjunctive-partial-generalized-identity--13ec1cd27c1f\",\n        \"claim-if-a-fact-p-is-fully-grounded-in-a-plurality-of-facts-d-then-the-conjunction-of--dbb969101dbd\",\n        \"claim-connecting-questions-lack-cognitive-significance-only-when-fine-style-essential--f96bc70d5d2d\",\n        \"claim-the-conjunction-of-the-significance-principle-the-essence-principle-and-the-meta--4f212a9f1869\",\n        \"claim-grounding-necessity-is-not-secured-merely-by-treating-grounding-as-a-determinati--23325d0a6e99\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"One source argues that full grounding metaphysically necessitates what is grounded by appeal to cognitive significance and Fine-style essence, while the generalized-identity source explains grounding-to-necessitation patterns through what it is to be the grounded property or fact. The shared topic is not merely that grounding entails necessity, but that essence-like structure is used to explain why the entailment is metaphysically secure.\",\n          \"heading\": \"Core synthesis\"\n        },\n        {\n          \"body\": \"The sources also warn against reducing essence to modal entailment or equivalence: grounding necessity may follow from essential truths, but necessary coextension alone does not determine essential structure.\",\n          \"heading\": \"Key tension\"\n        },\n        {\n          \"body\": \"A concept page could compare essence-first routes to grounding necessity with generalized-identity routes that derive necessitation while preserving distinctions among full essence, partial essence, and mere necessary equivalence.\",\n          \"heading\": \"Page angle\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-03-grounding-essence-and-identity--e857615fb05e\",\n        \"source-01-grounding-necessary-or-contingent--6e8195a096f0\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Grounding, Essence, and Necessitation\",\n      \"topic_id\": \"topic-grounding-essence-and-necessitation\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-r-b-s-unowned-recollections-provide-an-existence-proof-for-apparent-memory-conte--6a14bce7e1a3\",\n        \"claim-quasi-memory-accounts-must-specify-which-form-of-self-representation-is-required--4b048f888bc8\",\n        \"claim-episodic-recollection-can-preserve-temporally-and-spatially-situated-autobiograp--43867278649d\",\n        \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n        \"claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf\",\n        \"claim-alethic-fact-grounding-is-non-irreflexive-because-if-proposition-b-is-true-and-s--0f3a01a46967\",\n        \"claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5\",\n        \"claim-grounding-does-not-entail-being-more-fundamental-than-so-appeals-to-relative-fun--0468a01c8a45\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"R.B.'s unowned recollections create a natural bridge to debates about whether metaphysical relations must have strict-order structure. The memory source pressures simple views that episodic memory automatically grounds or guarantees personal identity, because apparent memory content can remain without felt ownership.\",\n          \"heading\": \"Relations Without Simple Priority\"\n        },\n        {\n          \"body\": \"The grounding-order source similarly challenges structural assumptions about grounding by arguing that grounding is not transitive, irreflexive, or asymmetric. Its truthmaking and alethic-fact grounding examples are used to show that intuitive direction or priority does not by itself settle the formal profile of grounding.\",\n          \"heading\": \"Grounding Beyond Strict Order\"\n        },\n        {\n          \"body\": \"The cross-source synthesis is limited but useful: both sources warn against building metaphysical theory around an over-simple relational template. A page can compare identity-through-memory and ground-grounded relations as cases where intuitive direction, priority, or evidential force needs finer analysis.\",\n          \"heading\": \"Comparative Use\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Memory, Identity, and Relational Grounding\",\n      \"topic_id\": \"topic-memory-identity-and-relational-grounding\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-psychedelic-use-is-associated-with-significant-shifts-away-from-hard-physicalist--b7e61a4e9b3c\",\n        \"claim-most-psychedelic-associated-shifts-in-non-physicalist-metaphysical-beliefs-persi--9591d5bd7c0c\",\n        \"claim-participants-with-no-prior-psychedelic-experience-showed-larger-shifts-away-from--056a417d978d\",\n        \"claim-the-combined-prospective-correlational-mechanistic-and-controlled-trial-evidence--bb114d52608c\",\n        \"claim-a-fact-p-is-fully-grounded-in-d-only-if-the-connecting-question-asking-why-p-obt--ea3a1a698124\",\n        \"claim-connecting-questions-lack-cognitive-significance-only-when-fine-style-essential--f96bc70d5d2d\",\n        \"claim-the-conjunction-of-the-significance-principle-the-essence-principle-and-the-meta--4f212a9f1869\",\n        \"claim-the-epistemic-constraint-on-grounding-does-not-undermine-grounding-objectivity-b--87922d9890f9\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"Psychedelic use is reported as associated with significant movement away from hard physicalist or materialist metaphysical beliefs and toward non-physicalist positions such as panpsychism, dualism, and non-naturalism. The same source reports that most of these non-physicalist belief shifts persisted for at least six months and that psychedelic-naive participants showed larger shifts than the full observational sample.\",\n          \"heading\": \"Empirical Belief Movement\"\n        },\n        {\n          \"body\": \"The grounding-necessity source supplies a conceptual contrast: a fact is fully grounded in a plurality only if the connecting question asking why the grounded fact obtains given those grounds lacks cognitive significance. It further links that lack of cognitive significance to Fine-style essential truths and uses the significance and essence principles to argue that full grounding metaphysically necessitates what is grounded.\",\n          \"heading\": \"Grounding Necessity Framework\"\n        },\n        {\n          \"body\": \"This topic can compare empirical shifts in metaphysical commitments with a philosophical account of when explanatory dependence is objective and necessary. The support is cross-source but asymmetric: the psychedelic source gives evidence of belief change, while the grounding source supplies criteria for explanatory dependence rather than direct claims about psychedelic experience.\",\n          \"heading\": \"Synthesis Boundary\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\",\n        \"source-01-grounding-necessary-or-contingent--6e8195a096f0\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Metaphysical Belief Change and Grounding Necessity\",\n      \"topic_id\": \"topic-metaphysical-belief-change-and-grounding-necessity\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-psychedelic-use-is-associated-with-significant-shifts-away-from-hard-physicalist--b7e61a4e9b3c\",\n        \"claim-greater-lifetime-psychedelic-use-correlates-with-stronger-baseline-panpsychist-b--a024d2968b54\",\n        \"claim-in-a-randomized-controlled-depression-trial-psilocybin-therapy-produced-shifts-a--7cfb0c0f75e7\",\n        \"claim-patients-who-clinically-responded-to-psilocybin-therapy-showed-greater-shifts-aw--b78b1f525f61\",\n        \"claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf\",\n        \"claim-alethic-fact-grounding-is-a-species-of-grounding-in-which-a-truthmaker-grounds-t--9c9dc5afedc6\",\n        \"claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b\",\n        \"claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The psychedelic-belief source reports shifts away from hard materialism toward non-physicalist views and identifies baseline correlations between lifetime psychedelic use, stronger panpsychist beliefs, and weaker hard materialist beliefs. It also reports that psilocybin therapy, unlike escitalopram, produced shifts away from hard materialism in a controlled depression trial, with clinically responding psilocybin patients showing larger shifts than clinically responding escitalopram patients.\",\n          \"heading\": \"Non-Physicalist Commitments\"\n        },\n        {\n          \"body\": \"The truthmaking source treats truthmaking and alethic-fact grounding as species of grounding, then argues that grounding is not a strict order because it is not reliably transitive, irreflexive, or asymmetric. Its examples include mutual truthmaking or mutual alethic-fact grounding between distinct propositions or truth facts.\",\n          \"heading\": \"Truthmaking and Order Structure\"\n        },\n        {\n          \"body\": \"A synthesis-worthy page can examine how movement toward panpsychist, dualist, or other non-physicalist beliefs might interact with assumptions about what makes propositions true and how truth facts are grounded. The sources do not establish that psychedelic-associated belief change supports any truthmaking theory; they justify a conceptual comparison between altered metaphysical commitments and non-strict grounding structure.\",\n          \"heading\": \"Synthesis Boundary\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Non-Physicalist Belief and Truthmaking Structure\",\n      \"topic_id\": \"topic-nonphysicalist-belief-and-truthmaking-structure\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-trait-self-knowledge-can-remain-accurate-and-resilient-even-when-episodic-memory--e1d296edc23e\",\n        \"claim-r-b-retained-factual-self-knowledge-trait-self-knowledge-voluntary-scene-recall--fc36edde2153\",\n        \"claim-objectual-essence-can-be-accounted-for-through-generic-essence-so-a-feature-is-w--bd5daa95f779\",\n        \"claim-full-generic-essence-is-captured-by-generalized-identity-being-f-is-what-it-is-t--96f5798ed301\",\n        \"claim-partial-generic-essence-is-captured-by-conjunctive-partial-generalized-identity--13ec1cd27c1f\",\n        \"claim-generalized-identity-is-a-non-factive-no-difference-operator-that-can-apply-to-f--7cb985988184\",\n        \"claim-ground-theoretic-status-is-preserved-under-factual-identity-because-the-proposed--4aecebbdb4a2\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The memory source supplies a focused topic on the distinction between episodic ownership and other forms of self-knowledge. Trait self-knowledge, factual self-knowledge, voluntary scene recall, and some future planning can remain in place even when past scenes no longer feel personally owned.\",\n          \"heading\": \"Self-Knowledge Without Ownership\"\n        },\n        {\n          \"body\": \"This can be synthesized with the generalized-identity source because both distinguish different roles that may be conflated under one broad identity vocabulary. The metaphysical source separates generic essence, objectual essence, factual identity, and ground-theoretic status; the memory source separates event content, mineness, trait knowledge, and diachronic identity feeling.\",\n          \"heading\": \"Decomposing Identity Vocabulary\"\n        },\n        {\n          \"body\": \"The conceptual overlap is structural rather than doctrinal. The page should not claim that generalized identity analyzes personal memory directly, but it can use the formal source as a contrast case for why identity claims often need decomposition into finer relations.\",\n          \"heading\": \"Structural Overlap Only\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4\",\n        \"source-03-grounding-essence-and-identity--e857615fb05e\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Self-Knowledge Without Episodic Ownership\",\n      \"topic_id\": \"topic-self-knowledge-without-episodic-ownership\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-generalized-identity-is-a-non-factive-no-difference-operator-that-can-apply-to-f--7cb985988184\",\n        \"claim-objectual-essence-can-be-accounted-for-through-generic-essence-so-a-feature-is-w--bd5daa95f779\",\n        \"claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf\",\n        \"claim-alethic-fact-grounding-is-a-species-of-grounding-in-which-a-truthmaker-grounds-t--9c9dc5afedc6\",\n        \"claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4\",\n        \"claim-schaffer-s-contrastive-or-differential-formulation-of-grounding-still-fails-to-m--7fd859e88bdc\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"The truthmaking source treats truthmaking and alethic-fact grounding as species of grounding, including cases where truthmakers ground truth facts. The generalized-identity source supplies a non-factive no-difference operator that can apply to factual and generic contents without taking fact-shaped or property-shaped entities as relata.\",\n          \"heading\": \"Core synthesis\"\n        },\n        {\n          \"body\": \"This makes a synthesis-worthy topic because both sources connect grounding with facts and truth, but they place different pressure on the ontology of relata: one develops grounding through truthmakers and truth facts, while the other tries to formulate grounding and essence without requiring such entities as the basic relata.\",\n          \"heading\": \"Key tension\"\n        },\n        {\n          \"body\": \"A page could compare entity-based truthmaker grounding with content-based generalized identity, noting that the available evidence supports a conceptual contrast rather than a direct refutation between the approaches.\",\n          \"heading\": \"Page angle\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-03-grounding-essence-and-identity--e857615fb05e\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Truthmaking, Facts, and Non-Factive Identity\",\n      \"topic_id\": \"topic-truthmaking-facts-and-nonfactive-identity\"\n    },\n    {\n      \"claim_ids\": [\n        \"claim-a-fact-p-is-fully-grounded-in-d-only-if-the-connecting-question-asking-why-p-obt--ea3a1a698124\",\n        \"claim-connecting-questions-lack-cognitive-significance-only-when-fine-style-essential--f96bc70d5d2d\",\n        \"claim-paradigm-grounding-cases-support-the-significance-principle-because-their-connec--28555377f52b\",\n        \"claim-the-epistemic-constraint-on-grounding-does-not-undermine-grounding-objectivity-b--87922d9890f9\",\n        \"claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf\",\n        \"claim-alethic-fact-grounding-is-a-species-of-grounding-in-which-a-truthmaker-grounds-t--9c9dc5afedc6\",\n        \"claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d\",\n        \"claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4\",\n        \"claim-alethic-fact-grounding-is-non-irreflexive-because-if-proposition-b-is-true-and-s--0f3a01a46967\",\n        \"claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5\"\n      ],\n      \"sections\": [\n        {\n          \"body\": \"Both sources rely on distinctions about what genuinely explains or grounds what: one separates full grounds from partial grounds and non-grounds, while the other treats truthmaking and alethic-fact grounding as species of grounding that generate structural counterexamples.\",\n          \"heading\": \"Shared Concept\"\n        },\n        {\n          \"body\": \"The necessity-focused source ties full grounding to connecting questions that lack cognitive significance, with Fine-style essential truths explaining why the grounds imply the grounded fact.\",\n          \"heading\": \"Explanatory Adequacy\"\n        },\n        {\n          \"body\": \"The strict-order source argues that truthmaking and alethic-fact grounding are grounding relations, then uses self-truthmaking, self-grounding truth facts, mutual truthmaking, and non-transitive truthmaking chains to challenge strict-order constraints.\",\n          \"heading\": \"Truthmaking as Grounding\"\n        },\n        {\n          \"body\": \"A synthesis page could compare whether truthmaking cases satisfy the explanatory standard for full grounding, or whether they reveal a looser grounding species whose structural behavior differs from the cases used to defend grounding necessity.\",\n          \"heading\": \"Synthesis Question\"\n        }\n      ],\n      \"source_ids\": [\n        \"source-01-grounding-necessary-or-contingent--6e8195a096f0\",\n        \"source-02-grounding-is-not-a-strict-order--7c76f525b4e3\"\n      ],\n      \"structure_type\": \"wiki\",\n      \"title\": \"Truthmaking, Full Grounding, and Explanatory Connection\",\n      \"topic_id\": \"truthmaking-full-grounding-and-explanatory-connection\"\n    }\n  ],\n  \"warnings\": []\n}\n--- records files ---\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/records/source-01-grounding-necessary-or-contingent--6e8195a096f0.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/records/source-02-grounding-is-not-a-strict-order--7c76f525b4e3.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/records/source-03-grounding-essence-and-identity--e857615fb05e.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/records/source-04-psychedelics-alter-metaphysical-beliefs--0d1ce18240f0.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/records/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4.json\n--- claims files ---\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-a-fact-p-is-f