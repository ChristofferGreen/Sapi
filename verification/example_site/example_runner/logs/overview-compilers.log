_claim_id\": \"claim-the-paper-s-worst-case-system-model-uses-one-data-qubit-per-processor-and-a-one--9e5973bc3485\",\n      \"src_claim_ref\": \"5\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-trace-selection-followed-by-tail-duplication-converts-frequently-executed-traces--1483ee9d0534\",\n      \"dst_claim_ref\": \"3\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Controlled code expansion is evidence that tail duplication can be practical when trace inclusion is thresholded.\",\n      \"relation_file_id\": \"rel-bd44c7e51a831c750641082d7551db30be6f4ee1a239e138e19313174f002f91\",\n      \"relation_id\": \"supports:claim-the-profile-based-transformations-controlled-executable-size-growth-averaging-1--5bacab4b8a28->claim-trace-selection-followed-by-tail-duplication-converts-frequently-executed-traces--1483ee9d0534\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-the-profile-based-transformations-controlled-executable-size-growth-averaging-1--5bacab4b8a28\",\n      \"src_claim_ref\": \"8\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-direct-prediction-of-the-best-compiler-option-is-practical-for-relatively-small--fe68da808ef3\",\n      \"dst_claim_ref\": \"6\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Thread coarsening is an example of a bounded optimization choice where direct prediction can be useful.\",\n      \"relation_file_id\": \"rel-d16b82fe3af6f1c9394334648ba467454b0400f7ef91dc7152caa2eb54e0452d\",\n      \"relation_id\": \"supports:claim-thread-coarsening-decisions-are-context-dependent-because-coarsening-can-improve--4878860bda89->claim-direct-prediction-of-the-best-compiler-option-is-practical-for-relatively-small--fe68da808ef3\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-thread-coarsening-decisions-are-context-dependent-because-coarsening-can-improve--4878860bda89\",\n      \"src_claim_ref\": \"4\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-wcc-s-back-annotation-raises-assembly-level-wcet-information-to-source-level-icd--fc00d3acd6de\",\n      \"dst_claim_ref\": \"2\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Transparent aiT integration supplies the low-level WCET data that back-annotation raises to source-level structures.\",\n      \"relation_file_id\": \"rel-70a9b168f254829a81e2ea60355e092284d0e1452d370a6780fd87b5bfd2760a\",\n      \"relation_id\": \"supports:claim-wcc-couples-a-c-compiler-to-the-ait-static-wcet-analyzer-so-that-wcet-data-is-pr--13f9763eb2a9->claim-wcc-s-back-annotation-raises-assembly-level-wcet-information-to-source-level-icd--fc00d3acd6de\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-wcc-couples-a-c-compiler-to-the-ait-static-wcet-analyzer-so-that-wcet-data-is-pr--13f9763eb2a9\",\n      \"src_claim_ref\": \"1\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-the-wcc-optimizations-compose-applying-register-allocation-code-and-data-scratch--1393cb5b3616\",\n      \"dst_claim_ref\": \"10\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Register allocation is the largest individual component reported in the combined matmult optimization sequence.\",\n      \"relation_file_id\": \"rel-c4cbeb4704d62eb3a1e996f988122274196da648a8f2dfb134d45842f63d3162\",\n      \"relation_id\": \"supports:claim-wcet-aware-register-allocation-lowers-wcet-by-avoiding-spill-code-on-the-wcep-ev--a21ac879b656->claim-the-wcc-optimizations-compose-applying-register-allocation-code-and-data-scratch--1393cb5b3616\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-wcet-aware-register-allocation-lowers-wcet-by-avoiding-spill-code-on-the-wcep-ev--a21ac879b656\",\n      \"src_claim_ref\": \"9\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-execution-profiles-integrated-into-an-optimizing-c-compiler-can-guide-classic-op--20be52b7603e\",\n      \"dst_claim_ref\": \"0\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"Weighted execution counts provide the runtime information that lets the compiler focus optimizations on frequently executed regions.\",\n      \"relation_file_id\": \"rel-b17ef8d75224eae6bea1027945e142206ed8c539336035f941571dc2aca3027c\",\n      \"relation_id\": \"supports:claim-weighted-flow-graphs-expose-hot-paths-by-attaching-execution-counts-to-basic-blo--49c47f8431d5->claim-execution-profiles-integrated-into-an-optimizing-c-compiler-can-guide-classic-op--20be52b7603e\",\n      \"relation_type\": \"supports\",\n      \"src_claim_id\": \"claim-weighted-flow-graphs-expose-hot-paths-by-attaching-execution-counts-to-basic-blo--49c47f8431d5\",\n      \"src_claim_ref\": \"1\",\n      \"status\": \"open\"\n    }\n  ],\n  \"schema_version\": \"space_overview_context_v1\",\n  \"source_records\": [\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf/source.md\",\n        \"source_provenance\": \"sources/artifacts/source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf/source_provenance.md\"\n      },\n      \"authors\": [\n        \"Pohua P. Chang\",\n        \"Scott A. Mahlke\",\n        \"Wen-mei W. Hwu\"\n      ],\n      \"citation_count\": null,\n      \"citation_count_as_of\": null,\n      \"citation_count_confidence\": \"unknown\",\n      \"citation_count_provider\": \"unknown\",\n      \"date\": null,\n      \"display_title\": \"Profile-Guided Classic Optimizations for C Compilers\",\n      \"external_related_links\": [],\n      \"ingested_at\": \"2026-04-26T17:20:46Z\",\n      \"linked_source_ids\": [],\n      \"references\": [],\n      \"related_link_enrichment\": {\n        \"skip_reason\": \"no_curated_links_found\",\n        \"sources\": [],\n        \"status\": \"skipped\",\n        \"warnings\": []\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"high\",\n        \"date\": \"1991-04\",\n        \"origin\": \"report cover page and documentation page in source markdown\",\n        \"rationale\": \"The extracted cover material lists April 1991 and the report documentation page records the date of report as 1991 April.\"\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The proposed workflow inserts profiling after conventional global optimization and before final code generation. The compiler first lowers C to intermediate code, applies classic global optimizations, generates and runs a profiler on selected inputs, maps the summarized profile back onto the intermediate representation, and then reruns modified optimizations with profile data. This sequencing makes profile guidance additive rather than a replacement for the existing optimizer.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"10\"\n            ],\n            \"heading\": \"Compiler Integration\"\n          },\n          {\n            \"body\": \"The paper extends ordinary flow graphs into weighted flow graphs by associating execution counts with basic blocks and taken counts with arcs. This representation matters because static loop structure can treat cold and hot paths alike, while the profile-weighted graph makes skew explicit. The example path A-B-E-F executes far more often than nearby alternatives, motivating transformations that optimize that path even if cold paths become slightly more expensive.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"2\"\n            ],\n            \"heading\": \"Weighted Flow Representation\"\n          },\n          {\n            \"body\": \"Super-blocks are created by selecting traces and then using tail duplication to prevent entries into the middle of the selected trace. The result is a single-entry, multi-exit region where a compiler can reason about a frequently executed sequence with less interference from rare control-flow joins. This construction is the enabling representation behind the later optimization rules.\",\n            \"grounding_claim_ids\": [\n              \"2\",\n              \"3\",\n              \"11\"\n            ],\n            \"heading\": \"Super-Block Construction\"\n          },\n          {\n            \"body\": \"The source adapts a broad set of classic optimizations to super-blocks and super-block loops. Non-loop transformations operate on one super-block, while loop transformations operate on super-block loops with frequent back edges. The formal operation-combining example shows that the approach still respects operand and modification preconditions; the profile-guided representation expands legal and profitable cases rather than simply ignoring correctness constraints.\",\n            \"grounding_claim_ids\": [\n              \"4\",\n              \"5\"\n            ],\n            \"heading\": \"Optimization Reformulation\"\n          },\n          {\n            \"body\": \"The benchmark results give the strongest support for the practical value of the method. Across thirteen listed C programs, profile-based optimization averages a 1.15 speedup over globally optimized code, with substantial improvements for cmp, wc, eqn, grep, and mpla. The evaluation also uses separate performance inputs after profiling inputs, which reduces the chance that timing results merely measure the exact profiling runs.\",\n            \"grounding_claim_ids\": [\n              \"6\",\n              \"7\"\n            ],\n            \"heading\": \"Empirical Performance\"\n          },\n          {\n            \"body\": \"The method is not free. The prototype profiler slows instrumented executions by 25 to 35 times, and tail duplication can enlarge executables. The authors manage expansion with a trace-inclusion threshold of 100 executions and report an average size ratio of 1.07, but some programs still grow more. The implementation-size measurements suggest a feasible research prototype, not a proof that integration would be cheap in every production compiler.\",\n            \"grounding_claim_ids\": [\n              \"8\",\n              \"9\"\n            ],\n            \"heading\": \"Costs And Limits\"\n          }\n        ],\n        \"summary_long\": \"The report develops an early profile-guided optimization design for classic scalar compiler transformations. Its central move is to add execution counts to the compiler's flow-graph representation, then use those counts to identify the paths that dominate runtime. Rather than replacing conventional optimization, the approach applies ordinary global optimization first and then performs profile-based transformations on a restructured representation. The key representation is the super-block: a linear sequence of basic blocks selected from a hot trace, constrained so control can enter only at the first block while exiting remains possible at multiple points. Tail duplication enforces this shape by copying suffixes of traces that would otherwise have entries in the middle. Once the region has a single entry, familiar transformations such as propagation, common subexpression elimination, redundant load/store elimination, dead code removal, loop invariant code motion, induction variable elimination, and global variable migration can be applied with fewer conservative blockers. The technical argument is that hot-path isolation changes profitability and sometimes changes legality preconditions because operations become unique producers or variables become invariant within a super-block loop even when they are not invariant in the full loop body. The empirical section tests the prototype on non-numeric C applications using separate profiling and timing inputs. Profile-based optimization improves speed by an average factor of 1.15 over the authors' globally optimized baseline, with larger wins for programs such as cmp and wc. The report also acknowledges cost: probe-instrumented profiling runs are 25 to 35 times slower in the prototype, and tail duplication increases executable size. A threshold of 100 executions is used to limit trace growth, yielding an average profile-optimized size ratio of 1.07. Overall, the source is best read as a concrete compiler-engineering argument that profile information can expand the useful scope of classic optimizations when paired with a representation that makes hot paths explicit and auditable.\",\n        \"summary_short\": \"This 1991 compiler report shows how execution profiles steer classic C optimizations toward hot paths. It introduces weighted flow graphs, trace selection, tail duplication, and super-block optimization, reporting 1.15 average speedup with 1.07 average code growth.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"01-using-profile-information-to-assist-classic-code-optimizations.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Pohua P. Chang\",\n          \"Scott A. Mahlke\",\n          \"Wen-mei W. Hwu\"\n        ],\n        \"display_title\": \"Profile-Guided Classic Optimizations for C Compilers\",\n        \"record_display_title\": \"Untitled Source\",\n        \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n        \"source_locator\": \"01-using-profile-information-to-assist-classic-code-optimizations.pdf\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Chang, Mahlke, and Hwu describe how execution profiles can guide classic C compiler optimizations by forming super-blocks around hot paths and applying familiar transformations within those regions. Their prototype reports average speedups of 1.15 over globally optimized code while controlling code expansion to an average factor of 1.07.\",\n      \"title\": \"01-using-profile-information-to-assist-classic-code-optimizations\",\n      \"warnings\": [\n        \"The source record display title was Untitled Source, but the markdown extraction recovered the report title, authors, and April 1991 report date.\",\n    