         \"provenance\": {\n            \"origin\": \"reference_arxiv\",\n            \"source_field\": \"references[4].arxiv\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from an arXiv identifier found in the source references.\",\n          \"title\": \"115 H. D. Nguyen and F. Chamroukhi \\u201cAn introduction to the practical iv\",\n          \"url\": \"https://arxiv.org/abs/1610.09543\"\n        },\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"arxiv.org\",\n          \"link_type\": \"research_index\",\n          \"provenance\": {\n            \"origin\": \"reference_arxiv\",\n            \"source_field\": \"references[5].arxiv\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from an arXiv identifier found in the source references.\",\n          \"title\": \"s/ . 132 A. Bhattacharyya G. Kwasniewski and T. Hoefler \\u201cUsing compiler\",\n          \"url\": \"https://arxiv.org/abs/1701.07274\"\n        },\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"arxiv.org\",\n          \"link_type\": \"research_index\",\n          \"provenance\": {\n            \"origin\": \"reference_arxiv\",\n            \"source_field\": \"references[3].arxiv\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from an arXiv identifier found in the source references.\",\n          \"title\": \"techniques. He/she does not need to worry about how they morphology classification \\u201d arXiv preprint\",\n          \"url\": \"https://arxiv.org/abs/1005.0390\"\n        },\n        {\n          \"confidence\": \"medium\",\n          \"domain\": \"arxiv.org\",\n          \"link_type\": \"research_index\",\n          \"provenance\": {\n            \"origin\": \"reference_arxiv\",\n            \"source_field\": \"references[6].arxiv\"\n          },\n          \"quality_status\": \"trusted\",\n          \"rationale\": \"Derived from an arXiv identifier found in the source references.\",\n          \"title\": \"towards more intelligent predictive modeling \\u201d in 43rd International\",\n          \"url\": \"https://arxiv.org/abs/1707.03538\"\n        }\n      ],\n      \"ingested_at\": \"2026-04-26T17:30:10Z\",\n      \"linked_source_ids\": [],\n      \"references\": [\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"ser. CGO \\u201912 pp. 1\\u201312. research. Online . Available: /\",\n          \"url\": \"http://ctuning.org/ae\",\n          \"year\": 2012\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"contention for qos in warehouse scale computers \\u201d in Proceedings of the\",\n          \"url\": \"http://www.artifact-eval.org/about.html\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": null,\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"coordinating their integration into a general purpose system\",\n          \"url\": \"https://tech.slashdot.org/story/09/07/03/0143233/ibm-releases-open-\",\n          \"year\": null\n        },\n        {\n          \"arxiv\": \"1005.0390\",\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"techniques. He/she does not need to worry about how they morphology classification \\u201d arXiv preprint\",\n          \"url\": null,\n          \"year\": 2010\n        },\n        {\n          \"arxiv\": \"1610.09543\",\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"115 H. D. Nguyen and F. Chamroukhi \\u201cAn introduction to the practical iv\",\n          \"url\": null,\n          \"year\": 2016\n        },\n        {\n          \"arxiv\": \"1701.07274\",\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"s/ . 132 A. Bhattacharyya G. Kwasniewski and T. Hoefler \\u201cUsing compiler\",\n          \"url\": null,\n          \"year\": 2017\n        },\n        {\n          \"arxiv\": \"1707.03538\",\n          \"authors\": [],\n          \"doi\": null,\n          \"linked_source_ids\": [],\n          \"title\": \"towards more intelligent predictive modeling \\u201d in 43rd International\",\n          \"url\": null,\n          \"year\": 2017\n        }\n      ],\n      \"related_link_enrichment\": {\n        \"skip_reason\": null,\n        \"sources\": [\n          \"references\"\n        ],\n        \"status\": \"enriched\",\n        \"warnings\": [\n          \"Skipped 3 unsupported external-link candidate(s).\"\n        ]\n      },\n      \"schema_version\": \"source_record_v1\",\n      \"source_date_inference\": {\n        \"confidence\": \"unknown\",\n        \"date\": null,\n        \"origin\": \"unknown\",\n        \"rationale\": null\n      },\n      \"source_dossier\": {\n        \"sections\": [\n          {\n            \"body\": \"The source argues that compilers and machine learning fit naturally because optimization decisions are prediction problems over programs, hardware, and candidate transformations. A learned model can stand inside the compiler and choose heuristics or optimization options based on data, making compiler optimization less dependent on fixed expert rules and more responsive to new architectures or domains.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"1\",\n              \"8\"\n            ],\n            \"heading\": \"Core Argument\"\n          },\n          {\n            \"body\": \"The described pipeline has three linked activities: feature engineering, learning, and deployment. Programs are converted into quantifiable feature vectors; training examples are generated by compiling and timing candidate options; and the resulting model is inserted into the compiler to predict decisions for new programs. This makes the quality of feature design and training programs central to the whole method.\",\n            \"grounding_claim_ids\": [\n              \"1\",\n              \"2\",\n              \"3\"\n            ],\n            \"heading\": \"Learning Pipeline\"\n          },\n          {\n            \"body\": \"The OpenCL thread-coarsening example shows why learned profitability models matter. Coarsening can let one thread process multiple elements, which may increase instruction-level parallelism and reduce memory operations, but it can also reduce parallelism and increase register pressure. The best factor therefore depends on both the kernel and target GPU architecture rather than on a universally safe heuristic.\",\n            \"grounding_claim_ids\": [\n              \"4\",\n              \"6\"\n            ],\n            \"heading\": \"Thread Coarsening Example\"\n          },\n          {\n            \"body\": \"The survey treats features as a technical bottleneck, not a bookkeeping detail. Static code properties, dynamic profiling values, and hardware-sensitive measurements can all describe programs, but high-dimensional or redundant feature spaces demand more training examples. The PCA example that maps 17 OpenCL features into 7 aggregate features illustrates why selection and reduction are part of model quality.\",\n            \"grounding_claim_ids\": [\n              \"2\",\n              \"5\"\n            ],\n            \"heading\": \"Feature Engineering Constraints\"\n          },\n          {\n            \"body\": \"The strongest quantitative evidence in the extracted text comes from bounded decision problems. A loop-unroll predictor trained from more than 2,500 loops across 72 benchmarks correctly predicted unroll factors for 65% of testing loops and produced an average 5% SPEC 2000 improvement. This supports direct prediction where the set of compiler options is relatively small and measurable.\",\n            \"grounding_claim_ids\": [\n              \"3\",\n              \"6\"\n            ],\n            \"heading\": \"Measured Predictive Evidence\"\n          },\n          {\n            \"body\": \"The source explicitly limits its optimism. Learned compilation cannot create new legal transformations, prove legality, or overcome unrepresentative data. Training can be costly, benchmarks may be sparse, and black-box models make peer scrutiny harder unless data and experiments are available. These constraints mean machine learning augments rather than replaces compiler expertise.\",\n            \"grounding_claim_ids\": [\n              \"7\",\n              \"8\"\n            ],\n            \"heading\": \"Limits and Risks\"\n          },\n          {\n            \"body\": \"For practitioners, the survey suggests using machine learning where decisions are empirically measurable and expensive to hand-tune: optimization flags, unroll factors, thread counts, coarsening factors, scheduling, or cost models. The method is strongest when the candidate space is clear, features are meaningful, benchmarks resemble deployment programs, and validation separates training from test behavior.\",\n            \"grounding_claim_ids\": [\n              \"0\",\n              \"3\",\n              \"6\",\n              \"7\"\n            ],\n            \"heading\": \"Practical Interpretation\"\n          },\n          {\n            \"body\": \"The paper\\u2019s future directions broaden the agenda from choosing optimizations to understanding program and hardware spaces. It asks whether machine learning can help learn analyses such as dataflow or points-to reasoning, discover reusable feature sets, and perhaps shape better compiler intermediate representations. These are framed as open questions rather than established results.\",\n            \"grounding_claim_ids\": [\n              \"9\"\n            ],\n            \"heading\": \"Research Outlook\"\n          }\n        ],\n        \"summary_long\": \"Machine Learning in Compilers presents machine-learning-based compilation as a way to turn optimization heuristics into evidence-driven predictions. The central problem is familiar to compiler engineers: for a given program, architecture, and optimization space, it is hard to know which transformation or parameter choice will improve speed, code size, energy, or another quality metric. Wang and O\\u2019Boyle describe a workflow in which training programs are represented by quantifiable features, compiled or executed under candidate options, labelled with the best observed choices, and used to train models that are later deployed inside the compiler. The survey treats this not as magic or as a replacement for compiler expertise, but as a way to automate profitability analysis and reduce reliance on brittle hand-tuned heuristics. The source\\u2019s examples make the workflow concrete. In OpenCL thread coarsening, a factor-of-two transformation causes one thread to process two input elements, but the best coarsening factor depends on program structure and GPU architecture because coarsening can both expose instruction-level parallelism and reduce available parallelism or increase register pressure. The surveyed Magni et al. work therefore measures multiple coarsening factors, extracts static LLVM-derived features, reduces candidate feature dimensions with PCA, and trains a model from benchmark outcomes. The survey also reviews direct-prediction studies such as loop-unroll factor prediction, where models trained on thousands of loops achieved 65% test prediction accuracy and a 5% average SPEC 2000 improvement. These results support the paper\\u2019s broader claim that supervised learning is especially useful when the compiler decision space is bounded enough to generate labels and compare alternatives. The paper is also careful about limitations. Machine learning can only learn from the training data and transformations provided; it cannot invent legal transformations or replace compiler analyses that prove legality. Training cost, sparse benchmark availability, specialist domains, noisy measurements, feature selection, and black-box model evaluation all constrain practical adoption. The survey\\u2019s final interpretation is therefore balanced: machine learning can make compiler optimization more empirical, repeatable, and adaptable across hardware and domains, while opening new research questions about program-space maps, learned analyses, deep feature construction, and intermediate representations.\",\n        \"summary_short\": \"Zheng Wang and Michael O\\u2019Boyle frame machine learning as a practical continuation of compiler automation: use empirical data to decide when optimizations help. The survey explains how compilers can learn from program features and measured outcomes, while stressing that learned models remain bounded by the data, transformations, and legality information supplied by compiler engineers.\"\n      },\n      \"source_extraction\": {\n        \"converter_name\": \"pdftotext\",\n        \"converter_version\": null,\n        \"quality_status\": \"usable\",\n        \"status\": \"success\",\n        \"warnings\": []\n      },\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"source_kind\": \"file\",\n      \"source_locator\": \"02-machine-learning-in-compiler-optimization.pdf\",\n      \"source_media_type\": \"application/pdf\",\n      \"source_semantic\": {\n        \"authors\": [\n          \"Zheng Wang\",\n          \"Michael O\\u2019Boyle\"\n        ],\n        \"display_title\": \"Machine Learning Makes Compiler Optimization Empirical\",\n        \"record_display_title\": \"Untitled Source\",\n        \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\"\n      },\n      \"source_type\": \"file\",\n      \"summary\": \"Wang and O\\u2019Boyle survey machine-learning-based compilation as an evidence-driven way to automate compiler optimization decisions. The source explains feature engineering, training, deployment, model families, direct prediction, thread-coarsening examples, and practical limits around data quality, training cost, legality, and representativeness.\",\n      \"title\": \"02-machine-learning-in-compiler-optimization\",\n      \"warnings\": [\n        {\n          \"code\": \"missing_publication_date\",\n          \"message\": \"Publication date could not be resolved; continuing with date=null.\"\n        },\n        {\n          \"code\": \"two_column_markdown_layout\",\n          \"message\": \"The pdftotext markdown is usable but contains two-column interleaving in several passages, so extracted claims are conservative and rely on clearly readable source fragments.\"\n        }\n      ]\n    },\n    {\n      \"analysis_policy\": {\n        \"fallback_artifacts\": [\n          \"source_file\"\n        ],\n        \"preferred_artifact\": \"source_markdown\",\n        \"quality_status\": \"usable\",\n        \"warnings\": []\n      },\n      \"article_kind\": null,\n      \"artifact_root\": \"sources/artifacts/source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"artifacts\": {\n        \"front_page_image\": \"sources/artifacts/source-03-compiler-design-for-distributed-quantum-computing--64a02810764d/front_page.png\",\n        \"source_extraction\": \"sources/artifacts/source-03-compiler-design-for-distributed-quantum-computing--64a02810764d/source_extraction.json\",\n        \"source_file\": \"sources/artifacts/source-03-compiler-design-for-distributed-quantum-computing--64a02810764d/source.pdf\",\n        \"source_markdown\": \"sources/artifacts/source-03-compiler-design-for-distributed-quantum-computing--64a02810764d/source.md\",\n        \"source_provenance