{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"printf 'context.json:\\\\n'; cat verification/example_site/spaces/compilers/outputs/space_overview/subspace--compilers/context.json; printf '\\\\n\\\\nsources records:\\\\n'; find verification/example_site/spaces/compilers/sources/records -maxdepth 2 -type f | sort; printf '\\\\nclaims:\\\\n'; find verification/example_site/spaces/compilers/claims -maxdepth 2 -type f | sort; printf '\\\\nrelations:\\\\n'; find verification/example_site/spaces/compilers/relations -maxdepth 2 -type f | sort; printf '\\\\ntopics:\\\\n'; find verification/example_site/spaces/compilers/topics -maxdepth 2 -type f | sort\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"printf 'context.json:\\\\n'; cat verification/example_site/spaces/compilers/outputs/space_overview/subspace--compilers/context.json; printf '\\\\n\\\\nsources records:\\\\n'; find verification/example_site/spaces/compilers/sources/records -maxdepth 2 -type f | sort; printf '\\\\nclaims:\\\\n'; find verification/example_site/spaces/compilers/claims -maxdepth 2 -type f | sort; printf '\\\\nrelations:\\\\n'; find verification/example_site/spaces/compilers/relations -maxdepth 2 -type f | sort; printf '\\\\ntopics:\\\\n'; find verification/example_site/spaces/compilers/topics -maxdepth 2 -type f | sort\"","aggregated_output":"context.json:\n{\n  \"claims\": [\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-classic-scalar-optimizations-can-be-reformulated-to-operate-on-super-blocks-and--79ce55378df0\",\n      \"evidence_excerpts\": [\n        \"Table 2 shows a list of classic code optimizations that we have extended to use profile information.\",\n        \"The non-loop based code optimizations work on a single super-block at a time. The loop based code optimizations work on a single super-block loop at a time.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Classic optimizations fit super-blocks\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Classic scalar optimizations can be reformulated to operate on super-blocks and super-block loops rather than only on traditional basic blocks or whole loops.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-direct-prediction-of-the-best-compiler-option-is-practical-for-relatively-small--fe68da808ef3\",\n      \"evidence_excerpts\": [\n        \"Stephenson and Amarasinghe ... used over 2,500 loops from 72 benchmarks to train two machine learning models ... their techniques correctly predict the unroll factor for 65% of the testing loops, leading to on average, a 5% improvement for the SPEC 2000 benchmark suite.\",\n        \"These papers show that supervised machine learning can be a powerful tool for modelling problems with a relatively small number of optimisation options.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Constrained choices enable direct prediction\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Direct prediction of the best compiler option is practical for relatively small optimization problems and has produced measurable gains in loop unrolling and thread-coarsening studies.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-distributed-quantum-compilers-must-model-temporal-coupling-map-dynamics-because--0883f72a302d\",\n      \"evidence_excerpts\": [\n        \"These additional constraints must be properly modeled within the coupling map, so that the distributed quantum compiler can optimize the quantum circuit by accounting for the temporal dynamics arising with the distributed architecture.\",\n        \"The clock of the remote operations will be significantly lower than the clock of the local operations.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Coupling maps become dynamic\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Distributed quantum compilers must model temporal coupling-map dynamics because remote operations are constrained by Bell-state availability, Bell-state regeneration, and classical communication latency.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-distributed-quantum-computing-can-let-remote-quantum-processing-units-cooperate--c8a669f6488f\",\n      \"evidence_excerpts\": [\n        \"Remote quantum processing units can communicate and cooperate for executing computational tasks that single, noisy, intermediate-scale quantum devices cannot handle by themselves.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Distributed QPUs cooperate virtually\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Distributed quantum computing can let remote quantum processing units cooperate as a virtual quantum processor for tasks that individual noisy intermediate-scale quantum devices cannot handle alone.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-distributed-quantum-computing-requires-compilers-that-can-map-arbitrary-quantum--e4ea92cd41cd\",\n      \"evidence_excerpts\": [\n        \"Distributed quantum computing requires a new generation of quantum compilers, for mapping any quantum algorithm to any distributed quantum computing architecture.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Distributed architectures require compilers\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Distributed quantum computing requires compilers that can map arbitrary quantum algorithms to distributed architectures while accounting for network and communication constraints.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-effective-concentration-calibration-guides-thresholds--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"Using b/a = 1.4, we chose a nominal threshold of 0.35x and 0.85x for two-input OR and AND gate, respectively, and 0.4x and 1.6x for three-input OR and AND gate. Experiments of the logic gates showed desired behaviours.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Calibration guides gate thresholds\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"Effective concentration calibration provides quantitative threshold choices that restore desired OR and AND gate behavior for unpurified seesaw components.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-entanglement-swapping-augments-distributed-processor-connectivity-by-enabling-re--b0cac39f5fb5\",\n      \"evidence_excerpts\": [\n        \"Entanglement swapping enhances the network connectivity through virtual quantum links.\",\n        \"Entanglement swapping consumes the Bell states stored within the communication qubits at the intermediate processors.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Entanglement swapping augments connectivity\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Entanglement swapping augments distributed-processor connectivity by enabling remote CNOTs between processors that are not directly connected by a quantum link, but it increases EPR-pair consumption at intermediate processors.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-execution-profiles-integrated-into-an-optimizing-c-compiler-can-guide-classic-op--20be52b7603e\",\n      \"evidence_excerpts\": [\n        \"An execution profiler can be integrated into an optimizing compiler to provide the compiler with run-time information about user programs. For each code optimization, the profile information along with information from static loop analysis is used to reduce the execution time of the most frequently executed program regions.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Profiles guide classic optimizations\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Execution profiles integrated into an optimizing C compiler can guide classic optimizations toward the program regions that run most often.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-experimental-validation-on-medium-size-quantum-circuits-respected-the-analytical--82f1bfd54f5c\",\n      \"evidence_excerpts\": [\n        \"Table 1 clearly shows that the upper bounds on the number of layers that result from compiling the layers of remote CNOTs are widely respected and hold for all the considered examples.\",\n        \"Fig. 15(c) also shows that choosing the data-qubit-swapping-based strategy against the entanglement-swapping-based strategy is generally the best choice.\",\n        \"Fig. 16(c) confirms that the data-qubit-swapping-based strategy is better than the entanglement-swapping-based one.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Experiments respect analytical bounds\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Experimental validation on medium-size quantum circuits respected the analytical bounds, and the data-qubit-swapping strategy generally required fewer link-generation layers and lower circuit depth than entanglement swapping alone.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-feature-selection-and-dimension-reduction-are-necessary-in-compiler-learning-pro--ecd12a4a4f1f\",\n      \"evidence_excerpts\": [\n        \"As the number of features increase so does the number of training examples needed to build an accurate model. Hence, we need to limit the dimension of the feature space. In compiler research, commonly, an initial large, high dimensional candidate feature space is pruned via feature selection, or projected into a lower dimensional space.\",\n        \"Principal Component Analysis ... is applied to map the 17 candidate features into 7 aggregated features, so that each aggregated feature is a linear combination of the original features.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Feature reduction preserves signal\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Feature selection and dimension reduction are necessary in compiler-learning problems because larger feature spaces require more training examples and can contain redundant information.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-full-circuit-recovers-ideal-ca-patterns--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"The arrays for the DNA circuit were plotted using the output values at 24 h from the data. The ideal logic circuit behaviour corresponds to an image of a black dog with a white background for R1241, an inverted image for R1240 and their mirror images for R1101 and R1100, respectively.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Outputs match automata patterns\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"The full rule 110-124 DNA circuit produced dual-rail fluorescence outputs at 24 hours that visually matched the intended cellular automata pattern relationships.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-future-research-in-machine-learning-compilation-extends-beyond-choosing-optimiza--faf587f1fc17\",\n      \"evidence_excerpts\": [\n        \"The open research directions go beyond predicting the best optimisations to apply. One central issue is what does the program space look like?\",\n        \"Can machine learning also be applied to compiler analysis? For instance is it possible to learn dataflow or point-to analysis? ... Can we learn the ideal compiler intermediate representation?\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Open questions extend beyond optimization\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Future research in machine-learning compilation extends beyond choosing optimizations to mapping program and hardware spaces, learning analyses, discovering common features, and possibly learning better intermediate representations.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-ilp-based-code-scratchpad-allocation-lowers-wcet-by-moving-beneficial-basic-bloc--d5d88da4e90e\",\n      \"evidence_excerpts\": [\n        \"Across 73 benchmarks, tiny program SPMs reduce WCET to 92.6% of the no-SPM WCET, and SPMs large enough for entire benchmarks reach 60% of original WCET; average code size increases by 0.02%.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Code SPM reduces WCET\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"ILP-based code scratchpad allocation lowers WCET by moving beneficial basic-block regions into fast program scratchpad memory with negligible code-size and solver overhead.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-ilp-based-data-scratchpad-allocation-lowers-wcet-by-moving-frequently-accessed-v--8ceca90523fc\",\n      \"evidence_excerpts\": [\n        \"For petrinet, an 8-byte data SPM reduces WCET to 82.5% and fitting all global data reaches 69.7%; for the real TriCore 40 kB SPM, average WCET reaches 79.8% of original WCET.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Data SPM reduces WCET\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"ILP-based data scratchpad allocation lowers WCET by moving frequently accessed variables into fast data scratchpad memory without changing generated code size.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-in-the-worst-case-topology-the-entanglement-swapping-based-strategy-has-per-laye--bd58d42b2d90\",\n      \"evidence_excerpts\": [\n        \"The depth overhead of the entanglement-swapping-based strategy does not exceed the following depth: n/2 des.\",\n        \"des = cle + cbsm + ccx.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Entanglement strategy has linear bound\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"In the worst-case topology, the entanglement-swapping-based strategy has per-layer depth overhead bounded by n/2 times a hardware-dependent constant des, where des equals cle plus cbsm plus ccx.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-interprocedural-slicing-and-polyhedral-loop-evaluation-substantially-reduce-loop--8f361a6ac310\",\n      \"evidence_excerpts\": [\n        \"Table 2 reports matmul falling from 8.4 s to 2.4 s with slicing and 0.8 s with polytope evaluation, while fft falls from 920.7 s to 119.7 s with slicing and 110.5 s with polytope evaluation.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Slicing accelerates loop analysis\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"Interprocedural slicing and polyhedral loop evaluation substantially reduce loop-analysis time for many benchmarks while preserving safe loop-bound analysis.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-machine-learning-based-compilation-can-make-compiler-optimization-more-evidence--20aeeff3a32c\",\n      \"evidence_excerpts\": [\n        \"One of the real benefits of machine learning based approaches is that it forces an empirical driven approach to compiler construction. New models have to be based on empirical data which can then be verified by independent experimentation.\",\n        \"This paper has introduced machine learning based compilation and described its power in determining an evidence based approach to compiler optimisation.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Empirical workflows improve compiler evidence\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Machine-learning-based compilation can make compiler optimization more evidence based because models must be grounded in empirical data that can be tested and independently scrutinized.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-machine-learning-based-compilation-can-use-a-model-inside-the-compiler-to-choose--f8131a5c483d\",\n      \"evidence_excerpts\": [\n        \"Given a program, compiler writers would like to know what compiler heuristic or optimisation to apply in order to make the code better. Better often means execute faster, but can also mean smaller code footprint or reduced power. Machine learning can be used to build a model used within the compiler, that makes such decisions for any given program.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Learning guides compiler choices\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Machine-learning-based compilation can use a model inside the compiler to choose compiler heuristics or optimizations for a given program according to learned evidence about what makes code faster, smaller, or less power hungry.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-machine-learning-based-compiler-optimization-is-limited-by-the-quality-represent--f9c7d385cc26\",\n      \"evidence_excerpts\": [\n        \"Machine learning can only learn form what is provided by the compiler writer. Machine learning can not invent new program transformations to apply nor can it derive analysis that determines whether or not a transformation is legal \\u2013 all of this is beyond its scope.\",\n        \"The most immediate problem continues to be gathering enough sufficient high quality training data.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Training data limits learning\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Machine-learning-based compiler optimization is limited by the quality, representativeness, and cost of its training data and cannot by itself create legal transformations or derive legality analyses.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-on-the-benchmark-suite-profile-based-super-block-optimizations-averaged-a-1-15-s--e5d7486c0e56\",\n      \"evidence_excerpts\": [\n        \"name global profile local MIPS. 04 GNU.O ... cmp 1.0 1.42 0.95 0.96 0.95 ... wc 1.0 1.32 0.97 0.96 0.87 ... avg. 1.0 1.15 0.89 0.96 0.88 ... Table 5: Speed for each individual benchmark.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Profile optimization speeds benchmarks\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"On the benchmark suite, profile-based super-block optimizations averaged a 1.15 speedup over the prototype compiler's globally optimized code.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-outlier-gates-expose-synthesis-variation--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"With a gate calibration experiment shown in Fig. 4b, we measured that g18,53/a18,53 = 0.8x for one gate and g22,53/a22,53 = 0.44x for another.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Outliers disrupt gate composition\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"Gate calibration can identify outlier unpurified components whose effective concentrations differ enough to disrupt multi-layer circuit composition.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-profile-based-classic-optimizations-are-intended-to-complement-conventional-opti--6bcefbcf9607\",\n      \"evidence_excerpts\": [\n        \"It should be noted that profile-based code optimizations are not alternatives to conventional optimizations, but are meant to be applied in addition to conventional optimizations.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Profile optimizations complement convention\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Profile-based classic optimizations are intended to complement conventional optimizations rather than replace them.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-program-features-provide-the-quantifiable-representation-that-allows-learning-al--a254f7b701be\",\n      \"evidence_excerpts\": [\n        \"Machine learning relies on a set of quantifiable properties, or features, to characterise the programs. There are many different features that can be used. These include the static data structures extracted from the program source code or the compiler intermediate representation ... dynamic profiling information ... or a combination of the both.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Features encode program behavior\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Program features provide the quantifiable representation that allows learning algorithms to reason about source code, intermediate representation, runtime profiles, or combinations of those properties.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-remote-cnot-execution-consumes-bell-state-resources-and-is-limited-by-the-number--ff11e4d2be8e\",\n      \"evidence_excerpts\": [\n        \"For each remote CNOT, a Bell state is consumed and a new Bell state must be distributed between the remote processors through the quantum link before another remote CNOT can be executed.\",\n        \"The number of remote CNOTs that can be executed simultaneously between two processors is limited by the number of communication qubits jointly available at each processor.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Remote CNOTs consume Bell states\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"Remote CNOT execution consumes Bell-state resources and is limited by the number of available communication qubits, creating a tradeoff between communication capacity and data-qubit capacity.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-rule-110-124-circuit-has-78-species--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"The DNA circuit generated by the Seesaw Compiler consisted of 6 layers and a total of 78 distinct initial DNA species.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Circuit has 78 species\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"The compiled rule 110-124 DNA strand displacement circuit contains six layers and 78 distinct initial DNA species.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-seesaw-compiler-automates-dna-circuit-design--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"A feedforward digital logic circuit is first translated into an equivalent dual-rail logic circuit and then translated into an equivalent seesaw DNA circuit. Visual DSD code and Mathematica code are generated for analysing and simulating the seesaw DNA circuit, and DNA sequences are generated for constructing the circuit.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Compiler automates DNA circuits\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"The Seesaw Compiler automates the translation of feedforward digital logic into equivalent dual-rail and seesaw DNA strand displacement circuits, while producing simulation code and DNA sequences for construction.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-signal-restoration-compensates-for-impurity--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"The signal restoration built in to every logic gate allows simple tuning to restore desired circuit behaviour, compensating for the impurity of molecules.\",\n        \"It is also necessary to eliminate leak reactions in DNA circuits and to improve the building blocks such that they are substantially less sensitive to synthesis errors and stoichiometry errors.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Restoration compensates impurity\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"Signal restoration and component tuning compensate for impurity in unpurified seesaw circuits, although leak reactions and sensitivity to synthesis and stoichiometry errors remain limiting concerns.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-static-wcet-reduction-depends-on-optimizing-the-worst-case-execution-path-becaus--b6a70fae6e3d\",\n      \"evidence_excerpts\": [\n        \"A program\\u2019s WCET is computed by finding the maximum path WCET for all feasible paths; the path leading to the WCET is called the worst-case execution path. The source example reduces one WCEP block by 40 cycles but lowers global WCET only from 205 to 195 cycles.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"WCEP governs WCET savings\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"Static WCET reduction depends on optimizing the worst-case execution path, because reducing a noncritical path or a local block can leave the global WCET unchanged or only partly reduced.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-super-blocks-represent-frequently-executed-paths-as-linear-basic-block-sequences--7bbb510c9bb0\",\n      \"evidence_excerpts\": [\n        \"A super-block has the following features. (1) It is a linear sequence of basic blocks B(i),i = l..n, where n > 1. (2) It can be entered only from B( 1). (3) The program control may leave the super-block from any basic block.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Super-blocks isolate hot paths\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Super-blocks represent frequently executed paths as linear basic-block sequences that can only be entered at the first block but may exit from any block.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-supervised-learning-for-compiler-optimization-learns-correlations-between-progra--217abf25c992\",\n      \"evidence_excerpts\": [\n        \"Using supervised machine learning, a predictive model is trained on empirical performance data (labelled outputs) and important quantifiable properties (features) of representative programs. The model learns the correlation between these feature values and the optimisation decision that delivers the optimal (or nearly optimal) performance.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Supervision maps features to decisions\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Supervised learning for compiler optimization learns correlations between program-feature values and the optimization decisions that produce optimal or near-optimal empirical performance.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-synthesis-error-model-explains-delayed-outputs--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"Simulations of the rule 110-124 circuit using the previously developed model for purified seesaw circuits predicted desired outputs in roughly 8 h and undesired reactions taking over in 24 h, while simulations using the new model for unpurified seesaw circuits predicted desired outputs in roughly 24 h.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Error model explains delay\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"A model that represents synthesis errors in unpurified molecules predicts the slower 24-hour behavior of the rule 110-124 circuit better than the purified-circuit model.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-systematic-flow-shortens-unpurified-circuit-building--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"Starting from the calibration of effective concentrations for threshold and gate species in general, to the identification and adjustment of any outliers, and then to the final tuning of circuit output, we established three sequential steps for building unpurified seesaw circuits.\",\n        \"Following the flowchart, we completed the construction of the rule 110 sub-circuit in only 3 days.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Procedure shortens circuit building\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"A three-step systematic procedure of calibration, outlier adjustment, and output tuning enabled construction of the rule 110 sub-circuit in three days.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-tail-duplication-creates-additional-optimization-opportunities-because-it-can-ma--6c81300e0307\",\n      \"evidence_excerpts\": [\n        \"Duplicating the tail part of a trace to form a super-block eliminates control paths that enter the trace in the middle. For many op(x) and op(y) instruction pairs, op(x) becomes the sole producer of one or more source operands of op(y). Therefore, profile-based operation combining can find more opportunities for optimization than traditional operation combining.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Duplication exposes producer relationships\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Tail duplication creates additional optimization opportunities because it can make an earlier operation the sole producer of operands used later in a hot path.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-the-data-qubit-swapping-based-strategy-arranges-data-qubits-so-each-cnot-in-a-la--ba4ebf62d172\",\n      \"evidence_excerpts\": [\n        \"The objective is to arrange (i.e., to swap) the data qubits within the quantum processors so that eventually each CNOT of the original layer operates on qubits stored at neighbor processors within the network topology.\",\n        \"Theorem 1: Let us consider the ith layer of an arbitrary n-qubit quantum circuit. The depth of the corresponding compiled quantum circuit, obtained through the data-qubit-swapping-based strategy, does not exceed the following depth: n/4 dqs + dqs'.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Data swapping lowers asymptotic overhead\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"The data-qubit-swapping-based strategy arranges data qubits so each CNOT in a layer operates on neighboring processors, and its compiled per-layer depth does not exceed n/4 dqs plus dqs prime.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-the-experiments-used-separate-profiling-inputs-and-performance-measurement-input--ee5ac2fa5a94\",\n      \"evidence_excerpts\": [\n        \"For each benchmark program, we have selected a number of input data for profiling. Table 4 shows the inputs that are used for each benchmark program. For each benchmark program, we have selected one additional input and used that input to measure the performance.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Benchmarks use separate inputs\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"The experiments used separate profiling inputs and performance-measurement inputs across realistic C application programs.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-the-implementation-cost-of-profile-based-classic-optimization-was-modest-relativ--062df22ec16c\",\n      \"evidence_excerpts\": [\n        \"The global code optimizer in our prototype compiler consists of approximately 32,000 lines of C code. The profile-based classic code optimizer consists of approximately 11,000 lines of C code. The profiler has about 2,000 lines of C code and a few assembly language subroutines.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Implementation cost is modest\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"The implementation cost of profile-based classic optimization was modest relative to the existing global optimizer.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-the-machine-learning-compiler-workflow-separates-model-learning-from-deployment--a04ee1ab9738\",\n      \"evidence_excerpts\": [\n        \"There are two main stages involved: learning and deployment. The first stage learns the model based on training data, while the second uses the model on new unseen programs.\",\n        \"In the final step, the learned model is inserted into the compiler to predict the best optimisation decisions for new programs.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Training precedes deployment\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"The machine-learning compiler workflow separates model learning from deployment: training data is used to learn a model, and the learned model is then inserted into the compiler to make predictions for new programs.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-the-major-effectiveness-mechanisms-are-eliminating-entries-into-the-middle-of-tr--4bc0ff5e21b0\",\n      \"evidence_excerpts\": [\n        \"We have identified two major reasons why these code optimizations are effective: (1) eliminating control flows into the middle sections of a trace, and (2) optimizing the most frequently executed path in a loop.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Effectiveness has two mechanisms\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"The major effectiveness mechanisms are eliminating entries into the middle of traces and optimizing the most frequently executed loop path.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-the-paper-s-worst-case-system-model-uses-one-data-qubit-per-processor-and-a-one--9e5973bc3485\",\n      \"evidence_excerpts\": [\n        \"Only one data qubit is available at each quantum processor.\",\n        \"The quantum processors are interconnected through a 1-D nearest-neighbor topology, and only one data qubit is available at each quantum processor.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Worst case maximizes overhead\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"The paper's worst-case system model uses one data qubit per processor and a one-dimensional nearest-neighbor processor topology, making every CNOT remote and maximizing distributed-computation overhead.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-the-profile-based-transformations-controlled-executable-size-growth-averaging-1--5bacab4b8a28\",\n      \"evidence_excerpts\": [\n        \"For these experiments we use an execution count threshold of 100. Table 6 shows how code optimizations affect the sizes of the benchmark programs.\",\n        \"name global profile local ... xlisp 1.0 1.20 1.01 ... avg. 1.0 1.07 1.00 ... Table 6: Ratios of code expansion.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Code expansion stays controlled\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"The profile-based transformations controlled executable size growth, averaging 1.07 relative size compared with globally optimized programs.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:45:24Z\",\n      \"claim_id\": \"claim-the-proposed-compiler-is-computationally-efficient-because-distributing-a-circui--b9f318c6234c\",\n      \"evidence_excerpts\": [\n        \"Applying a remote CNOT has a computational complexity of O(n), with n being the number of QPUs. Given that we need at most n/4 swaps, the computational complexity of Algorithm 2 turns out to be O(n2). The overall computational complexity of distributing a circuit is, therefore, O(dn2).\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Compiler complexity is polynomial\",\n      \"source_id\": \"source-03-compiler-design-for-distributed-quantum-computing--64a02810764d\",\n      \"text\": \"The proposed compiler is computationally efficient because distributing a circuit has O(d n squared) complexity, with d the circuit depth and n the number of QPUs or logical qubits in the modeled worst case.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-the-wcc-optimizations-compose-applying-register-allocation-code-and-data-scratch--1393cb5b3616\",\n      \"evidence_excerpts\": [\n        \"For matmult, the combined sequence reduces WCET from 775,720 cycles to 227,794 cycles, with register allocation saving 284,000 cycles, code SPM a further 120,000 cycles, data SPM another 135,000 cycles, and procedure positioning 8,000 cycles.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Optimizations compose strongly\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"The WCC optimizations compose: applying register allocation, code and data scratchpad allocation, and procedure positioning to matmult reduces WCET by more than 70 percent relative to WCC -O2.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:34:43Z\",\n      \"claim_id\": \"claim-thread-coarsening-decisions-are-context-dependent-because-coarsening-can-improve--4878860bda89\",\n      \"evidence_excerpts\": [\n        \"Thread coarsening can improve performance through increasing instruction-level parallelism, reducing the number of memory-access operations, and eliminating redundant computation when the same value is computed in every work-item. However, it can also have several negative side-effects such as reducing the total amount of parallelism and increasing the register pressure, which can lead to slowdown performance.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Thread coarsening is context dependent\",\n      \"source_id\": \"source-02-machine-learning-in-compiler-optimization--5fbaa9c3f69d\",\n      \"text\": \"Thread coarsening decisions are context dependent because coarsening can improve instruction-level parallelism and memory behavior while also reducing parallelism or increasing register pressure on particular programs and hardware.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-trace-selection-followed-by-tail-duplication-converts-frequently-executed-traces--1483ee9d0534\",\n      \"evidence_excerpts\": [\n        \"The formation of super-blocks is a two step procedure: (1) trace selection and (2) tail duplication. Trace selection identifies basic blocks that tend to execute in a sequence and groups them into a trace.\",\n        \"After trace selection, each trace is converted into a super-block by duplicating the tail part of the trace, in order to ensure that the program control can only enter at the top basic block.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Tail duplication forms super-blocks\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Trace selection followed by tail duplication converts frequently executed traces into super-blocks by removing control-flow entries into the middle of a trace.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T18:03:17Z\",\n      \"claim_id\": \"claim-unpurified-strands-can-build-complex-circuits--367a566abb69\",\n      \"evidence_excerpts\": [\n        \"Here we demonstrate the use of circuit design software, combined with the use of unpurified strands and simplified experimental procedures, for creating a complex DNA strand displacement circuit that consists of 78 distinct species.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Unpurified strands support circuits\",\n      \"source_id\": \"source-05-compiler-aided-systematic-construction-of-large-scale-dna-strand-displacement-circuits--367a566abb69\",\n      \"text\": \"Unpurified DNA strands can be used to construct complex DNA strand displacement circuits when circuit design software is combined with simplified experimental procedures.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcc-couples-a-c-compiler-to-the-ait-static-wcet-analyzer-so-that-wcet-data-is-pr--13f9763eb2a9\",\n      \"evidence_excerpts\": [\n        \"WCC produces a CRL2 file, invokes aiT transparently, and performs value, loop bound, cache, pipeline, and path analysis while the compiler user is unaware that timing analysis is running in the background.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"WCC integrates static analysis\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCC couples a C compiler to the aiT static WCET analyzer so that WCET data is produced transparently during compilation rather than by a separate manual post-compilation step.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcc-s-back-annotation-raises-assembly-level-wcet-information-to-source-level-icd--fc00d3acd6de\",\n      \"evidence_excerpts\": [\n        \"The transformed back-annotation data include WCET for the entire program, functions, and basic blocks; WCEP membership; worst-case execution frequency per CFG edge; execution feasibility; I-cache misses per basic block; code size; and spill-code amount.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Back annotation enables optimization\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCC\\u2019s back-annotation raises assembly-level WCET information to source-level ICD-C structures, enabling source-level optimizations to use WCET, WCEP membership, execution frequencies, cache misses, code size, and spill-code data.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcc-s-loop-analyzer-computes-safe-loop-iteration-bounds-for-most-benchmark-loops--5eb419e33259\",\n      \"evidence_excerpts\": [\n        \"Table 1 reports 96 benchmarks with 707 loops in total; 99% of loops are analyzable and 96% have exact iteration counts on average.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Loop bounds become automatic\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCC\\u2019s loop analyzer computes safe loop iteration bounds for most benchmark loops and exact bounds for the great majority, reducing reliance on manual flow facts.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcet-aware-procedure-cloning-improves-wcet-estimates-by-specializing-functions-w--808a9c5da846\",\n      \"evidence_excerpts\": [\n        \"For mpeg2, procedure cloning reduces WCET estimates by 63.6% for standard cloning and 62.7% for WCET-aware cloning; epic has a 693.7% code-size increase after standard cloning and 357.9% after WCET-aware cloning.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Cloning sharpens loop bounds\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCET-aware procedure cloning improves WCET estimates by specializing functions whose data-dependent loop bounds become constant in cloned calling contexts, but it trades timing precision for code-size growth.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcet-aware-register-allocation-lowers-wcet-by-avoiding-spill-code-on-the-wcep-ev--a21ac879b656\",\n      \"evidence_excerpts\": [\n        \"Across 46 benchmarks, WCET-aware register allocation achieves an average WCET of 68.8% of traditional graph coloring, reducing WCET by 31.2%, while text size increases by 29.8% on average.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Register allocation protects WCEP\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCET-aware register allocation lowers WCET by avoiding spill code on the WCEP, even when this increases total spill code or text size outside the critical path.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:55:13Z\",\n      \"claim_id\": \"claim-wcet-centric-procedure-positioning-reduces-instruction-cache-conflict-misses-by--47eeb6643a90\",\n      \"evidence_excerpts\": [\n        \"Figure 7 reports that greedy procedure positioning achieves an average WCET reduction of 10%, while the heuristic reduces WCET by 4% on average; combined cloning and positioning reaches reductions up to 64%.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Positioning reduces cache misses\",\n      \"source_id\": \"source-04-a-compiler-framework-for-the-reduction-of-worst-case-execution-times--5aee9841160e\",\n      \"text\": \"WCET-centric procedure positioning reduces instruction-cache conflict misses by reordering functions using static WCET-derived call frequencies rather than profiling input data.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T17:27:45Z\",\n      \"claim_id\": \"claim-weighted-flow-graphs-expose-hot-paths-by-attaching-execution-counts-to-basic-blo--49c47f8431d5\",\n      \"evidence_excerpts\": [\n        \"We define a weighted flow graph as a quadruplet {V,E, count, arc.count], where each node in V is a basic block, each arc in E is a potential control flow path between two basic blocks, count{v) is a function that returns the execution count of a basic block u, and arc-count(e) is a function that returns the taken count of a control flow path e.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Weighted graphs expose hot paths\",\n      \"source_id\": \"source-01-using-profile-information-to-assist-classic-code-optimizations--219edcf6f0cf\",\n      \"text\": \"Weighted flow graphs expose hot paths by attaching execution counts to basic blocks and taken counts to control-flow arcs.\"\n    }\n  ],\n  \"freshness\": {\n    \"claim_count\": 52,\n    \"generated_at\": \"2026-04-26T18:23:52Z\",\n    \"input_signature\": \"sha256:15ee7db9721f756d4a567a0a6869982a3d085b66d86b0470240a72aaccbb63f1\",\n    \"relation_count\": 31,\n    \"source_record_count\": 5,\n    \"topic_count\": 14\n  },\n  \"metadata\": {\n    \"overview_id\": \"subspace--compilers\",\n    \"parent_space_name\": \"computer-science\",\n    \"scope_kind\": \"subspace\",\n    \"scope_name\": \"compilers\",\n    \"scope_title\": \"Compilers\",\n    \"space_name\": \"compilers\"\n  },\n  \"relations\": [\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-machine-learning-based-compilation-can-make-compiler-optimization-more-evidence--20aeeff3a32c\",\n      \"dst_claim_ref\": \"8\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"The future research agenda follows from treating compiler optimization as an empirical learning problem.\",\n      \"relation_file_id\": \"rel-84961ca1fbd972e0a5f7698758e77e2e6e99bdf350ff7dd9110f64822df4f8c6\",\n      \"relation_id\": \"derived_from:claim-future-research-in-machine-learning-compilation-extends-beyond-choosing-optimiza--faf587f1fc17->claim-machine-learning-based-compilation-can-make-compiler-optimization-more-evidence--20aeeff3a32c\",\n      \"relation_type\": \"derived_from\",\n      \"src_claim_id\": \"claim-future-research-in-machine-learning-compilation-extends-beyond-choosing-optimiza--faf587f1fc17\",\n      \"src_claim_ref\": \"9\",\n      \"status\": \"open\"\n    },\n    {\n      \"below_040_streak\": 0,\n      \"contradiction_confidence_band\": \"unknown\",\n      \"dst_claim_id\": \"claim-the-proposed-compiler-is-computationally-efficient-because-distributing-a-circui--b9f318c6234c\",\n      \"dst_claim_ref\": \"8\",\n      \"last_evaluated_run_id\": null,\n      \"rationale\": \"The data-qubit-swapping theorem contributes to the compiler's polynomial effectiveness and complexity profile.\",\n      \"relation_file_id\": \"rel-6486c8259