iased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\"\n  ]\n}\n{\n  \"topic_id\": \"topic-spatial-abstractions-for-interactive-images\",\n  \"title\": \"Spatial abstractions for interactive images\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-a-shader-is-a-gpu-directed-program-that-describes-rendering-processes-for-turnin--64c2250afac1\",\n    \"claim-fragment-shaders-map-two-dimensional-pixel-positions-to-colors-and-can-generate--ff479c9f654e\",\n    \"claim-raymarching-can-recreate-three-dimensional-depth-inside-a-fragment-shader-by-mar--eb7e615f4e18\",\n    \"claim-image-based-impostor-rendering-with-positional-and-directional-discretization-ca--3b5de902e034\",\n    \"claim-perturbing-an-impostor-plane-toward-a-pca-derived-best-fitting-plane-reduces-vie--e9f84568a82e\",\n    \"claim-a-regular-grid-of-environment-tiles-can-support-both-collision-behavior-and-shad--202b441327e8\",\n    \"claim-the-same-image-database-used-for-impostors-can-project-posture-consistent-human--625367fc5d02\"\n  ],\n  \"source_ids\": [\n    \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\"\n  ]\n}\n{\n  \"topic_id\": \"topic-spatial-guides-for-graphics-computation\",\n  \"title\": \"Spatial guides as compact control structures in graphics computation\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-foveated-rendering-can-accelerate-rendering-by-giving-the-foveal-region-high-qua--d710634b4892\",\n    \"claim-foveated-rendering-research-is-organized-around-three-recurring-problems-applyin--aba700066fc3\",\n    \"claim-a-regular-grid-of-environment-tiles-can-support-both-collision-behavior-and-shad--202b441327e8\",\n    \"claim-skeletons-of-inflated-edge-cluster-shapes-provide-locally-centered-targets-for-b--27f82ed32127\",\n    \"claim-the-attraction-rule-moves-interior-edge-points-toward-feature-transform-location--8607f298987e\",\n    \"claim-restricting-attraction-to-skeleton-paths-passing-through-endpoint-feature-points--86df6a0326fa\"\n  ],\n  \"source_ids\": [\n    \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n    \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\"\n  ]\n}\n{\n  \"topic_id\": \"topic-taxonomies-and-abstractions-for-rendering-paradigms\",\n  \"title\": \"Taxonomies and abstractions for comparing rendering paradigms\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-a-useful-taxonomy-for-foveated-rendering-classifies-methods-by-required-input-da--a46ce25de499\",\n    \"claim-foveated-rendering-methods-span-multiple-data-types-foveation-principles-and-ren--0c481572e2ab\",\n    \"claim-the-survey-classifies-90-published-foveated-rendering-reports-from-1990-to-2021--d0734ae4812f\",\n    \"claim-a-shader-is-a-gpu-directed-program-that-describes-rendering-processes-for-turnin--64c2250afac1\",\n    \"claim-fragment-shaders-map-two-dimensional-pixel-positions-to-colors-and-can-generate--ff479c9f654e\",\n    \"claim-raymarching-can-recreate-three-dimensional-depth-inside-a-fragment-shader-by-mar--eb7e615f4e18\",\n    \"claim-image-based-impostor-rendering-with-positional-and-directional-discretization-ca--3b5de902e034\",\n    \"claim-hierarchical-agglomerative-clustering-with-full-linkage-and-euclidean-distances--759b1a2656e8\"\n  ],\n  \"source_ids\": [\n    \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n    \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n    \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\"\n  ]\n}\n{\n  \"topic_id\": \"topic-technical-constraints-as-generative-conditions\",\n  \"title\": \"Technical constraints as generative conditions for graphics practice\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-complex-vr-scenes-exceed-the-efficient-real-time-rendering-capacity-of-current-d--4b00d0d7a546\",\n    \"claim-foveated-rendering-can-accelerate-rendering-by-giving-the-foveal-region-high-qua--d710634b4892\",\n    \"claim-future-foveated-rendering-work-needs-broader-use-of-human-visual-features-improv--36729372977e\",\n    \"claim-digital-art-practice-must-negotiate-the-tension-between-scientific-technical-pro--0ddadf7f5e3d\",\n    \"claim-mathematical-and-technical-constraints-in-shadercoding-can-become-creative-motor--5b703448e7f5\",\n    \"claim-mastered-shadercoding-can-support-real-time-artistic-improvisation-that-fuses-co--51c4a707f8d0\",\n    \"claim-skeleton-based-edge-bundling-is-most-appropriate-for-coarse-scale-connectivity-e--14fed4bbcde5\",\n    \"claim-image-based-impostor-rendering-with-positional-and-directional-discretization-ca--3b5de902e034\"\n  ],\n  \"source_ids\": [\n    \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n    \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n    \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\"\n  ]\n}\n{\n  \"topic_id\": \"topic-technical-constraints-as-visual-generators\",\n  \"title\": \"Technical constraints as visual generators\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-creating-original-shaders-requires-substantial-mathematical-and-technical-fluenc--7ec21177eabc\",\n    \"claim-digital-art-practice-must-negotiate-the-tension-between-scientific-technical-pro--0ddadf7f5e3d\",\n    \"claim-mathematical-and-technical-constraints-in-shadercoding-can-become-creative-motor--5b703448e7f5\",\n    \"claim-packing-each-prerendered-human-sample-into-the-smallest-containing-rectangle-red--c2027548dc18\",\n    \"claim-opengl-compressed-textures-and-compact-frame-storage-allow-ten-human-types-with--0cc37130330a\",\n    \"claim-alpha-channel-multipass-rendering-can-recolor-significant-body-regions-such-as-c--265615107527\"\n  ],\n  \"source_ids\": [\n    \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\"\n  ]\n}\n{\n  \"topic_id\": \"topic-visual-control-tradeoffs-in-computed-graphics\",\n  \"title\": \"Visual control tradeoffs in computed graphics\",\n  \"summary\": null,\n  \"claim_ids\": [\n    \"claim-smoothing-relaxation-and-cushion-shading-let-users-adjust-whether-bundles-appear--f208f3204963\",\n    \"claim-skeleton-based-edge-bundling-is-most-appropriate-for-coarse-scale-connectivity-e--14fed4bbcde5\",\n    \"claim-perturbing-an-impostor-plane-toward-a-pca-derived-best-fitting-plane-reduces-vie--e9f84568a82e\",\n    \"claim-alpha-channel-multipass-rendering-can-recolor-significant-body-regions-such-as-c--265615107527\",\n    \"claim-the-same-image-database-used-for-impostors-can-project-posture-consistent-human--625367fc5d02\",\n    \"claim-mathematical-and-technical-constraints-in-shadercoding-can-become-creative-motor--5b703448e7f5\",\n    \"claim-mastered-shadercoding-can-support-real-time-artistic-improvisation-that-fuses-co--51c4a707f8d0\"\n  ],\n  \"source_ids\": [\n    \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n    \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n    \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\"\n  ]\n}\n--- claims compact ---\n{\n  \"claim_id\": \"claim-a-regular-grid-of-environment-tiles-can-support-both-collision-behavior-and-shad--202b441327e8\",\n  \"short_title\": \"Grid tiles guide motion\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"A regular grid of environment tiles can support both collision behavior and shadowing decisions for moving virtual humans.\"\n}\n{\n  \"claim_id\": \"claim-a-shader-is-a-gpu-directed-program-that-describes-rendering-processes-for-turnin--64c2250afac1\",\n  \"short_title\": \"Shaders direct GPU rendering\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"A shader is a GPU-directed program that describes rendering processes for turning 3D spatial data and physical properties into an image.\"\n}\n{\n  \"claim_id\": \"claim-a-two-pass-accumulation-field-method-fits-directly-into-the-opengl-pipeline-and--bf684a8c9b90\",\n  \"short_title\": \"Two passes avoid hierarchies\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"A two-pass accumulation-field method fits directly into the OpenGL pipeline and avoids extra point-hierarchy storage for node aggregation.\"\n}\n{\n  \"claim_id\": \"claim-a-useful-taxonomy-for-foveated-rendering-classifies-methods-by-required-input-da--a46ce25de499\",\n  \"short_title\": \"Taxonomy has three dimensions\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"A useful taxonomy for foveated rendering classifies methods by required input data type, foveation principle, and rendering paradigm.\"\n}\n{\n  \"claim_id\": \"claim-alpha-channel-multipass-rendering-can-recolor-significant-body-regions-such-as-c--265615107527\",\n  \"short_title\": \"Multipass coloring diversifies avatars\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"Alpha-channel multipass rendering can recolor significant body regions such as clothes, hair, and skin to increase avatar variety while preserving baked texture shading.\"\n}\n{\n  \"claim_id\": \"claim-complex-vr-scenes-exceed-the-efficient-real-time-rendering-capacity-of-current-d--4b00d0d7a546\",\n  \"short_title\": \"VR latency causes discomfort\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Complex VR scenes exceed the efficient real-time rendering capacity of current devices, and delayed rendering can make displayed content inconsistent with user interaction, causing discomfort.\"\n}\n{\n  \"claim_id\": \"claim-creating-original-shaders-requires-substantial-mathematical-and-technical-fluenc--7ec21177eabc\",\n  \"short_title\": \"Shadercraft requires mathematical fluency\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Creating original shaders requires substantial mathematical and technical fluency in functions, vectors, matrices, and spatial reasoning.\"\n}\n{\n  \"claim_id\": \"claim-cuda-image-space-distance-transforms-skeletonization-path-computation-and-attrac--46de973cba61\",\n  \"short_title\": \"CUDA accelerates skeleton bundling\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"CUDA image-space distance transforms, skeletonization, path computation, and attraction make the skeleton-based edge bundling pipeline substantially faster than a CPU AFMM implementation on the tested graphs.\"\n}\n{\n  \"claim_id\": \"claim-digital-art-practice-must-negotiate-the-tension-between-scientific-technical-pro--0ddadf7f5e3d\",\n  \"short_title\": \"Digital art bridges calculation\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Digital art practice must negotiate the tension between scientific-technical processes and the desire to produce sensible artistic experience.\"\n}\n{\n  \"claim_id\": \"claim-edge-endpoints-can-be-aggregated-by-hill-climbing-on-the-node-density-field-so-t--6e6b82bcec81\",\n  \"short_title\": \"Hill climbing aggregates edges\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"Edge endpoints can be aggregated by hill-climbing on the node density field so that inter-cluster connections are emphasized and inner-cluster connections vanish.\"\n}\n{\n  \"claim_id\": \"claim-foveated-rendering-can-accelerate-rendering-by-giving-the-foveal-region-high-qua--d710634b4892\",\n  \"short_title\": \"Foveation preserves perceived quality\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Foveated rendering can accelerate rendering by giving the foveal region high quality and the peripheral region lower quality while preserving perceived visual quality.\"\n}\n{\n  \"claim_id\": \"claim-foveated-rendering-methods-span-multiple-data-types-foveation-principles-and-ren--0c481572e2ab\",\n  \"short_title\": \"Foveation spans multiple principles\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Foveated rendering methods span multiple data types, foveation principles, and rendering paradigms, including image/video, volume data, meshes, point clouds, holograms, light fields, multi-resolution variants, LoD, rasterization, ray tracing, ray casting, neural rendering, phase retrieval, and data transmission.\"\n}\n{\n  \"claim_id\": \"claim-foveated-rendering-research-is-organized-around-three-recurring-problems-applyin--aba700066fc3\",\n  \"short_title\": \"Foveation requires three decisions\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Foveated rendering research is organized around three recurring problems: applying human-visual-system perceptual models, rendering regions at different qualities, and integrating foveation into rendering paradigms.\"\n}\n{\n  \"claim_id\": \"claim-fragment-shaders-map-two-dimensional-pixel-positions-to-colors-and-can-generate--ff479c9f654e\",\n  \"short_title\": \"Fragment shaders generate patterns\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Fragment shaders map two-dimensional pixel positions to colors and can generate animated mathematical patterns responsive to time or external inputs.\"\n}\n{\n  \"claim_id\": \"claim-future-foveated-rendering-work-needs-broader-use-of-human-visual-features-improv--36729372977e\",\n  \"short_title\": \"Open problems remain broad\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Future foveated-rendering work needs broader use of human visual features, improved gaze and AI techniques, better methods for new data types, more suitable rendering paradigms, stronger objective quality metrics, and deeper AR and task-oriented applications.\"\n}\n{\n  \"claim_id\": \"claim-hierarchical-agglomerative-clustering-with-full-linkage-and-euclidean-distances--759b1a2656e8\",\n  \"short_title\": \"Sampling clusters similar edges\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Hierarchical agglomerative clustering with full linkage and Euclidean distances between uniformly sampled edge points yields clusters of geometrically close edges that follow graph structure.\"\n}\n{\n  \"claim_id\": \"claim-image-based-impostor-rendering-with-positional-and-directional-discretization-ca--3b5de902e034\",\n  \"short_title\": \"Impostors enable real-time crowds\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"Image-based impostor rendering with positional and directional discretization can display dense animated crowds in large virtual urban environments at interactive rates.\"\n}\n{\n  \"claim_id\": \"claim-mastered-shadercoding-can-support-real-time-artistic-improvisation-that-fuses-co--51c4a707f8d0\",\n  \"short_title\": \"Mastery enables live improvisation\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Mastered shadercoding can support real-time artistic improvisation that fuses code, image, performer, and audience into a live digital performance.\"\n}\n{\n  \"claim_id\": \"claim-mathematical-and-technical-constraints-in-shadercoding-can-become-creative-motor--5b703448e7f5\",\n  \"short_title\": \"Constraints drive shader creativity\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Mathematical and technical constraints in shadercoding can become creative motors rather than merely limiting conditions.\"\n}\n{\n  \"claim_id\": \"claim-measured-overview-rendering-stayed-below-one-second-for-several-datasets-up-to-a--d5763f10ba50\",\n  \"short_title\": \"Overview rendering stays fast\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"Measured overview rendering stayed below one second for several datasets up to about 1.5 million edges, while a 4.55 million-edge dataset required about 1.2 seconds for overview rendering.\"\n}\n{\n  \"claim_id\": \"claim-opengl-compressed-textures-and-compact-frame-storage-allow-ten-human-types-with--0cc37130330a\",\n  \"short_title\": \"Compressed textures enable variety\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"OpenGL compressed textures and compact frame storage allow ten human types with ten animation frames each to fit in about 25 Mbytes of texture memory.\"\n}\n{\n  \"claim_id\": \"claim-packing-each-prerendered-human-sample-into-the-smallest-containing-rectangle-red--c2027548dc18\",\n  \"short_title\": \"Sample packing cuts memory\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"Packing each prerendered human sample into the smallest containing rectangle reduces the texture memory needed for human images to one quarter of the original value without loss of image quality.\"\n}\n{\n  \"claim_id\": \"claim-perturbing-an-impostor-plane-toward-a-pca-derived-best-fitting-plane-reduces-vie--e9f84568a82e\",\n  \"short_title\": \"PCA planes reduce popping\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"Perturbing an impostor plane toward a PCA-derived best-fitting plane reduces viewpoint-change popping for walking human impostors while limiting newly introduced distortions.\"\n}\n{\n  \"claim_id\": \"claim-pixel-bin-seed-points-reduce-node-density-rendering-work-without-changing-the-de--a2f787a75006\",\n  \"short_title\": \"Seed points preserve density\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"Pixel-bin seed points reduce node-density rendering work without changing the density field produced for a given viewport.\"\n}\n{\n  \"claim_id\": \"claim-raymarching-can-recreate-three-dimensional-depth-inside-a-fragment-shader-by-mar--eb7e615f4e18\",\n  \"short_title\": \"Raymarching recreates shader depth\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Raymarching can recreate three-dimensional depth inside a fragment shader by marching a ray through a distance-field description until it reaches an object.\"\n}\n{\n  \"claim_id\": \"claim-repeated-reclustering-with-decreasing-similarity-thresholds-creates-bottom-up-bu--0f90a7b7b684\",\n  \"short_title\": \"Iterative reclustering coarsens bundles\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Repeated reclustering with decreasing similarity thresholds creates bottom-up bundling in which fine local bundles merge into coarser structures.\"\n}\n{\n  \"claim_id\": \"claim-restricting-attraction-to-skeleton-paths-passing-through-endpoint-feature-points--86df6a0326fa\",\n  \"short_title\": \"Path regularization prevents kinks\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Restricting attraction to skeleton paths passing through endpoint feature points prevents sharp kinks caused by feature-transform singularities.\"\n}\n{\n  \"claim_id\": \"claim-shader-showdowns-turn-shadercoding-into-a-timed-public-performance-evaluated-thr--a575bceeaf8e\",\n  \"short_title\": \"Showdowns stage shader performance\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Shader Showdowns turn shadercoding into a timed public performance evaluated through the final image, code technique, and visual evolution during the event.\"\n}\n{\n  \"claim_id\": \"claim-shadercoding-blends-programming-mathematics-and-graphics-into-a-digital-art-prac--ba3619b7f801\",\n  \"short_title\": \"Shadercoding blends code and art\",\n  \"source_id\": \"source-01-sphere-tracing-a-geometric-method-for-the-antialiased-ray-tracing-of-implicit-surfaces--eee351440d34\",\n  \"text\": \"Shadercoding blends programming, mathematics, and graphics into a digital-art practice that can be theorized technically and performatively.\"\n}\n{\n  \"claim_id\": \"claim-skeleton-based-edge-bundling-is-most-appropriate-for-coarse-scale-connectivity-e--14fed4bbcde5\",\n  \"short_title\": \"Bundling trades detail for structure\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Skeleton-based edge bundling is most appropriate for coarse-scale connectivity exploration because bundling overdraws individual edges and distorts edge directions.\"\n}\n{\n  \"claim_id\": \"claim-skeletons-of-inflated-edge-cluster-shapes-provide-locally-centered-targets-for-b--27f82ed32127\",\n  \"short_title\": \"Skeletons guide edge bundles\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Skeletons of inflated edge-cluster shapes provide locally centered targets for bundling geometrically similar graph edges.\"\n}\n{\n  \"claim_id\": \"claim-smoothing-relaxation-and-cushion-shading-let-users-adjust-whether-bundles-appear--f208f3204963\",\n  \"short_title\": \"Smoothing controls bundle structure\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"Smoothing, relaxation, and cushion shading let users adjust whether bundles appear as sharp organic branches or smoother force-directed-like curves while preserving the computed connectivity pattern.\"\n}\n{\n  \"claim_id\": \"claim-straight-line-graph-drawings-can-be-rendered-interactively-with-adjustable-level--d4a598a6ca79\",\n  \"short_title\": \"LOD renders large graphs\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"Straight-line graph drawings can be rendered interactively with adjustable level of detail by combining density-based node aggregation with edge cumulation on graphics hardware.\"\n}\n{\n  \"claim_id\": \"claim-the-attraction-rule-moves-interior-edge-points-toward-feature-transform-location--8607f298987e\",\n  \"short_title\": \"Attraction preserves node endpoints\",\n  \"source_id\": \"source-03-skeleton-based-edge-bundling-for-graph-visualization--1a3dfa0e6b4c\",\n  \"text\": \"The attraction rule moves interior edge points toward feature-transform locations on the skeleton while keeping edge endpoints fixed at their node positions.\"\n}\n{\n  \"claim_id\": \"claim-the-edge-aggregation-approach-operates-in-image-space-and-does-not-require-preco--da4e8cd6122f\",\n  \"short_title\": \"Image space avoids preprocessing\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"The edge aggregation approach operates in image space and does not require precomputed supporting data structures such as hierarchies or meshes.\"\n}\n{\n  \"claim_id\": \"claim-the-lago-implementation-supports-interactive-zooming-panning-normalization-contr--0c65d7666097\",\n  \"short_title\": \"LaGO enables graph exploration\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"The LaGO implementation supports interactive zooming, panning, normalization control, color mapping, and detail-on-demand labeling for large graph exploration.\"\n}\n{\n  \"claim_id\": \"claim-the-rendering-complexity-remains-linear-in-input-size-with-seed-point-rectangle--8a6cf3a6542e\",\n  \"short_title\": \"Complexity stays linear\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"The rendering complexity remains linear in input size, with seed-point rectangle work bounded by the smaller of node count and pixel count.\"\n}\n{\n  \"claim_id\": \"claim-the-same-image-database-used-for-impostors-can-project-posture-consistent-human--625367fc5d02\",\n  \"short_title\": \"Impostors project human shadows\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"The same image database used for impostors can project posture-consistent human shadows onto the ground at the cost of one additional polygon.\"\n}\n{\n  \"claim_id\": \"claim-the-survey-classifies-90-published-foveated-rendering-reports-from-1990-to-2021--d0734ae4812f\",\n  \"short_title\": \"Ninety reports fit taxonomy\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"The survey classifies 90 published foveated-rendering reports from 1990 to 2021 using the three-dimensional taxonomy.\"\n}\n{\n  \"claim_id\": \"claim-the-tested-system-renders-10-000-different-humans-in-a-41-260-polygon-village-at--6845dedcbaed\",\n  \"short_title\": \"Ten thousand humans remain interactive\",\n  \"source_id\": \"source-02-image-based-crowd-rendering--565ae2b0e3a1\",\n  \"text\": \"The tested system renders 10,000 different humans in a 41,260-polygon village at 12 to 20 frames per second, with measured frame rates falling from 26.20 fps at zero people to 13.35 fps at 10,000 people.\"\n}\n{\n  \"claim_id\": \"claim-the-visualization-examples-reveal-interpretable-patterns-in-real-graph-datasets--6f7b292bd09e\",\n  \"short_title\": \"Examples reveal graph patterns\",\n  \"source_id\": \"source-05-interactive-level-of-detail-rendering-of-large-graphs--df4eb719b5f7\",\n  \"text\": \"The visualization examples reveal interpretable patterns in real graph datasets, including flight hubs, migration flows, Net50 structures, and OpenStreetMap building-density patterns.\"\n}\n{\n  \"claim_id\": \"claim-visual-acuity-models-and-contrast-sensitivity-models-are-the-two-representative--544eac975fd9\",\n  \"short_title\": \"HVS models guide foveation\",\n  \"source_id\": \"source-04-foveated-rendering-a-state-of-the-art-survey--2a4e30f52f30\",\n  \"text\": \"Visual acuity models and contrast sensitivity models are the two representative perceptual-model families used to guide foveated rendering quality allocation.\"\n}\n--- relations compact ---\n{\n  \"relation_id\": \"derived_from:claim-a-useful-taxonomy-for-foveated-rendering-classifies-methods-by-required-input-da--a46ce25de499->claim-foveated-rendering-research-is-organized-around-three-recurring-problems-applyin--aba700066fc3\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"derived_from\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"derived_from:claim-the-attraction-rule-moves-interior-edge-points-toward-feature-transform-location--8607f298987e->claim-skeletons-of-inflated-edge-cluster-shapes-provide-locally-centered-targets-for-b--27f82ed32127\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"derived_from\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"derived_from:claim-the-same-image-database-used-for-impostors-can-project-posture-consistent-human--625367fc5d02->claim-a-regular-grid-of-environment-tiles-can-support-both-collision-behavior-and-shad--202b441327e8\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"derived_from\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"similar:claim-foveated-rendering-methods-span-multiple-data-types-foveation-principles-and-ren--0c481572e2ab|claim-future-foveated-rendering-work-needs-broader-use-of-human-visual-features-improv--36729372977e\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"similar\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"supports:claim-complex-vr-scenes-exceed-the-efficient-real-time-rendering-capacity-of-current-d--4b00d0d7a546->claim-foveated-rendering-can-accelerate-rendering-by-giving-the-foveal-region-high-qua--d710634b4892\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"supports\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"supports:claim-creating-original-shaders-requires-substantial-mathematical-and-technical-fluenc--7ec21177eabc->claim-digital-art-practice-must-negotiate-the-tension-between-scientific-technical-pro--0ddadf7f5e3d\",\n  \"subject_claim_id\": null,\n  \"object_claim_id\": null,\n  \"predicate\": null,\n  \"relation_type\": \"supports\",\n  \"description\": null\n}\n{\n  \"relation_id\": \"supports:claim-edge-endpoints-can-be-aggregated-by-hill-climbing-on-the-node-density-field-so-t--6e6b82bcec81->claim-straight-line-graph-drawi