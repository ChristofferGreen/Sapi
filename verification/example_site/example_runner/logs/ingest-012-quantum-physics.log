{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\n\noutput_path = Path('/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/runs/run-20260426T155454Z--ee4hs1p14s/semantic/ingest_extraction.json')\nsource_id = 'source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8'\n\ndata = {\n    \\\"source_date_inference\\\": {\n        \\\"date\\\": \\\"2019-10-23\\\",\n        \\\"confidence\\\": \\\"high\\\",\n        \\\"origin\\\": \\\"sources/artifacts/source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8/source.md\\\",\n        \\\"rationale\\\": \\\"The extracted markdown header states 'Published online: 23 October 2019'.\\\"\n    },\n    \\\"source\\\": {\n        \\\"display_title\\\": \\\"Quantum Supremacy Using a Programmable Superconducting Processor\\\",\n        \\\"authors\\\": [\n            \\\"Frank Arute\\\",\n            \\\"Kunal Arya\\\",\n            \\\"Ryan Babbush\\\",\n            \\\"Dave Bacon\\\",\n            \\\"Joseph C. Bardin\\\",\n            \\\"Rami Barends\\\",\n            \\\"Rupak Biswas\\\",\n            \\\"Sergio Boixo\\\",\n            \\\"Fernando G. S. L. Brandao\\\",\n            \\\"David A. Buell\\\",\n            \\\"Brian Burkett\\\",\n            \\\"Yu Chen\\\",\n            \\\"Zijun Chen\\\",\n            \\\"Ben Chiaro\\\",\n            \\\"Roberto Collins\\\",\n            \\\"William Courtney\\\",\n            \\\"Andrew Dunsworth\\\",\n            \\\"Edward Farhi\\\",\n            \\\"Brooks Foxen\\\",\n            \\\"Austin Fowler\\\",\n            \\\"Craig Gidney\\\",\n            \\\"Marissa Giustina\\\",\n            \\\"Rob Graff\\\",\n            \\\"Keith Guerin\\\",\n            \\\"Steve Habegger\\\",\n            \\\"Matthew P. Harrigan\\\",\n            \\\"Michael J. Hartmann\\\",\n            \\\"Alan Ho\\\",\n            \\\"Markus Hoffmann\\\",\n            \\\"Trent Huang\\\",\n            \\\"Travis S. Humble\\\",\n            \\\"Sergei V. Isakov\\\",\n            \\\"Evan Jeffrey\\\",\n            \\\"Zhang Jiang\\\",\n            \\\"Dvir Kafri\\\",\n            \\\"Kostyantyn Kechedzhi\\\",\n            \\\"Julian Kelly\\\",\n            \\\"Paul V. Klimov\\\",\n            \\\"Sergey Knysh\\\",\n            \\\"Alexander Korotkov\\\",\n            \\\"Fedor Kostritsa\\\",\n            \\\"David Landhuis\\\",\n            \\\"Mike Lindmark\\\",\n            \\\"Erik Lucero\\\",\n            \\\"Dmitry Lyakh\\\",\n            \\\"Salvatore Mandrà\\\",\n            \\\"Jarrod R. McClean\\\",\n            \\\"Matthew McEwen\\\",\n            \\\"Anthony Megrant\\\",\n            \\\"Xiao Mi\\\",\n            \\\"Kristel Michielsen\\\",\n            \\\"Masoud Mohseni\\\",\n            \\\"Josh Mutus\\\",\n            \\\"Ofer Naaman\\\",\n            \\\"Matthew Neeley\\\",\n            \\\"Charles Neill\\\",\n            \\\"Murphy Yuezhen Niu\\\",\n            \\\"Eric Ostby\\\",\n            \\\"Andre Petukhov\\\",\n            \\\"John C. Platt\\\",\n            \\\"Chris Quintana\\\",\n            \\\"Eleanor G. Rieffel\\\",\n            \\\"Pedram Roushan\\\",\n            \\\"Nicholas C. Rubin\\\",\n            \\\"Daniel Sank\\\",\n            \\\"Kevin J. Satzinger\\\",\n            \\\"Vadim Smelyanskiy\\\",\n            \\\"Kevin J. Sung\\\",\n            \\\"Matthew D. Trevithick\\\",\n            \\\"Amit Vainsencher\\\",\n            \\\"Benjamin Villalonga\\\",\n            \\\"Theodore White\\\",\n            \\\"Z. Jamie Yao\\\",\n            \\\"Ping Yeh\\\",\n            \\\"Adam Zalcman\\\",\n            \\\"Hartmut Neven\\\",\n            \\\"John M. Martinis\\\"\n        ],\n        \\\"source_id\\\": source_id,\n        \\\"doi\\\": \\\"10.1038/s41586-019-1666-5\\\"\n    },\n    \\\"claims\\\": [\n        {\n            \\\"text\\\": \\\"The Sycamore superconducting processor created random-circuit quantum states on 53 qubits, corresponding to a computational state space of 2\"'^53, about 10''^16 basis states.\",\n            \"short_title\": \"Sycamore reaches 53 qubits\",\n            \"evidence_excerpts\": [\n                \"Here we report the use of a processor with programmable superconducting qubits to create quantum states on 53 qubits, corresponding to a computational state-space of dimension 2''^53 (about 10''^16).\"\n            ]\n        },\n        {\n            \"text\": \"For the hardest reported random-circuit sampling task, Sycamore produced one million samples in about 200 seconds while the authors estimated equal-fidelity classical sampling would take about 10,000 years on one million cores.\",\n            \"short_title\": \"Quantum sampling outpaces classical\",\n            \"evidence_excerpts\": [\n                \"For m = 20, obtaining a million samples on the quantum processor takes 200 seconds, whereas an equal-fidelity classical sampling would take 10,000 years on a million cores.\"\n            ]\n        },\n        {\n            \"text\": \"Linear cross-entropy benchmarking provides a fidelity measure by comparing experimentally observed bitstrings with ideal probabilities computed by classical simulation.\",\n            \"short_title\": \"XEB measures circuit fidelity\",\n            \"evidence_excerpts\": [\n                \"F_XEB = 2''^n <P(x_i)>_i - 1, where n is the number of qubits, P(x_i) is the probability of bitstring x_i computed for the ideal quantum circuit, and the average is over the observed bitstrings.\"\n            ]\n        },\n        {\n            \"text\": \"The largest elided 53-qubit, 20-cycle circuits yielded F_XEB = (2.24 ± 0.21) × 10''^-3 over 30 million samples, supporting an average fidelity above 0.1% with 5σ confidence.\",\n            \"short_title\": \"Elided circuits retain fidelity\",\n            \"evidence_excerpts\": [\n                \"For the largest circuit with 53 qubits and 20 cycles, we collected N_s = 30 × 10''^6 samples over ten circuit instances, obtaining F_XEB = (2.24 ±0.21) × 10''^-3 for the elided circuits. With 5σ confidence, we assert that the average fidelity of running these circuits on the quantum processor is greater than at least 0.1%.\"\n            ]\n        },\n        {\n            \"text\": \"Measured component error rates under simultaneous operation were low enough to support a model predicting measurable fidelity for full random circuits.\",\n            \"short_title\": \"Gate errors predict fidelity\",\n            \"evidence_excerpts\": [\n                \"Average error values under simultaneous operation were single-qubit e1 = 0.16%, two-qubit e2 = 0.62%, two-qubit cycle e2c = 0.93%, and readout er = 3.8%.\"\n            ]\n        },\n        {\n            \"text\": \"The largest random circuits combined 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and one measurement per qubit, for which the authors predicted a total fidelity of 0.2%.\",\n            \"short_title\": \"Large circuits remain measurable\",\n            \"evidence_excerpts\": [\n                \"Our largest random quantum circuits have 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and a measurement on each qubit, for which we predict a total fidelity of 0.2%.\"\n            ]\n        },\n        {\n            \"text\": \"Random quantum circuits become exponentially harder to simulate classically as qubit count and circuit depth increase because their output distributions lack exploitable structure.\",\n            \"short_title\": \"Random circuits scale exponentially\",\n            \"evidence_excerpts\": [\n                \"Random circuits are a suitable choice for benchmarking because they do not possess structure and therefore allow for limited guarantees of computational hardness. Classically computing this probability distribution becomes exponentially more difficult as the number of qubits and number of gate cycles grow.\"\n            ]\n        },\n        {\n            \"text\": \"Agreement among full, patch, elided, and predicted fidelities on classically verifiable circuits supports using elided circuits to estimate fidelity in the supremacy regime.\",\n            \"short_title\": \"Verification supports extrapolation\",\n            \"evidence_excerpts\": [\n                \"The predicted, patch and elided fidelities all show good agreement with the fidelities of the corresponding full circuits, despite the vast differences in computational complexity and entanglement.\"\n            ]\n        },\n        {\n            \"text\": \"The demonstrated speedup is specific to random circuit sampling and does not remove the need for fault-tolerant logical qubits for applications such as Shor-style factoring.\",\n            \"short_title\": \"Fault tolerance remains necessary\",\n            \"evidence_excerpts\": [\n                \"Realizing the full promise of quantum computing using Shor'\"'s algorithm for factoring, for example, still requires technical leaps to engineer fault-tolerant logical qubits.\\\"\n            ]\n        }\n    ],\n    \\\"evidence_items\\\": [\n        {\n            \\\"evidence_id\\\": \\\"evidence-sycamore-53-qubit-state-space--a4d91c7e28b3\\\",\n            \\\"title\\\": \\\"53-Qubit State Space\\\",\n            \\\"excerpt\\\": \\\"The extracted article states that programmable superconducting qubits created quantum states on 53 qubits, corresponding to a computational state-space of dimension 2\"'^53, about 10''^16 states.\",\n            \"overview\": \"This evidence establishes the physical and computational scale of the experiment. The 53-qubit state space is central because the claimed classical difficulty depends on width as well as depth; by itself it does not prove speedup, but it defines the regime in which later fidelity and simulation-cost comparisons are evaluated.\",\n            \"evidence_type\": \"measurement\",\n            \"claim_refs\": [\"0\", \"6\"],\n            \"source_id\": source_id,\n            \"page_refs\": [\"p.505\"]\n        },\n        {\n            \"evidence_id\": \"evidence-xeb-fidelity-equation--b73c50e9d2a1\",\n            \"title\": \"Cross-Entropy Fidelity Formula\",\n            \"excerpt\": \"F_XEB = 2''^n <P(x_i)>_i - 1, where P(x_i) is the ideal-circuit probability of each measured bitstring and the average is taken over observed bitstrings.\",\n            \"overview\": \"The equation gives the audit path for the paper'\"'s verification claim. It ties measured samples to ideal probabilities, making fidelity a quantitative statistic rather than a qualitative assertion; its limitation is that ideal probabilities must be classically computed, which becomes infeasible in the largest circuits.\\\",\n            \\\"evidence_type\\\": \\\"equation\\\",\n            \\\"claim_refs\\\": [\\\"2\\\", \\\"3\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Eq.1\\\", \\\"p.506\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-simultaneous-error-table--c6f80ab19e44\\\",\n            \\\"title\\\": \\\"System-Wide Error Rates\\\",\n            \\\"excerpt\\\": \\\"Figure 2 reports average simultaneous-operation errors of single-qubit e1 = 0.16%, two-qubit e2 = 0.62%, two-qubit cycle e2c = 0.93%, and readout er = 3.8%.\\\",\n            \\\"overview\\\": \\\"These tabulated component measurements matter because the supremacy experiment depends on running many gates concurrently without hidden correlated failures overwhelming the circuit. They support the predictive error model, while still showing that readout and two-qubit operations are the dominant fidelity limits.\\\",\n            \\\"evidence_type\\\": \\\"table_result\\\",\n            \\\"claim_refs\\\": [\\\"4\\\", \\\"5\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.2\\\", \\\"p.507\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-large-circuit-fidelity-model--d1ef9253a8c6\\\",\n            \\\"title\\\": \\\"Largest Circuit Fidelity Model\\\",\n            \\\"excerpt\\\": \\\"The largest random circuits have 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and a measurement on each qubit, for which the authors predict total fidelity of 0.2%.\\\",\n            \\\"overview\\\": \\\"This model constraint links component-level calibration to whole-circuit behavior. It shows that the expected fidelity is small but measurable with millions of samples, and it frames the later elided-circuit result as a test of whether independent local errors remain predictive at full scale.\\\",\n            \\\"evidence_type\\\": \\\"model_constraint\\\",\n            \\\"claim_refs\\\": [\\\"4\\\", \\\"5\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"p.507\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-elided-xeb-30-million-samples--e9b4d08f61aa\\\",\n            \\\"title\\\": \\\"Elided-Circuit XEB Result\\\",\n            \\\"excerpt\\\": \\\"For the largest 53-qubit, 20-cycle circuit, N_s = 30 × 10\"'^6 samples over ten instances gave F_XEB = (2.24 ± 0.21) × 10''^-3, implying average fidelity above 0.1% with 5σ confidence.\",\n            \"overview\": \"This statistical result is the strongest direct fidelity evidence near the supremacy regime. Because the full hardest circuits could not be classically verified, the elided result provides a closely related, auditable proxy; the inference depends on the demonstrated correspondence among simplified, patch, elided, and full verification circuits.\",\n            \"evidence_type\": \"statistical_result\",\n            \"claim_refs\": [\"3\", \"7\"],\n            \"source_id\": source_id,\n            \"page_refs\": [\"Fig.4\", \"p.508\"]\n        },\n        {\n            \"evidence_id\": \"evidence-quantum-classical-runtime-gap--f2a6c0d4be77\",\n            \"title\": \"Quantum-Classical Runtime Gap\",\n            \"excerpt\": \"Figure 4 states that one million samples at m = 20 take 200 seconds on Sycamore, while equal-fidelity classical sampling would take 10,000 years on one million cores and fidelity verification would take millions of years.\",\n            \"overview\": \"This evidence supports the headline speedup claim by pairing the quantum sampling runtime with the authors'\"' extrapolated classical cost. The comparison is task-specific and model-dependent: it concerns equal-fidelity random circuit sampling, not arbitrary useful quantum algorithms.\\\",\n            \\\"evidence_type\\\": \\\"statistical_result\\\",\n            \\\"claim_refs\\\": [\\\"1\\\", \\\"6\\\", \\\"8\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.4\\\", \\\"p.508\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-verification-circuit-agreement--ab39e15c7420\\\",\n            \\\"title\\\": \\\"Verification Circuit Agreement\\\",\n            \\\"excerpt\\\": \\\"The predicted, patch and elided fidelities all show good agreement with the fidelities of the corresponding full circuits, despite vast differences in computational complexity and entanglement.\\\",\n            \\\"overview\\\": \\\"This formal comparison matters because direct XEB verification is unavailable for the final hardest circuits. Agreement in tractable regimes justifies using lower-complexity circuit variants as fidelity estimators, while leaving open future improvements in classical simulation methods.\\\",\n            \\\"evidence_type\\\": \\\"figure_result\\\",\n            \\\"claim_refs\\\": [\\\"3\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.4a\\\", \\\"p.508\\\"]\n        }\n    ],\n    \\\"relations\\\": [\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"3\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"The measured elided-circuit fidelity is needed for the equal-fidelity runtime comparison behind the speedup claim.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"4\\\",\n            \\\"dst_claim_ref\\\": \\\"5\\\",\n            \\\"rationale\\\": \\\"Measured simultaneous component errors provide the inputs for predicting whole-circuit fidelity.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"7\\\",\n            \\\"dst_claim_ref\\\": \\\"3\\\",\n            \\\"rationale\\\": \\\"Agreement among verification variants supports extending the elided-circuit fidelity estimate into the harder regime.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"6\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"The exponential classical scaling of random circuits explains why the reported runtime gap grows at the largest width and depth.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"similar\\\",\n            \\\"src_claim_ref\\\": \\\"8\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"Both claims delimit the demonstration as a task-specific milestone rather than a general-purpose fault-tolerant quantum computer.\\\"\n        }\n    ],\n    \\\"summary\\\": \\\"The source reports Google's Sycamore experiment demonstrating task-specific quantum supremacy in random circuit sampling. It combines a 53-qubit programmable superconducting processor, cross-entropy benchmarking, component error modeling, and classical simulation cost estimates to argue that Sycamore performed a sampling task in minutes that would take state-of-the-art classical resources thousands of years at equal fidelity.\\\",\n    \\\"warnings\\\": [\n        {\n            \\\"code\\\": \\\"date_inferred_from_markdown\\\",\n            \\\"message\\\": \\\"Task context supplied date=null, but source.md contains 'Published online: 23 October 2019', so source_date_inference was populated from the markdown.\\\"\n        },\n        {\n            \\\"code\\\": \\\"noisy_reference_extraction\\\",\n            \\\"message\\\": \\\"The source_record reference list contains malformed or noisy extracted entries; claims and evidence were grounded in source_extraction.json and source.md instead.\\\"\n        },\n        {\n            \\\"code\\\": \\\"full_supremacy_data_not_directly_verified\\\",\n            \\\"message\\\": \\\"The hardest full-circuit samples were archived but not directly classically simulated in the source; fidelity support comes from elided and verification-circuit evidence.\\\"\n        }\n    ],\n    \\\"source_dossier\\\": {\n        \\\"summary_short\\\": \\\"This Nature article reports the Sycamore superconducting processor performing random circuit sampling on 53 qubits. The source argues that cross-entropy benchmarking, component error calibration, and classical-cost estimates together place the experiment in a task-specific quantum supremacy regime. Its strongest claim is not general useful quantum computation, but a measured sampling speedup for a carefully chosen benchmark task.\\\",\n        \\\"summary_long\\\": \\\"The article presents a landmark random-circuit sampling experiment using Google's Sycamore superconducting processor. Its central claim is that a programmable 53-qubit device sampled from a distribution generated by pseudo-random quantum circuits in a regime where equal-fidelity classical sampling was estimated to be prohibitively expensive. The source grounds this claim in several layers of evidence. First, it defines a benchmark whose classical difficulty grows with both qubit number and circuit depth because random circuits lack exploitable structure. Second, it uses linear cross-entropy benchmarking to compare measured bitstrings with ideal probabilities wherever classical simulation remains possible. Third, it measures component error rates for single-qubit gates, two-qubit gates, cycles, and readout under simultaneous operation, then uses those rates to predict whole-circuit fidelity. The decisive regime cannot be fully verified by direct classical simulation, so the article relies on patch, elided, and verification circuits to test whether lower-complexity variants track full-circuit behavior. For the largest elided 53-qubit, 20-cycle data set, the reported F_XEB statistic supports fidelity above 0.1% at 5σ confidence. Against this measured fidelity, the authors compare Sycamore's 200-second runtime for one million samples with an extrapolated 10,000-year classical sampling cost on one million cores. The practical interpretation is deliberately narrow: the result demonstrates a super-classical benchmark computation in a noisy intermediate-scale device, not immediate fault-tolerant quantum computing or a broad application such as factoring. Its importance lies in showing that controlled, many-qubit quantum dynamics can be engineered, benchmarked, and made classically inaccessible for a specific task.\\\",\n        \\\"sections\\\": [\n            {\n                \\\"heading\\\": \\\"Central Benchmark Claim\\\",\n                \\\"body\\\": \\\"The source's main proposition is that Sycamore performed random circuit sampling in a classically inaccessible regime. The experiment uses 53 active qubits and deep random circuits to create a state space of about 10\"'^16 possibilities, then asks the processor to sample bitstrings from the resulting distribution rather than solve a practical application directly.\",\n                \"grounding_claim_ids\": [\"0\", \"1\", \"6\"]\n            },\n            {\n                \"heading\": \"Verification Method\",\n                \"body\": \"Cross-entropy benchmarking supplies the quantitative bridge between measured bitstrings and ideal circuit probabilities. In tractable regimes, ideal probabilities can be computed classically and compared with the quantum samples; in the largest regime, the same method becomes too costly, so verification has to be transferred through carefully simplified circuit families.\",\n                \"grounding_claim_ids\": [\"2\", \"3\", \"7\"]\n            },\n            {\n                \"heading\": \"Hardware Error Evidence\",\n                \"body\": \"The processor evidence is not just a headline qubit count. The article reports simultaneous-operation error rates for gates and readout, then uses those rates to predict total circuit fidelity. This matters because the supremacy claim would fail if large-scale simultaneous operation introduced uncontrolled correlated errors not visible in isolated gate calibration.\",\n                \"grounding_claim_ids\": [\"4\", \"5\"]\n            },\n            {\n                \"heading\": \"Supremacy-Regime Inference\",\n                \"body\": \"The hardest full circuits are not directly verified by classical simulation. Instead, the article compares full, patch, elided, and predicted fidelities where verification is possible, then uses elided circuits at 53 qubits and 20 cycles as the closest auditable proxy. The inference is therefore empirical and model-supported rather than a direct full-circuit probability check.\",\n                \"grounding_claim_ids\": [\"3\", \"7\"]\n            },\n            {\n                \"heading\": \"Classical Cost Comparison\",\n                \"body\": \"The dramatic runtime gap depends on matching the quantum task to an equal-fidelity classical sampling estimate. Sycamore'\"'s reported 200 seconds for one million samples is compared with 10,000 years on one million cores, but this is an extrapolated benchmark for random circuit sampling, not evidence that all valuable computations are now faster on quantum hardware.\\\",\n                \\\"grounding_claim_ids\\\": [\\\"1\\\", \\\"6\\\", \\\"8\\\"]\n            },\n            {\n                \\\"heading\\\": \\\"Limits and Interpretation\\\",\n                \\\"body\\\": \\\"The article explicitly separates this NISQ-era milestone from full-scale fault-tolerant quantum computing. It argues that quantum speedup is achievable in a real physical device, while acknowledging that applications such as Shor-style factoring still require logical qubits and major engineering advances beyond the reported noisy processor.\\\",\n                \\\"grounding_claim_ids\\\": [\\\"1\\\", \\\"8\\\"]\n            }\n        ]\n    }\n}\n\noutput_path.parent.mkdir(parents=True, exist_ok=True)\nwith output_path.open('w', encoding='utf-8') as handle:\n    json.dump(data, handle, ensure_ascii=False, indent=2)\n    handle.write('\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\n\noutput_path = Path('/Users/chrgre01/src/Sapi/verification/example_site/spaces/quantum-physics/runs/run-20260426T155454Z--ee4hs1p14s/semantic/ingest_extraction.json')\nsource_id = 'source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8'\n\ndata = {\n    \\\"source_date_inference\\\": {\n        \\\"date\\\": \\\"2019-10-23\\\",\n        \\\"confidence\\\": \\\"high\\\",\n        \\\"origin\\\": \\\"sources/artifacts/source-02-quantum-supremacy-using-a-programmable-superconducting-processor--f98990eb22d8/source.md\\\",\n        \\\"rationale\\\": \\\"The extracted markdown header states 'Published online: 23 October 2019'.\\\"\n    },\n    \\\"source\\\": {\n        \\\"display_title\\\": \\\"Quantum Supremacy Using a Programmable Superconducting Processor\\\",\n        \\\"authors\\\": [\n            \\\"Frank Arute\\\",\n            \\\"Kunal Arya\\\",\n            \\\"Ryan Babbush\\\",\n            \\\"Dave Bacon\\\",\n            \\\"Joseph C. Bardin\\\",\n            \\\"Rami Barends\\\",\n            \\\"Rupak Biswas\\\",\n            \\\"Sergio Boixo\\\",\n            \\\"Fernando G. S. L. Brandao\\\",\n            \\\"David A. Buell\\\",\n            \\\"Brian Burkett\\\",\n            \\\"Yu Chen\\\",\n            \\\"Zijun Chen\\\",\n            \\\"Ben Chiaro\\\",\n            \\\"Roberto Collins\\\",\n            \\\"William Courtney\\\",\n            \\\"Andrew Dunsworth\\\",\n            \\\"Edward Farhi\\\",\n            \\\"Brooks Foxen\\\",\n            \\\"Austin Fowler\\\",\n            \\\"Craig Gidney\\\",\n            \\\"Marissa Giustina\\\",\n            \\\"Rob Graff\\\",\n            \\\"Keith Guerin\\\",\n            \\\"Steve Habegger\\\",\n            \\\"Matthew P. Harrigan\\\",\n            \\\"Michael J. Hartmann\\\",\n            \\\"Alan Ho\\\",\n            \\\"Markus Hoffmann\\\",\n            \\\"Trent Huang\\\",\n            \\\"Travis S. Humble\\\",\n            \\\"Sergei V. Isakov\\\",\n            \\\"Evan Jeffrey\\\",\n            \\\"Zhang Jiang\\\",\n            \\\"Dvir Kafri\\\",\n            \\\"Kostyantyn Kechedzhi\\\",\n            \\\"Julian Kelly\\\",\n            \\\"Paul V. Klimov\\\",\n            \\\"Sergey Knysh\\\",\n            \\\"Alexander Korotkov\\\",\n            \\\"Fedor Kostritsa\\\",\n            \\\"David Landhuis\\\",\n            \\\"Mike Lindmark\\\",\n            \\\"Erik Lucero\\\",\n            \\\"Dmitry Lyakh\\\",\n            \\\"Salvatore Mandrà\\\",\n            \\\"Jarrod R. McClean\\\",\n            \\\"Matthew McEwen\\\",\n            \\\"Anthony Megrant\\\",\n            \\\"Xiao Mi\\\",\n            \\\"Kristel Michielsen\\\",\n            \\\"Masoud Mohseni\\\",\n            \\\"Josh Mutus\\\",\n            \\\"Ofer Naaman\\\",\n            \\\"Matthew Neeley\\\",\n            \\\"Charles Neill\\\",\n            \\\"Murphy Yuezhen Niu\\\",\n            \\\"Eric Ostby\\\",\n            \\\"Andre Petukhov\\\",\n            \\\"John C. Platt\\\",\n            \\\"Chris Quintana\\\",\n            \\\"Eleanor G. Rieffel\\\",\n            \\\"Pedram Roushan\\\",\n            \\\"Nicholas C. Rubin\\\",\n            \\\"Daniel Sank\\\",\n            \\\"Kevin J. Satzinger\\\",\n            \\\"Vadim Smelyanskiy\\\",\n            \\\"Kevin J. Sung\\\",\n            \\\"Matthew D. Trevithick\\\",\n            \\\"Amit Vainsencher\\\",\n            \\\"Benjamin Villalonga\\\",\n            \\\"Theodore White\\\",\n            \\\"Z. Jamie Yao\\\",\n            \\\"Ping Yeh\\\",\n            \\\"Adam Zalcman\\\",\n            \\\"Hartmut Neven\\\",\n            \\\"John M. Martinis\\\"\n        ],\n        \\\"source_id\\\": source_id,\n        \\\"doi\\\": \\\"10.1038/s41586-019-1666-5\\\"\n    },\n    \\\"claims\\\": [\n        {\n            \\\"text\\\": \\\"The Sycamore superconducting processor created random-circuit quantum states on 53 qubits, corresponding to a computational state space of 2\"'^53, about 10''^16 basis states.\",\n            \"short_title\": \"Sycamore reaches 53 qubits\",\n            \"evidence_excerpts\": [\n                \"Here we report the use of a processor with programmable superconducting qubits to create quantum states on 53 qubits, corresponding to a computational state-space of dimension 2''^53 (about 10''^16).\"\n            ]\n        },\n        {\n            \"text\": \"For the hardest reported random-circuit sampling task, Sycamore produced one million samples in about 200 seconds while the authors estimated equal-fidelity classical sampling would take about 10,000 years on one million cores.\",\n            \"short_title\": \"Quantum sampling outpaces classical\",\n            \"evidence_excerpts\": [\n                \"For m = 20, obtaining a million samples on the quantum processor takes 200 seconds, whereas an equal-fidelity classical sampling would take 10,000 years on a million cores.\"\n            ]\n        },\n        {\n            \"text\": \"Linear cross-entropy benchmarking provides a fidelity measure by comparing experimentally observed bitstrings with ideal probabilities computed by classical simulation.\",\n            \"short_title\": \"XEB measures circuit fidelity\",\n            \"evidence_excerpts\": [\n                \"F_XEB = 2''^n <P(x_i)>_i - 1, where n is the number of qubits, P(x_i) is the probability of bitstring x_i computed for the ideal quantum circuit, and the average is over the observed bitstrings.\"\n            ]\n        },\n        {\n            \"text\": \"The largest elided 53-qubit, 20-cycle circuits yielded F_XEB = (2.24 ± 0.21) × 10''^-3 over 30 million samples, supporting an average fidelity above 0.1% with 5σ confidence.\",\n            \"short_title\": \"Elided circuits retain fidelity\",\n            \"evidence_excerpts\": [\n                \"For the largest circuit with 53 qubits and 20 cycles, we collected N_s = 30 × 10''^6 samples over ten circuit instances, obtaining F_XEB = (2.24 ±0.21) × 10''^-3 for the elided circuits. With 5σ confidence, we assert that the average fidelity of running these circuits on the quantum processor is greater than at least 0.1%.\"\n            ]\n        },\n        {\n            \"text\": \"Measured component error rates under simultaneous operation were low enough to support a model predicting measurable fidelity for full random circuits.\",\n            \"short_title\": \"Gate errors predict fidelity\",\n            \"evidence_excerpts\": [\n                \"Average error values under simultaneous operation were single-qubit e1 = 0.16%, two-qubit e2 = 0.62%, two-qubit cycle e2c = 0.93%, and readout er = 3.8%.\"\n            ]\n        },\n        {\n            \"text\": \"The largest random circuits combined 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and one measurement per qubit, for which the authors predicted a total fidelity of 0.2%.\",\n            \"short_title\": \"Large circuits remain measurable\",\n            \"evidence_excerpts\": [\n                \"Our largest random quantum circuits have 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and a measurement on each qubit, for which we predict a total fidelity of 0.2%.\"\n            ]\n        },\n        {\n            \"text\": \"Random quantum circuits become exponentially harder to simulate classically as qubit count and circuit depth increase because their output distributions lack exploitable structure.\",\n            \"short_title\": \"Random circuits scale exponentially\",\n            \"evidence_excerpts\": [\n                \"Random circuits are a suitable choice for benchmarking because they do not possess structure and therefore allow for limited guarantees of computational hardness. Classically computing this probability distribution becomes exponentially more difficult as the number of qubits and number of gate cycles grow.\"\n            ]\n        },\n        {\n            \"text\": \"Agreement among full, patch, elided, and predicted fidelities on classically verifiable circuits supports using elided circuits to estimate fidelity in the supremacy regime.\",\n            \"short_title\": \"Verification supports extrapolation\",\n            \"evidence_excerpts\": [\n                \"The predicted, patch and elided fidelities all show good agreement with the fidelities of the corresponding full circuits, despite the vast differences in computational complexity and entanglement.\"\n            ]\n        },\n        {\n            \"text\": \"The demonstrated speedup is specific to random circuit sampling and does not remove the need for fault-tolerant logical qubits for applications such as Shor-style factoring.\",\n            \"short_title\": \"Fault tolerance remains necessary\",\n            \"evidence_excerpts\": [\n                \"Realizing the full promise of quantum computing using Shor'\"'s algorithm for factoring, for example, still requires technical leaps to engineer fault-tolerant logical qubits.\\\"\n            ]\n        }\n    ],\n    \\\"evidence_items\\\": [\n        {\n            \\\"evidence_id\\\": \\\"evidence-sycamore-53-qubit-state-space--a4d91c7e28b3\\\",\n            \\\"title\\\": \\\"53-Qubit State Space\\\",\n            \\\"excerpt\\\": \\\"The extracted article states that programmable superconducting qubits created quantum states on 53 qubits, corresponding to a computational state-space of dimension 2\"'^53, about 10''^16 states.\",\n            \"overview\": \"This evidence establishes the physical and computational scale of the experiment. The 53-qubit state space is central because the claimed classical difficulty depends on width as well as depth; by itself it does not prove speedup, but it defines the regime in which later fidelity and simulation-cost comparisons are evaluated.\",\n            \"evidence_type\": \"measurement\",\n            \"claim_refs\": [\"0\", \"6\"],\n            \"source_id\": source_id,\n            \"page_refs\": [\"p.505\"]\n        },\n        {\n            \"evidence_id\": \"evidence-xeb-fidelity-equation--b73c50e9d2a1\",\n            \"title\": \"Cross-Entropy Fidelity Formula\",\n            \"excerpt\": \"F_XEB = 2''^n <P(x_i)>_i - 1, where P(x_i) is the ideal-circuit probability of each measured bitstring and the average is taken over observed bitstrings.\",\n            \"overview\": \"The equation gives the audit path for the paper'\"'s verification claim. It ties measured samples to ideal probabilities, making fidelity a quantitative statistic rather than a qualitative assertion; its limitation is that ideal probabilities must be classically computed, which becomes infeasible in the largest circuits.\\\",\n            \\\"evidence_type\\\": \\\"equation\\\",\n            \\\"claim_refs\\\": [\\\"2\\\", \\\"3\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Eq.1\\\", \\\"p.506\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-simultaneous-error-table--c6f80ab19e44\\\",\n            \\\"title\\\": \\\"System-Wide Error Rates\\\",\n            \\\"excerpt\\\": \\\"Figure 2 reports average simultaneous-operation errors of single-qubit e1 = 0.16%, two-qubit e2 = 0.62%, two-qubit cycle e2c = 0.93%, and readout er = 3.8%.\\\",\n            \\\"overview\\\": \\\"These tabulated component measurements matter because the supremacy experiment depends on running many gates concurrently without hidden correlated failures overwhelming the circuit. They support the predictive error model, while still showing that readout and two-qubit operations are the dominant fidelity limits.\\\",\n            \\\"evidence_type\\\": \\\"table_result\\\",\n            \\\"claim_refs\\\": [\\\"4\\\", \\\"5\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.2\\\", \\\"p.507\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-large-circuit-fidelity-model--d1ef9253a8c6\\\",\n            \\\"title\\\": \\\"Largest Circuit Fidelity Model\\\",\n            \\\"excerpt\\\": \\\"The largest random circuits have 53 qubits, 1,113 single-qubit gates, 430 two-qubit gates, and a measurement on each qubit, for which the authors predict total fidelity of 0.2%.\\\",\n            \\\"overview\\\": \\\"This model constraint links component-level calibration to whole-circuit behavior. It shows that the expected fidelity is small but measurable with millions of samples, and it frames the later elided-circuit result as a test of whether independent local errors remain predictive at full scale.\\\",\n            \\\"evidence_type\\\": \\\"model_constraint\\\",\n            \\\"claim_refs\\\": [\\\"4\\\", \\\"5\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"p.507\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-elided-xeb-30-million-samples--e9b4d08f61aa\\\",\n            \\\"title\\\": \\\"Elided-Circuit XEB Result\\\",\n            \\\"excerpt\\\": \\\"For the largest 53-qubit, 20-cycle circuit, N_s = 30 × 10\"'^6 samples over ten instances gave F_XEB = (2.24 ± 0.21) × 10''^-3, implying average fidelity above 0.1% with 5σ confidence.\",\n            \"overview\": \"This statistical result is the strongest direct fidelity evidence near the supremacy regime. Because the full hardest circuits could not be classically verified, the elided result provides a closely related, auditable proxy; the inference depends on the demonstrated correspondence among simplified, patch, elided, and full verification circuits.\",\n            \"evidence_type\": \"statistical_result\",\n            \"claim_refs\": [\"3\", \"7\"],\n            \"source_id\": source_id,\n            \"page_refs\": [\"Fig.4\", \"p.508\"]\n        },\n        {\n            \"evidence_id\": \"evidence-quantum-classical-runtime-gap--f2a6c0d4be77\",\n            \"title\": \"Quantum-Classical Runtime Gap\",\n            \"excerpt\": \"Figure 4 states that one million samples at m = 20 take 200 seconds on Sycamore, while equal-fidelity classical sampling would take 10,000 years on one million cores and fidelity verification would take millions of years.\",\n            \"overview\": \"This evidence supports the headline speedup claim by pairing the quantum sampling runtime with the authors'\"' extrapolated classical cost. The comparison is task-specific and model-dependent: it concerns equal-fidelity random circuit sampling, not arbitrary useful quantum algorithms.\\\",\n            \\\"evidence_type\\\": \\\"statistical_result\\\",\n            \\\"claim_refs\\\": [\\\"1\\\", \\\"6\\\", \\\"8\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.4\\\", \\\"p.508\\\"]\n        },\n        {\n            \\\"evidence_id\\\": \\\"evidence-verification-circuit-agreement--ab39e15c7420\\\",\n            \\\"title\\\": \\\"Verification Circuit Agreement\\\",\n            \\\"excerpt\\\": \\\"The predicted, patch and elided fidelities all show good agreement with the fidelities of the corresponding full circuits, despite vast differences in computational complexity and entanglement.\\\",\n            \\\"overview\\\": \\\"This formal comparison matters because direct XEB verification is unavailable for the final hardest circuits. Agreement in tractable regimes justifies using lower-complexity circuit variants as fidelity estimators, while leaving open future improvements in classical simulation methods.\\\",\n            \\\"evidence_type\\\": \\\"figure_result\\\",\n            \\\"claim_refs\\\": [\\\"3\\\", \\\"7\\\"],\n            \\\"source_id\\\": source_id,\n            \\\"page_refs\\\": [\\\"Fig.4a\\\", \\\"p.508\\\"]\n        }\n    ],\n    \\\"relations\\\": [\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"3\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"The measured elided-circuit fidelity is needed for the equal-fidelity runtime comparison behind the speedup claim.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"4\\\",\n            \\\"dst_claim_ref\\\": \\\"5\\\",\n            \\\"rationale\\\": \\\"Measured simultaneous component errors provide the inputs for predicting whole-circuit fidelity.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"7\\\",\n            \\\"dst_claim_ref\\\": \\\"3\\\",\n            \\\"rationale\\\": \\\"Agreement among verification variants supports extending the elided-circuit fidelity estimate into the harder regime.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"supports\\\",\n            \\\"src_claim_ref\\\": \\\"6\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"The exponential classical scaling of random circuits explains why the reported runtime gap grows at the largest width and depth.\\\"\n        },\n        {\n            \\\"relation_type\\\": \\\"similar\\\",\n            \\\"src_claim_ref\\\": \\\"8\\\",\n            \\\"dst_claim_ref\\\": \\\"1\\\",\n            \\\"rationale\\\": \\\"Both claims delimit the demonstration as a task-specific milestone rather than a general-purpose fault-tolerant quantum computer.\\\"\n        }\n    ],\n    \\\"summary\\\": \\\"The source reports Google's Sycamore experiment demonstrating task-specific quantum supremacy in random circuit sampling. It combines a 53-qubit programmable superconducting processor, cross-entropy benchmarking, component error modeling, and classical simulation cost estimates to argue that Sycamore performed a sampling task in minutes that would take state-of-the-art classical resources thousands of years at equal fidelity.\\\",\n    \\\"warnings\\\": [\n        {\n            \\\"code\\\": \\\"date_inferred_from_markdown\\\",\n            \\\"message\\\": \\\"Task context supplied date=null, but source.md contains 'Published online: 23 October 2019', so source_date_inference was populated from the markdown.\\\"\n        },\n        {\n            \\\"code\\\": \\\"noisy_reference_extraction\\\",\n            \\\"message\\\": \\\"The source_record reference list contains malformed or noisy extracted entries; claims and evidence were grounded in source_extraction.json and source.md instead.\\\"\n        },\n        {\n            \\\"code\\\": \\\"full_supremacy_data_not_directly_verified\\\",\n            \\\"message\\\": \\\"The hardest full-circuit samples were archived but not directly classically simulated in the source; fidelity support comes from elided and verification-circuit evidence.\\\"\n        }\n    ],\n    \\\"source_dossier\\\": {\n        \\\"summary_short\\\": \\\"This Nature article reports the Sycamore superconducting processor performing random circuit sampling on 53 qubits. The source argues that cross-entropy benchmarking, component error calibration, and classical-cost estimates together place the experiment in a task-specific quantum supremacy regime. Its strongest claim is not general useful quantum computation, but a measured sampling speedup for a carefully chosen benchmark task.\\\",\n        \\\"summary_long\\\": \\\"The article presents a landmark random-circuit sampling experiment using Google's Sycamore superconducting processor. Its central claim is that a programmable 53-qubit device sampled from a distribution generated by pseudo-random quantum circuits in a regime where equal-fidelity classical sampling was estimated to be prohibitively expensive. The source grounds this claim in several layers of evidence. First, it defines a benchmark whose classical difficulty grows with both qubit number and circuit depth because random circuits lack exploitable structure. Second, it uses linear cross-entropy benchmarking to compare measured bitstrings with ideal probabilities wherever classical simulation remains possible. Third, it measures component error rates for single-qubit gates, two-qubit gates, cycles, and readout under simultaneous operation, then uses those rates to predict whole-circuit fidelity. The decisive regime cannot be fully verified by direct classical simulation, so the article relies on patch, elided, and verification circuits to test whether lower-complexity variants track full-circuit behavior. For the largest elided 53-qubit, 20-cycle data set, the reported F_XEB statistic supports fidelity above 0.1% at 5σ confidence. Against this measured fidelity, the authors compare Sycamore's 200-second runtime for one million samples with an extrapolated 10,000-year classical sampling cost on one million cores. The practical interpretation is deliberately narrow: the result demonstrates a super-classical benchmark computation in a noisy intermediate-scale device, not immediate fault-tolerant quantum computing or a broad application such as factoring. Its importance lies in showing that controlled, many-qubit quantum dynamics can be engineered, benchmarked, and made classically inaccessible for a specific task.\\\",\n        \\\"sections\\\": [\n            {\n                \\\"heading\\\": \\\"Central Benchmark Claim\\\",\n                \\\"body\\\": \\\"The source's main proposition is that Sycamore performed random circuit sampling in a classically inaccessible regime. The experiment uses 53 active qubits and deep random circuits to create a state space of about 10\"'^16 possibilities, then asks the processor to sample bitstrings from the resulting distribution rather than solve a practical application directly.\",\n                \"grounding_claim_ids\": [\"0\", \"1\", \"6\"]\n            },\n            {\n                \"heading\": \"Verification Method\",\n                \"body\": \"Cross-entropy benchmarking supplies the quantitative bridge between measured bitstrings and ideal circuit probabilities. In tractable regimes, ideal probabilities can be computed classically and compared with the quantum samples; in the largest regime, the same method becomes too costly, so verification has to be transferred through carefully simplified circuit families.\",\n                \"grounding_claim_ids\": [\"2\", \"3\", \"7\"]\n            },\n            {\n                \"heading\": \"Hardware Error Evidence\",\n                \"body\": \"The processor evidence is not just a headline qubit count. The article reports simultaneous-operation error rates for gates and readout, then uses those rates to predict total circuit fidelity. This matters because the supremacy claim would fail if large-scale simultaneous operation introduced uncontrolled correlated errors not visible in isolated gate calibration.\",\n                \"grounding_claim_ids\": [\"4\", \"5\"]\n            },\n            {\n                \"heading\": \"Supremacy-Regime Inference\",\n                \"body\": \"The hardest full circuits are not directly verified by classical simulation. Instead, the article compares full, patch, elided, and predicted fidelities where verification is possible, then uses elided circuits at 53 qubits and 20 cycles as the closest auditable proxy. The inference is therefore empirical and model-supported rather than a direct full-circuit probability check.\",\n                \"grounding_claim_ids\": [\"3\", \"7\"]\n            },\n            {\n                \"heading\": \"Classical Cost Comparison\",\n                \"body\": \"The dramatic runtime gap depends on matching the quantum task to an equal-fidelity classical sampling estimate. Sycamore'\"'s reported 200 seconds for one million samples is compared with 10,000 years on one million cores, but this is an extrapolated benchmark for random circuit sampling, not evidence that all valuable computations are now faster on quantum hardware.\\\",\n                \\\"grounding_claim_ids\\\": [\\\"1\\\", \\\"6\\\", \\\"8\\\"]\n            },\n            {\n                \\\"heading\\\": \\\"Limits and Interpretation\\\",\n                \\\"body\\\": \\\"The article explicitly separates this NISQ-era milestone from full-scale fault-tolerant quantum computing. It argues that quantum speedup is achievable in a real physical device, while acknowledging that applications such as Shor-style factoring still require logical qubits and major engineering advances beyond the reported noisy processor.\\\",\n                \\\"grounding_claim_ids\\\": [\\\"1\\\", \\\"8\\\"]\n            }\n        ]\n    }\n}\n\noutput_path.parent.mkdir(parents=True, exist_ok=True)\nwith output_path.open('w', encoding='utf-8') as handle:\n    json.dump(data, handle, ensure_ascii=False, indent=2)\n    handle.write('\\\\n')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
