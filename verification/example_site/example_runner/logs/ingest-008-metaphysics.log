verification/example_site/spaces/metaphysics/claims/claim-grounding-does-not-entail-being-more-fundamental-than-so-appeals-to-relative-fun--0468a01c8a45.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-is-not-a-strict-order-because-it-is-neither-transitive-irreflexive-nor--0dc6a102d51b.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-grounding-necessity-is-not-secured-merely-by-treating-grounding-as-a-determinati--23325d0a6e99.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-if-a-fact-p-is-fully-grounded-in-a-plurality-of-facts-d-then-the-conjunction-of--dbb969101dbd.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-paradigm-grounding-cases-support-the-significance-principle-because-their-connec--28555377f52b.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-schaffer-s-contrastive-or-differential-formulation-of-grounding-still-fails-to-m--7fd859e88bdc.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-schaffer-s-set-based-counterexample-does-not-establish-grounding-non-transitivit--49174a1f51f7.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-the-conjunction-of-the-significance-principle-the-essence-principle-and-the-meta--4f212a9f1869.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-the-epistemic-constraint-on-grounding-does-not-undermine-grounding-objectivity-b--87922d9890f9.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-truthmaking-and-alethic-fact-grounding-are-non-asymmetric-because-distinct-propo--9d116dfbb4b5.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-truthmaking-is-a-species-of-grounding-because-the-relation-between-a-truthmaker--4d84e79d3baf.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-truthmaking-is-non-irreflexive-because-a-proposition-of-the-form-e-exists-is-mad--d4aca38737b4.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/claims/claim-truthmaking-is-non-transitive-socrates-being-white-truthmakes-the-proposition-th--3fbb8a3c9b9d.json\n--- relations files ---\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-14833df26d3af3df2179637f4f8a9004b4d2c8b59184695970bbb8175af48a4b.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-1887e471d0c6bca41ab4d303b82973be0280997bb7312352e6ded8b488e7839c.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-36ef724159190a46cace6a927af6cbdafcf4fe73fd0aad36094fa6956d97b569.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-64140bcb5a4e30ab2c5491abfb14611c14f337a33058a66b5b7cc01932803f34.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-79e0c8d5f111557dd929758b02485f6e61fd9cc9fae0a8ed83822ae8b8fb09d4.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-8e5aba11a9eae1c477e65715f38cb35eeee6a9fab1ff413f1c324cb20b0e093d.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-90cc659ab02d83f477c7c7a02f365b79e7ddedc7a9ffa998606fdf782eabf6b6.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-957366ee9951a19ce9186176a2ee739da5516eab0b7fd08b17a0356e9548051e.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-cc07ba6489d4d2427e186d2ac1b38fcd9ea744a43ee690e9028f75f55309fc96.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-ce4b5bf87c2a7b9e4f6f1214655f6481ac78f22972477510a6912dee161f07d2.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-d320fa93571942b877ed906822139f1808dca9a7281b397a8db9751a399943be.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/relations/rel-fae0542d4f5bb8fc520b8c849f3505f240f95eedd61b7b37da9996e8569f0945.json\n","exit_code":0,"status":"completed"}}
