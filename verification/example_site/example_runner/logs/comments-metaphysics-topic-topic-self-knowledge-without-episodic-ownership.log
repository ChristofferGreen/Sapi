-necessary-or-contingent--6e8195a096f0/source.pdf\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/front_page.png\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-01-grounding-necessary-or-contingent--6e8195a096f0/source.md\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source_provenance.md\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source_extraction.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source.pdf\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/front_page.png\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/metaphysics/sources/artifacts/source-05-memory-and-the-sense-of-personal-identity--a1fbe0966ca4/source.md\n","exit_code":0,"status":"completed"}}
