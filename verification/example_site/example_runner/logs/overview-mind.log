{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"set -euo pipefail\nprintf 'context.json:\\\\n'\nsed -n '1,220p' /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/outputs/space_overview/subspace--mind/context.json\nprintf '\\\\nsource records:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records -maxdepth 2 -type f | sort\nprintf '\\\\nclaims:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/claims -maxdepth 2 -type f | sort\nprintf '\\\\nrelations:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/relations -maxdepth 2 -type f | sort\nprintf '\\\\ntopics:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/topics -maxdepth 2 -type f | sort\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"set -euo pipefail\nprintf 'context.json:\\\\n'\nsed -n '1,220p' /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/outputs/space_overview/subspace--mind/context.json\nprintf '\\\\nsource records:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records -maxdepth 2 -type f | sort\nprintf '\\\\nclaims:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/claims -maxdepth 2 -type f | sort\nprintf '\\\\nrelations:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/relations -maxdepth 2 -type f | sort\nprintf '\\\\ntopics:\\\\n'\nfind /Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/topics -maxdepth 2 -type f | sort\"","aggregated_output":"context.json:\n{\n  \"claims\": [\n    {\n      \"added_at\": \"2026-04-26T11:09:33Z\",\n      \"claim_id\": \"claim-a-1-month-intensive-mindfulness-retreat-among-previously-experienced-meditators--cd2a814c579a\",\n      \"evidence_excerpts\": [\n        \"At Time 2, the alerting difference score was significantly smaller for the retreat group than for the combined control and MBSR groups, and no-cue response times were significantly shorter in the younger retreat subgroup.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Retreat improves alerting\",\n      \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\",\n      \"text\": \"A 1-month intensive mindfulness retreat among previously experienced meditators improves exogenous alerting-related detection when no target cue is provided.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-a-complex-is-an-integrated-subset-with-greater-than-zero-that-is-not-contained-i--70401a6fb458\",\n      \"evidence_excerpts\": [\n        \"A complex is a subset S having \\u03a6>0 that is not included within a larger subset having higher \\u03a6.\",\n        \"To the extent that consciousness corresponds to the capacity to integrate information, complexes are the \\u201csubjects\\u201d of experience, being the locus where information can be integrated.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Complexes are experiential subjects\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"A complex is an integrated subset with \\u03a6 greater than zero that is not contained in a larger subset with higher \\u03a6, and complexes are the loci of subjective experience.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-a-distributed-thalamocortical-network-is-well-suited-to-generate-consciousness-b--571db463385d\",\n      \"evidence_excerpts\": [\n        \"The thalamocortical system is organized in a way that appears to emphasize at once both functional specialization and functional integration.\",\n        \"Connection matrices yielding the highest values of information integration (\\u03a6 = 74 bits) share two key characteristics: connection patterns are different for different elements, and all elements can be reached from all other elements.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Thalamocortical networks maximize Phi\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"A distributed thalamocortical network is well suited to generate consciousness because it combines functional specialization with functional integration.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T14:49:12Z\",\n      \"claim_id\": \"claim-adverse-effects-are-undermeasured--25fa20260426\",\n      \"evidence_excerpts\": [\n        \"Meditation-related experiences serious or distressing enough to warrant additional treatment or medical attention have been reported in more than 20 published case reports or observational studies.\",\n        \"Compared to 100% of pharmacology trials, less than 25% of meditation trials actively assess adverse events, relying instead on spontaneous reporting.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Adverse effects are undermeasured\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Meditation-related adverse effects and opportunity costs are plausible, documented, and undermeasured, so safety claims based on passive reporting or absent evidence are unwarranted.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:33:52Z\",\n      \"claim_id\": \"claim-adverse-event-assessment-in-meditation-research-needs-active-monitoring-rigorous--ae38800857f2\",\n      \"evidence_excerpts\": [\n        \"Most current methods for assessing adverse effects in meditation-related research are insufficient to produce an accurate estimate; some MBI researchers have started to actively monitor adverse events through questionnaires or clinician interviews.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Adverse events need monitoring\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Adverse-event assessment in meditation research needs active monitoring, rigorous trial designs, and clinical interviews rather than passive safety assumptions.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:22:12Z\",\n      \"claim_id\": \"claim-alpha-band-oscillations-can-be-actively-invoked-in-cortical-regions-that-process--09466b39d396\",\n      \"evidence_excerpts\": [\n        \"The review states that alpha-band oscillations can be actively invoked in cortical regions across multiple sensory systems when those regions process irrelevant or distracting information.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Alpha suppresses distractors\",\n      \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\",\n      \"text\": \"Alpha-band oscillations can be actively invoked in cortical regions that process irrelevant or distracting information, making alpha a mechanism of attentional suppression.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:22:12Z\",\n      \"claim_id\": \"claim-alpha-mediated-biasing-extends-beyond-vision-appearing-in-auditory-and-tactile-s--2cd546facc83\",\n      \"evidence_excerpts\": [\n        \"Auditory spatial attention studies found alpha-band increases over parietal cortex ipsilateral to the cued direction, and tactile studies found increases over somatosensory cortex ipsilateral to the cued direction.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Alpha bias spans senses\",\n      \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\",\n      \"text\": \"Alpha-mediated biasing extends beyond vision, appearing in auditory and tactile spatial attention with increases over cortical regions ipsilateral to the cued direction.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:09:33Z\",\n      \"claim_id\": \"claim-an-8-week-mindfulness-based-stress-reduction-course-improves-endogenous-orientin--f7bde69b7431\",\n      \"evidence_excerpts\": [\n        \"An ANOVA for the RT difference scores of the orienting component revealed a significant factor of group [F(2,48) = 10.13, p < .001]. A series of contrasts revealed that the MBSR group differed from the control group and the retreat group.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"MBSR improves orienting\",\n      \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\",\n      \"text\": \"An 8-week mindfulness-based stress reduction course improves endogenous orienting relative to control and retreat groups at post-training testing.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-anatomical-or-functional-disconnection-within-thalamocortical-systems-can-reduce--89adceb072c5\",\n      \"evidence_excerpts\": [\n        \"If the \\u201ccallosum-like\\u201d connections are removed, the main complex breaks down into two smaller complexes, each of which still has a high value of \\u03a6.\",\n        \"If the \\u201cauditory\\u201d module is functionally disconnected from the rest, the main complex includes just the \\u201csupramodal\\u201d and \\u201cvisual\\u201d modules.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Disconnection reduces conscious level\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"Anatomical or functional disconnection within thalamocortical systems can reduce, split, or selectively alter consciousness by changing the system\\u2019s integrated-information structure.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:22:12Z\",\n      \"claim_id\": \"claim-attention-related-alpha-modulation-appears-primarily-controlled-by-cortico-corti--1eb91088cf2b\",\n      \"evidence_excerpts\": [\n        \"The conclusion contrasts attention-related alpha modulations, described as mainly cortico-cortical and involving frontal and parietal regions, with arousal-related alpha that is more likely thalamus-dominated.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Cortical networks control alpha\",\n      \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\",\n      \"text\": \"Attention-related alpha modulation appears primarily controlled by cortico-cortical frontal and parietal networks, with thalamo-cortical connections possibly contributing secondarily.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T14:58:46Z\",\n      \"claim_id\": \"claim-biased-narrative-self-processing-can-reify-dysfunctional-self-schemas-through-af--544c2f60e4c0\",\n      \"evidence_excerpts\": [\n        \"The model of a psychopathological self-schema is depicted in Figure 1 in which habitual negative beliefs about the self (including their personal world and future), become reified through the continuous reinforcement of a feedback loop of affect-biased attention influencing subjective and behavioral symptoms and vice-versa.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Narrative bias reifies schemas\",\n      \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\",\n      \"text\": \"Biased narrative self-processing can reify dysfunctional self-schemas through affect-biased attention, rumination, and repeated maladaptive interpretation.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T14:49:12Z\",\n      \"claim_id\": \"claim-clinical-evidence-remains-preliminary--117717456958\",\n      \"evidence_excerpts\": [\n        \"Dimidjian and Segal estimate that only 30% of research using mindfulness-based interventions has moved beyond Stage 1; 20% was Stage 2a, 9% Stage 2b, and only 1% outside research contexts.\",\n        \"MBIs compared to active controls were found to have a mixture of only moderate, low, or no efficacy, depending on the disorder being treated.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Clinical evidence remains preliminary\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Clinical evidence for mindfulness-based interventions remains preliminary because much intervention research has not advanced beyond early-stage efficacy designs and often lacks active controls or real-world practice tests.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T13:44:42Z\",\n      \"claim_id\": \"claim-common-mindfulness-questionnaires-operationalize-different-facets-of-mindfulness--19920139d48a\",\n      \"evidence_excerpts\": [\n        \"Table 1 lists mindfulness measures with different contexts and factors, including FMI as general, MAAS as attentiveness and awareness, KIMS as observing/describing/awareness/acceptance, FFMQ as nonreactivity/observing/awareness/describing/nonjudging, and TMS as curiosity/decentering.\",\n        \"Self-report measures often highlight attention, awareness, and acceptance or nonjudgment rather than discernment.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Measures capture different facets\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Common mindfulness questionnaires operationalize different facets of mindfulness, so comparisons across studies require scrutiny of exactly which construct each measure captures.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-consciousness-corresponds-to-a-system-s-capacity-to-integrate-information-becaus--ca44bbf79dcb\",\n      \"evidence_excerpts\": [\n        \"The theory presented here claims that consciousness has to do with the capacity to integrate information.\",\n        \"Phenomenological analysis indicates that consciousness has to do with the ability to integrate a large amount of information.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Consciousness integrates information\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"Consciousness corresponds to a system\\u2019s capacity to integrate information, because conscious experience is both highly differentiated and unified.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-consciousness-is-graded-rather-than-all-or-none-and-could-in-principle-exist-in--76ebdb9cb6bc\",\n      \"evidence_excerpts\": [\n        \"Consciousness is not an all-or-none property, but it is graded: to varying degrees, it should exist in most natural and artificial systems.\",\n        \"It should be possible to construct conscious artifacts by endowing them with a complex of high \\u03a6.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"High Phi enables artifacts\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"Consciousness is graded rather than all-or-none and could in principle exist in infants, animals, or artificial systems when they possess complexes with sufficiently high \\u03a6.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T13:44:42Z\",\n      \"claim_id\": \"claim-contemplative-neuroscience-findings-about-mindfulness-are-vulnerable-to-oversimp--944ad1b9ad23\",\n      \"evidence_excerpts\": [\n        \"Representative pictures from fMRI and other neuroimaging methods do not clearly convey the complex chain of biological and computational steps behind inferences about brain structure and function, nor that such inferences are frequently derived from group averages.\",\n        \"Many neuroimaging studies have used cross-sectional designs, precluding possible inferences about underlying cause-and-effect relationships, and physical artifacts involving head movements and cardiorespiratory effects are especially notable.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Neuroimaging evidence is limited\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Contemplative neuroscience findings about mindfulness are vulnerable to oversimplified public interpretation, group-level averaging, cross-sectional confounds, movement and cardiorespiratory artifacts, and uncertain practical significance.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:22:12Z\",\n      \"claim_id\": \"claim-during-visual-spatial-attention-alpha-band-power-increases-over-occipital-cortex--09a99b87f400\",\n      \"evidence_excerpts\": [\n        \"Figure 2 reports a sustained divergence beginning at about 500 ms, with alpha-band TSE amplitudes larger over occipital cortex ipsilateral to the direction of attention.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Spatial alpha targets distractors\",\n      \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\",\n      \"text\": \"During visual spatial attention, alpha-band power increases over occipital cortex ipsilateral to the attended side and retinotopically targets areas likely to receive distracters.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:02:43Z\",\n      \"claim_id\": \"claim-each-particular-conscious-experience-is-specified-by-the-current-activity-values--ef679659733b\",\n      \"evidence_excerpts\": [\n        \"Each conscious state is defined by the set of all its coordinates, which are given by the activity values of all elements of a complex.\",\n        \"Each particular conscious experience is specified by the value, at any given time, of the variables mediating informational interactions among the elements of a complex.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Current states specify experiences\",\n      \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\",\n      \"text\": \"Each particular conscious experience is specified by the current activity values of the variables that mediate informational interactions within a complex.\"\n    },\n    {\n      \"added_at\": \"2026-04-26T11:33:52Z\",\n      \"claim_id\": \"claim-existing-mindfulness-self-report-measures-have-unresolved-construct-validity-lim--65891880856d\",\n      \"evidence_excerpts\": [\n        \"Although some self-report questionnaire measures of mindfulness seem to be effective in revealing particular mental and physical changes associated with practicing mindfulness, how closely these measures track exactly what is taught during practice remains unclear.\"\n      ],\n      \"schema_version\": \"claim_record_v1\",\n      \"short_title\": \"Self reports remain uncertain\",\n      \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\",\n      \"text\": \"Existing mindfulness self-report measures have unresolved construct-validity limits and may not track exactly what practice teaches.\"\n\nsource records:\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records/source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records/source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records/source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9.json\n/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind/sources/records/source-04-mind-the-hype-a-critical