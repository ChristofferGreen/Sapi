{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, os, glob\nbase='/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind'\nctx_path=f'{base}/outputs/space_overview/subspace--mind/context.json'\nwith open(ctx_path, encoding='utf-8') as f: ctx=json.load(f)\nprint('CTX KEYS', sorted(ctx.keys()))\nfor k in ['overview_id','scope_kind','space_name','scope_name','source_record_count','claim_count','relation_count','topic_count']:\n    if k in ctx: print(k, ctx[k])\nprint('\\\\nSOURCES IN CTX')\nfor s in ctx.get('sources', ctx.get('source_records', [])):\n    print(json.dumps({k:s.get(k) for k in ['source_id','title','short_title','authors','year','locator','source_type','summary'] if k in s}, ensure_ascii=False))\nprint('\\\\nSOURCE RECORD FILES')\nfor p in sorted(glob.glob(f'{base}/sources/records/*.json')):\n    with open(p, encoding='utf-8') as f: s=json.load(f)\n    print(json.dumps({k:s.get(k) for k in ['source_id','title','short_title','authors','year','venue','doi','url','summary'] if k in s}, ensure_ascii=False))\nprint('\\\\nTOPICS')\nfor p in sorted(glob.glob(f'{base}/topics/*.json')):\n    with open(p, encoding='utf-8') as f: t=json.load(f)\n    print(json.dumps({k:t.get(k) for k in ['topic_id','name','title','summary','claim_ids','source_ids'] if k in t}, ensure_ascii=False))\nprint('\\\\nCLAIMS')\nclaims=ctx.get('claims') or []\nfor c in claims:\n    print(json.dumps({k:c.get(k) for k in ['claim_id','short_title','source_id','text','evidence_excerpts'] if k in c}, ensure_ascii=False))\nprint('\\\\nRELATIONS')\nfor p in sorted(glob.glob(f'{base}/relations/*.json')):\n    with open(p, encoding='utf-8') as f: r=json.load(f)\n    print(json.dumps(r, ensure_ascii=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, os, glob\nbase='/Users/chrgre01/src/Sapi/verification/example_site/spaces/mind'\nctx_path=f'{base}/outputs/space_overview/subspace--mind/context.json'\nwith open(ctx_path, encoding='utf-8') as f: ctx=json.load(f)\nprint('CTX KEYS', sorted(ctx.keys()))\nfor k in ['overview_id','scope_kind','space_name','scope_name','source_record_count','claim_count','relation_count','topic_count']:\n    if k in ctx: print(k, ctx[k])\nprint('\\\\nSOURCES IN CTX')\nfor s in ctx.get('sources', ctx.get('source_records', [])):\n    print(json.dumps({k:s.get(k) for k in ['source_id','title','short_title','authors','year','locator','source_type','summary'] if k in s}, ensure_ascii=False))\nprint('\\\\nSOURCE RECORD FILES')\nfor p in sorted(glob.glob(f'{base}/sources/records/*.json')):\n    with open(p, encoding='utf-8') as f: s=json.load(f)\n    print(json.dumps({k:s.get(k) for k in ['source_id','title','short_title','authors','year','venue','doi','url','summary'] if k in s}, ensure_ascii=False))\nprint('\\\\nTOPICS')\nfor p in sorted(glob.glob(f'{base}/topics/*.json')):\n    with open(p, encoding='utf-8') as f: t=json.load(f)\n    print(json.dumps({k:t.get(k) for k in ['topic_id','name','title','summary','claim_ids','source_ids'] if k in t}, ensure_ascii=False))\nprint('\\\\nCLAIMS')\nclaims=ctx.get('claims') or []\nfor c in claims:\n    print(json.dumps({k:c.get(k) for k in ['claim_id','short_title','source_id','text','evidence_excerpts'] if k in c}, ensure_ascii=False))\nprint('\\\\nRELATIONS')\nfor p in sorted(glob.glob(f'{base}/relations/*.json')):\n    with open(p, encoding='utf-8') as f: r=json.load(f)\n    print(json.dumps(r, ensure_ascii=False))\nPY\"","aggregated_output":"CTX KEYS ['claims', 'freshness', 'metadata', 'relations', 'schema_version', 'source_records', 'topics', 'warnings']\n\nSOURCES IN CTX\n{\"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"title\": \"01-an-information-integration-theory-of-consciousness--w2114900706\", \"authors\": [\"Giulio Tononi\"], \"source_type\": \"file\", \"summary\": \"Tononi’s 2004 article argues that consciousness is identical with a system’s capacity to integrate information. The theory defines Φ as effective information across a complex’s minimum information bipartition, uses complexes to delimit subjects of experience, and uses effective-information relationships to explain the quality of experience. It applies the framework to thalamocortical organization, modular cerebellar-like systems, afferent/efferent pathways, arousal systems, split-brain cases, sleep, seizures, and the possibility of graded consciousness in animals, infants, and artifacts.\"}\n{\"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"title\": \"02-mindfulness-training-modifies-subsystems-of-attention--w2132002500\", \"authors\": [\"Amishi P. Jha\", \"Jason Krompinger\", \"Michael J. Baime\"], \"source_type\": \"file\", \"summary\": \"Jha, Krompinger, and Baime report that mindfulness training changes ANT-measured attention subsystems in different ways depending on training history. Novice MBSR participants showed improved orienting after an 8-week course, experienced retreat participants showed altered alerting and faster no-cue detection after a 1-month retreat, and experienced meditators already showed reduced conflict interference at baseline. The findings are behavioral and preliminary, with important limits from group size, prior-experience differences, task repetition, and lack of active-training controls.\"}\n{\"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"title\": \"03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur--w2005105933\", \"authors\": [\"John J. Foxe\", \"Adam C. Snyder\"], \"source_type\": \"file\", \"summary\": \"Foxe and Snyder review evidence that alpha-band oscillations, especially 8-14 Hz activity, function as an active suppressive mechanism during selective attention. Across intersensory, spatial, feature-based, auditory, and tactile attention tasks, alpha power tends to increase in cortical regions responsible for processing irrelevant or distracting information, and causal and predictive evidence links stronger alpha to reduced visual excitability and weaker perception.\"}\n{\"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"title\": \"04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind--w2761197918\", \"authors\": [\"Nicholas T. Van Dam\", \"Marieke K. van Vugt\", \"David R. Vago\", \"Laura Schmalzl\", \"Clifford D. Saron\", \"Andrew Olendzki\", \"Ted Meissner\", \"Sara W. Lazar\", \"Catherine E. Kerr\", \"Jolie Gorchov\", \"Kieran C. R. Fox\", \"Brent A. Field\", \"Willoughby B. Britton\", \"Julie A. Brefczynski-Lewis\", \"David E. Meyer\"], \"source_type\": \"file\", \"summary\": \"Van Dam and colleagues argue that mindfulness research has been promoted faster than its evidence base can support. The source identifies semantic ambiguity, weak measurement, immature clinical trials, underreported adverse effects, and overinterpreted neuroimaging as major reasons for a more cautious and rigorous research agenda.\"}\n{\"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"title\": \"05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde--w2005022581\", \"authors\": [\"David R. Vago\", \"David A. Silbersweig\"], \"source_type\": \"file\", \"summary\": \"Vago and Silbersweig propose S-ART as a neurobiological framework for mindfulness, organizing practice-related change around self-awareness, self-regulation, and self-transcendence. The review argues that mindfulness practices can reduce biased narrative self-processing through interdependent mechanisms including attention and emotion regulation, extinction and reconsolidation, prosociality, non-attachment, and decentering, while calling for more precise longitudinal research on dose, practice quality, component mechanisms, and adverse effects.\"}\n\nSOURCE RECORD FILES\n{\"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"title\": \"01-an-information-integration-theory-of-consciousness--w2114900706\", \"authors\": [\"Giulio Tononi\"], \"summary\": \"Tononi’s 2004 article argues that consciousness is identical with a system’s capacity to integrate information. The theory defines Φ as effective information across a complex’s minimum information bipartition, uses complexes to delimit subjects of experience, and uses effective-information relationships to explain the quality of experience. It applies the framework to thalamocortical organization, modular cerebellar-like systems, afferent/efferent pathways, arousal systems, split-brain cases, sleep, seizures, and the possibility of graded consciousness in animals, infants, and artifacts.\"}\n{\"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"title\": \"02-mindfulness-training-modifies-subsystems-of-attention--w2132002500\", \"authors\": [\"Amishi P. Jha\", \"Jason Krompinger\", \"Michael J. Baime\"], \"summary\": \"Jha, Krompinger, and Baime report that mindfulness training changes ANT-measured attention subsystems in different ways depending on training history. Novice MBSR participants showed improved orienting after an 8-week course, experienced retreat participants showed altered alerting and faster no-cue detection after a 1-month retreat, and experienced meditators already showed reduced conflict interference at baseline. The findings are behavioral and preliminary, with important limits from group size, prior-experience differences, task repetition, and lack of active-training controls.\"}\n{\"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"title\": \"03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur--w2005105933\", \"authors\": [\"John J. Foxe\", \"Adam C. Snyder\"], \"summary\": \"Foxe and Snyder review evidence that alpha-band oscillations, especially 8-14 Hz activity, function as an active suppressive mechanism during selective attention. Across intersensory, spatial, feature-based, auditory, and tactile attention tasks, alpha power tends to increase in cortical regions responsible for processing irrelevant or distracting information, and causal and predictive evidence links stronger alpha to reduced visual excitability and weaker perception.\"}\n{\"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"title\": \"04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind--w2761197918\", \"authors\": [\"Nicholas T. Van Dam\", \"Marieke K. van Vugt\", \"David R. Vago\", \"Laura Schmalzl\", \"Clifford D. Saron\", \"Andrew Olendzki\", \"Ted Meissner\", \"Sara W. Lazar\", \"Catherine E. Kerr\", \"Jolie Gorchov\", \"Kieran C. R. Fox\", \"Brent A. Field\", \"Willoughby B. Britton\", \"Julie A. Brefczynski-Lewis\", \"David E. Meyer\"], \"summary\": \"Van Dam and colleagues argue that mindfulness research has been promoted faster than its evidence base can support. The source identifies semantic ambiguity, weak measurement, immature clinical trials, underreported adverse effects, and overinterpreted neuroimaging as major reasons for a more cautious and rigorous research agenda.\"}\n{\"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"title\": \"05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde--w2005022581\", \"authors\": [\"David R. Vago\", \"David A. Silbersweig\"], \"summary\": \"Vago and Silbersweig propose S-ART as a neurobiological framework for mindfulness, organizing practice-related change around self-awareness, self-regulation, and self-transcendence. The review argues that mindfulness practices can reduce biased narrative self-processing through interdependent mechanisms including attention and emotion regulation, extinction and reconsolidation, prosociality, non-attachment, and decentering, while calling for more precise longitudinal research on dose, practice quality, component mechanisms, and adverse effects.\"}\n\nTOPICS\n{\"topic_id\": \"topic-attention-regulation-and-sensory-selection\", \"title\": \"Attention Regulation and Sensory Selection\", \"claim_ids\": [\"claim-intention-motivation-attention-regulation-emotion-regulation-extinction-and-reco--002095abdbf2\", \"claim-mindfulness-based-meditation-is-proposed-to-modulate-self-specifying-and-narrati--0ff3acc89706\", \"claim-short-mindfulness-interventions-have-been-reported-to-improve-clinical-symptoms--38a77abb1074\", \"claim-mindfulness-training-can-improve-attention-related-behavior-by-changing-specific--f9e8e6ee54d7\", \"claim-the-attention-network-test-separates-alerting-orienting-and-conflict-monitoring--08b2302acb19\", \"claim-an-8-week-mindfulness-based-stress-reduction-course-improves-endogenous-orientin--f7bde69b7431\", \"claim-a-1-month-intensive-mindfulness-retreat-among-previously-experienced-meditators--cd2a814c579a\", \"claim-participants-with-prior-concentrative-meditation-experience-show-reduced-conflic--7b44607a9505\", \"claim-the-attentional-effects-should-be-treated-as-preliminary-because-the-study-used--8a181621f4d7\", \"claim-alpha-band-oscillations-can-be-actively-invoked-in-cortical-regions-that-p