\"claim-common-mindfulness-questionnaires-operationalize-different-facets-of-mindfulness--19920139d48a\", \"src_claim_ref\": \"1\", \"status\": \"open\"}\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-meditation-practice-is-associated-with-physiological-profiles-of-relaxed-alertne--a46fa752f290\", \"dst_claim_ref\": \"7\", \"last_evaluated_run_id\": null, \"rationale\": \"Immune and stress-reactivity findings provide concrete examples of meditation-related physiological regulation.\", \"relation_file_id\": \"rel-3a94a906fc150baad42479b010a50c5903febd3c3b7279569b783e25fac4599c\", \"relation_id\": \"supports:claim-mindfulness-based-stress-reduction-and-compassion-meditation-have-been-reported--d470d02dbd8f->claim-meditation-practice-is-associated-with-physiological-profiles-of-relaxed-alertne--a46fa752f290\", \"relation_type\": \"supports\", \"src_claim_id\": \"claim-mindfulness-based-stress-reduction-and-compassion-meditation-have-been-reported--d470d02dbd8f\", \"src_claim_ref\": \"8\", \"status\": \"open\"}\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-mindfulness-can-be-modeled-as-systematic-mental-training-that-reduces-biased-sel--6f2cabe951a3\", \"dst_claim_ref\": \"0\", \"last_evaluated_run_id\": null, \"rationale\": \"The proposed component mechanisms explain how the three S-ART capacities are cultivated and integrated.\", \"relation_file_id\": \"rel-4752460199ffe3bdee665426b15e172a2c70297acb7530ca9e667c5ba2ba3de3\", \"relation_id\": \"supports:claim-intention-motivation-attention-regulation-emotion-regulation-extinction-and-reco--002095abdbf2->claim-mindfulness-can-be-modeled-as-systematic-mental-training-that-reduces-biased-sel--6f2cabe951a3\", \"relation_type\": \"supports\", \"src_claim_id\": \"claim-intention-motivation-attention-regulation-emotion-regulation-extinction-and-reco--002095abdbf2\", \"src_claim_ref\": \"5\", \"status\": \"open\"}\n{\"be