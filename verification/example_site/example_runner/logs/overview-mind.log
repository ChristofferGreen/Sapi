re-mindfulness-research-needs-longitudinal-measurement-of-s-art-subcomponent--a2496826340c\", \"claim-mindfulness-is-not-a-unitary-construct-it-is-an-umbrella-term-spanning-diverse-p--ab25afeeb846\", \"claim-mindfulness-lacks-a-universally-accepted-technical-definition-so-empirical-findi--b873cbc87071\", \"claim-mindfulness-definition-is-ambiguous--4f220365d6f4\", \"claim-common-mindfulness-questionnaires-operationalize-different-facets-of-mindfulness--19920139d48a\", \"claim-existing-mindfulness-self-report-measures-have-unresolved-construct-validity-lim--65891880856d\", \"claim-research-on-mindfulness-should-shift-from-seeking-one-unitary-mindfulness-measur--210f23dc10a0\"], \"source_ids\": [\"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\"]}\n{\"topic_id\": \"topic-mindfulness-attention-mechanisms-and-caveats\", \"title\": \"Mindfulness, attention, and mechanism-level caveats\", \"claim_ids\": [\"claim-mindfulness-hype-exceeds-evidence--96cb023af909\", \"claim-mindfulness-definition-is-ambiguous--4f220365d6f4\", \"claim-mindfulness-training-can-improve-attention-related-behavior-by-changing-specific--f9e8e6ee54d7\", \"claim-an-8-week-mindfulness-based-stress-reduction-course-improves-endogenous-orientin--f7bde69b7431\", \"claim-a-1-month-intensive-mindfulness-retreat-among-previously-experienced-meditators--cd2a814c579a\", \"claim-participants-with-prior-concentrative-meditation-experience-show-reduced-conflic--7b44607a9505\", \"claim-the-attentional-effects-should-be-treated-as-preliminary-because-the-study-used--8a181621f4d7\", \"claim-alpha-band-oscillations-can-be-actively-invoked-in-cortical-regions-that-process--09466b39d396\", \"claim-alpha-mediated-biasing-extends-beyond-vision-appearing-in-auditory-and-tactile-s--2cd546facc83\", \"claim-higher-naturally-occurring-or-experimentally-induced-alpha-power-reduces-visual--3884cfa09119\"], \"source_ids\": [\"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\"]}\n{\"topic_id\": \"topic-operationalizing-conscious-attentional-and-mindfulness-constructs\", \"title\": \"Operationalizing mental constructs across consciousness, attention, and mindfulness research\", \"claim_ids\": [\"claim-mindfulness-definition-is-ambiguous--4f220365d6f4\", \"claim-self-report-measures-lack-validity--56550542660a\", \"claim-common-mindfulness-questionnaires-operationalize-different-facets-of-mindfulness--19920139d48a\", \"claim-existing-mindfulness-self-report-measures-have-unresolved-construct-validity-lim--65891880856d\", \"claim-research-on-mindfulness-should-shift-from-seeking-one-unitary-mindfulness-measur--210f23dc10a0\", \"claim-the-attention-network-test-separates-alerting-orienting-and-conflict-monitoring--08b2302acb19\", \"claim-instructional-cuing-paradigms-distinguish-distracter-suppression-from-probabilis--af0b5b81b7e7\", \"claim-consciousness-corresponds-to-a-system-s-capacity-to-integrate-information-becaus--ca44bbf79dcb\", \"claim-the-quantity-of-consciousness-available-to-a-system-is-measured-by-the-value-of--48abc06d417d\", \"claim-the-quality-of-consciousness-is-specified-by-the-informational-relationships-amo--52a77799b51d\"], \"source_ids\": [\"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\"]}\n{\"topic_id\": \"topic-rigor-safety-and-evidence-limits-in-mindfulness-claims\", \"title\": \"Rigor, safety, and evidence limits in mindfulness claims\", \"claim_ids\": [\"claim-clinical-evidence-remains-preliminary--117717456958\", \"claim-therapeutic-benefits-are-condition-specific--201401200700\", \"claim-adverse-effects-are-undermeasured--25fa20260426\", \"claim-neuroimaging-requires-caution--201770958900\", \"claim-research-needs-prescriptive-reform--79c0d54db997\", \"claim-mindfulness-based-interventions-show-mixed-and-condition-dependent-clinical-effi--ada76b44a400\", \"claim-meditation-related-adverse-effects-are-under-assessed-in-current-trials-so-claim--ce66cec14da3\", \"claim-mindfulness-hype-can-create-opportunity-costs-by-diverting-people-from-establish--1a47df8a5e6d\", \"claim-the-attentional-effects-should-be-treated-as-preliminary-because-the-study-used--8a181621f4d7\", \"claim-post-training-conflict-monitoring-differences-are-not-detected-among-the-mbsr-re--62de62c3ee08\"], \"source_ids\": [\"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\"]}\n{\"topic_id\": \"topic-self-processing-conscious-integration\", \"title\": \"Self-Processing and Integrated Conscious Experience\", \"claim_ids\": [\"claim-biased-narrative-self-processing-can-reify-dysfunctional-self-schemas-through-af--544c2f60e4c0\", \"claim-s-art-distinguishes-experiential-enactive-experiential-phenomenological-and-narr--3e3013b46122\", \"claim-mindfulness-based-meditation-is-proposed-to-modulate-self-specifying-and-narrati--0ff3acc89706\", \"claim-mindfulness-can-be-modeled-as-systematic-mental-training-that-reduces-biased-sel--6f2cabe951a3\", \"claim-consciousness-corresponds-to-a-system-s-capacity-to-integrate-information-becaus--ca44bbf79dcb\", \"claim-a-complex-is-an-integrated-subset-with-greater-than-zero-that-is-not-contained-i--70401a6fb458\", \"claim-the-quality-of-consciousness-is-specified-by-the-informational-relationships-amo--52a77799b51d\", \"claim-each-particular-conscious-experience-is-specified-by-the-current-activity-values--ef679659733b\", \"claim-a-distributed-thalamocortical-network-is-well-suited-to-generate-consciousness-b--571db463385d\"], \"source_ids\": [\"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\"]}\n\nCLAIMS\n{\"claim_id\": \"claim-a-1-month-intensive-mindfulness-retreat-among-previously-experienced-meditators--cd2a814c579a\", \"short_title\": \"Retreat improves alerting\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"A 1-month intensive mindfulness retreat among previously experienced meditators improves exogenous alerting-related detection when no target cue is provided.\", \"evidence_excerpts\": [\"At Time 2, the alerting difference score was significantly smaller for the retreat group than for the combined control and MBSR groups, and no-cue response times were significantly shorter in the younger retreat subgroup.\"]}\n{\"claim_id\": \"claim-a-complex-is-an-integrated-subset-with-greater-than-zero-that-is-not-contained-i--70401a6fb458\", \"short_title\": \"Complexes are experiential subjects\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"A complex is an integrated subset with Φ greater than zero that is not contained in a larger subset with higher Φ, and complexes are the loci of subjective experience.\", \"evidence_excerpts\": [\"A complex is a subset S having Φ>0 that is not included within a larger subset having higher Φ.\", \"To the extent that consciousness corresponds to the capacity to integrate information, complexes are the “subjects” of experience, being the locus where information can be integrated.\"]}\n{\"claim_id\": \"claim-a-distributed-thalamocortical-network-is-well-suited-to-generate-consciousness-b--571db463385d\", \"short_title\": \"Thalamocortical networks maximize Phi\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"A distributed thalamocortical network is well suited to generate consciousness because it combines functional specialization with functional integration.\", \"evidence_excerpts\": [\"The thalamocortical system is organized in a way that appears to emphasize at once both functional specialization and functional integration.\", \"Connection matrices yielding the highest values of information integration (Φ = 74 bits) share two key characteristics: connection patterns are different for different elements, and all elements can be reached from all other elements.\"]}\n{\"claim_id\": \"claim-adverse-effects-are-undermeasured--25fa20260426\", \"short_title\": \"Adverse effects are undermeasured\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Meditation-related adverse effects and opportunity costs are plausible, documented, and undermeasured, so safety claims based on passive reporting or absent evidence are unwarranted.\", \"evidence_excerpts\": [\"Meditation-related experiences serious or distressing enough to warrant additional treatment or medical attention have been reported in more than 20 published case reports or observational studies.\", \"Compared to 100% of pharmacology trials, less than 25% of meditation trials actively assess adverse events, relying instead on spontaneous reporting.\"]}\n{\"claim_id\": \"claim-adverse-event-assessment-in-meditation-research-needs-active-monitoring-rigorous--ae38800857f2\", \"short_title\": \"Adverse events need monitoring\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Adverse-event assessment in meditation research needs active monitoring, rigorous trial designs, and clinical interviews rather than passive safety assumptions.\", \"evidence_excerpts\": [\"Most current methods for assessing adverse effects in meditation-related research are insufficient to produce an accurate estimate; some MBI researchers have started to actively monitor adverse events through questionnaires or clinician interviews.\"]}\n{\"claim_id\": \"claim-alpha-band-oscillations-can-be-actively-invoked-in-cortical-regions-that-process--09466b39d396\", \"short_title\": \"Alpha suppresses distractors\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Alpha-band oscillations can be actively invoked in cortical regions that process irrelevant or distracting information, making alpha a mechanism of attentional suppression.\", \"evidence_excerpts\": [\"The review states that alpha-band oscillations can be actively invoked in cortical regions across multiple sensory systems when those regions process irrelevant or distracting information.\"]}\n{\"claim_id\": \"claim-alpha-mediated-biasing-extends-beyond-vision-appearing-in-auditory-and-tactile-s--2cd546facc83\", \"short_title\": \"Alpha bias spans senses\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Alpha-mediated biasing extends beyond vision, appearing in auditory and tactile spatial attention with increases over cortical regions ipsilateral to the cued direction.\", \"evidence_excerpts\": [\"Auditory spatial attention studies found alpha-band increases over parietal cortex ipsilateral to the cued direction, and tactile studies found increases over somatosensory cortex ipsilateral to the cued direction.\"]}\n{\"claim_id\": \"claim-an-8-week-mindfulness-based-stress-reduction-course-improves-endogenous-orientin--f7bde69b7431\", \"short_title\": \"MBSR improves orienting\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"An 8-week mindfulness-based stress reduction course improves endogenous orienting relative to control and retreat groups at post-training testing.\", \"evidence_excerpts\": [\"An ANOVA for the RT difference scores of the orienting component revealed a significant factor of group [F(2,48) = 10.13, p < .001]. A series of contrasts revealed that the MBSR group differed from the control group and the retreat group.\"]}\n{\"claim_id\": \"claim-anatomical-or-functional-disconnection-within-thalamocortical-systems-can-reduce--89adceb072c5\", \"short_title\": \"Disconnection reduces conscious level\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Anatomical or functional disconnection within thalamocortical systems can reduce, split, or selectively alter consciousness by changing the system’s integrated-information structure.\", \"evidence_excerpts\": [\"If the “callosum-like” connections are removed, the main complex breaks down into two smaller complexes, each of which still has a high value of Φ.\", \"If the “auditory” module is functionally disconnected from the rest, the main complex includes just the “supramodal” and “visual” modules.\"]}\n{\"claim_id\": \"claim-attention-related-alpha-modulation-appears-primarily-controlled-by-cortico-corti--1eb91088cf2b\", \"short_title\": \"Cortical networks control alpha\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Attention-related alpha modulation appears primarily controlled by cortico-cortical frontal and parietal networks, with thalamo-cortical connections possibly contributing secondarily.\", \"evidence_excerpts\": [\"The conclusion contrasts attention-related alpha modulations, described as mainly cortico-cortical and involving frontal and parietal regions, with arousal-related alpha that is more likely thalamus-dominated.\"]}\n{\"claim_id\": \"claim-biased-narrative-self-processing-can-reify-dysfunctional-self-schemas-through-af--544c2f60e4c0\", \"short_title\": \"Narrative bias reifies schemas\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Biased narrative self-processing can reify dysfunctional self-schemas through affect-biased attention, rumination, and repeated maladaptive interpretation.\", \"evidence_excerpts\": [\"The model of a psychopathological self-schema is depicted in Figure 1 in which habitual negative beliefs about the self (including their personal world and future), become reified through the continuous reinforcement of a feedback loop of affect-biased attention influencing subjective and behavioral symptoms and vice-versa.\"]}\n{\"claim_id\": \"claim-clinical-evidence-remains-preliminary--117717456958\", \"short_title\": \"Clinical evidence remains preliminary\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Clinical evidence for mindfulness-based interventions remains preliminary because much intervention research has not advanced beyond early-stage efficacy designs and often lacks active controls or real-world practice tests.\", \"evidence_excerpts\": [\"Dimidjian and Segal estimate that only 30% of research using mindfulness-based interventions has moved beyond Stage 1; 20% was Stage 2a, 9% Stage 2b, and only 1% outside research contexts.\", \"MBIs compared to active controls were found to have a mixture of only moderate, low, or no efficacy, depending on the disorder being treated.\"]}\n{\"claim_id\": \"claim-common-mindfulness-questionnaires-operationalize-different-facets-of-mindfulness--19920139d48a\", \"short_title\": \"Measures capture different facets\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Common mindfulness questionnaires operationalize different facets of mindfulness, so comparisons across studies require scrutiny of exactly which construct each measure captures.\", \"evidence_excerpts\": [\"Table 1 lists mindfulness measures with different contexts and factors, including FMI as general, MAAS as attentiveness and awareness, KIMS as observing/describing/awareness/acceptance, FFMQ as nonreactivity/observing/awareness/describing/nonjudging, and TMS as curiosity/decentering.\", \"Self-report measures often highlight attention, awareness, and acceptance or nonjudgment rather than discernment.\"]}\n{\"claim_id\": \"claim-consciousness-corresponds-to-a-system-s-capacity-to-integrate-information-becaus--ca44bbf79dcb\", \"short_title\": \"Consciousness integrates information\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Consciousness corresponds to a system’s capacity to integrate information, because conscious experience is both highly differentiated and unified.\", \"evidence_excerpts\": [\"The theory presented here claims that consciousness has to do with the capacity to integrate information.\", \"Phenomenological analysis indicates that consciousness has to do with the ability to integrate a large amount of information.\"]}\n{\"claim_id\": \"claim-consciousness-is-graded-rather-than-all-or-none-and-could-in-principle-exist-in--76ebdb9cb6bc\", \"short_title\": \"High Phi enables artifacts\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Consciousness is graded rather than all-or-none and could in principle exist in infants, animals, or artificial systems when they possess complexes with sufficiently high Φ.\", \"evidence_excerpts\": [\"Consciousness is not an all-or-none property, but it is graded: to varying degrees, it should exist in most natural and artificial systems.\", \"It should be possible to construct conscious artifacts by endowing them with a complex of high Φ.\"]}\n{\"claim_id\": \"claim-contemplative-neuroscience-findings-about-mindfulness-are-vulnerable-to-oversimp--944ad1b9ad23\", \"short_title\": \"Neuroimaging evidence is limited\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Contemplative neuroscience findings about mindfulness are vulnerable to oversimplified public interpretation, group-level averaging, cross-sectional confounds, movement and cardiorespiratory artifacts, and uncertain practical significance.\", \"evidence_excerpts\": [\"Representative pictures from fMRI and other neuroimaging methods do not clearly convey the complex chain of biological and computational steps behind inferences about brain structure and function, nor that such inferences are frequently derived from group averages.\", \"Many neuroimaging studies have used cross-sectional designs, precluding possible inferences about underlying cause-and-effect relationships, and physical artifacts involving head movements and cardiorespiratory effects are especially notable.\"]}\n{\"claim_id\": \"claim-during-visual-spatial-attention-alpha-band-power-increases-over-occipital-cortex--09a99b87f400\", \"short_title\": \"Spatial alpha targets distractors\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"During visual spatial attention, alpha-band power increases over occipital cortex ipsilateral to the attended side and retinotopically targets areas likely to receive distracters.\", \"evidence_excerpts\": [\"Figure 2 reports a sustained divergence beginning at about 500 ms, with alpha-band TSE amplitudes larger over occipital cortex ipsilateral to the direction of attention.\"]}\n{\"claim_id\": \"claim-each-particular-conscious-experience-is-specified-by-the-current-activity-values--ef679659733b\", \"short_title\": \"Current states specify experiences\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Each particular conscious experience is specified by the current activity values of the variables that mediate informational interactions within a complex.\", \"evidence_excerpts\": [\"Each conscious state is defined by the set of all its coordinates, which are given by the activity values of all elements of a complex.\", \"Each particular conscious experience is specified by the value, at any given time, of the variables mediating informational interactions among the elements of a complex.\"]}\n{\"claim_id\": \"claim-existing-mindfulness-self-report-measures-have-unresolved-construct-validity-lim--65891880856d\", \"short_title\": \"Self reports remain uncertain\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Existing mindfulness self-report measures have unresolved construct-validity limits and may not track exactly what practice teaches.\", \"evidence_excerpts\": [\"Although some self-report questionnaire measures of mindfulness seem to be effective in revealing particular mental and physical changes associated with practicing mindfulness, how closely these measures track exactly what is taught during practice remains unclear.\"]}\n{\"claim_id\": \"claim-feature-based-visual-attention-increases-alpha-power-in-dorsal-or-ventral-stream--0c7646ad3b93\", \"short_title\": \"Feature alpha suppresses irrelevant streams\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Feature-based visual attention increases alpha power in dorsal or ventral stream regions when those regions process an irrelevant feature.\", \"evidence_excerpts\": [\"The feature-attention study isolated alpha-reactive components whose power differed by attended feature; dorsal stream sources increased when motion was irrelevant and ventral sources increased when color was irrelevant.\"]}\n{\"claim_id\": \"claim-future-mindfulness-research-needs-longitudinal-measurement-of-s-art-subcomponent--a2496826340c\", \"short_title\": \"Research needs longitudinal rigor\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Future mindfulness research needs longitudinal measurement of S-ART subcomponents, dose effects, practice quality, and possible adverse effects.\", \"evidence_excerpts\": [\"It is likely that future research in the contemplative sciences will provide a developmental trajectory of different S-ART-specific subcomponents and individual differences across duration and frequency of practice.\", \"It is also critical that the emerging field examine the adverse effects of long-term practice—effects that typically go unnoticed in clinical trials, but are more prevalent in longer retreats and in practitioners that may or may not have a predisposition toward developing psychopathology.\"]}\n{\"claim_id\": \"claim-future-mindfulness-research-should-replace-generic-labels-with-precise-descripti--0291ee9277c4\", \"short_title\": \"Specific protocols improve research\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Future mindfulness research should replace generic labels with precise descriptions of meditation features, intervention protocols, teacher characteristics, participant histories, controls, and adverse-event monitoring.\", \"evidence_excerpts\": [\"Table 2 lists defining features for meditation practice, including arousal, orientation of attention, spatial and temporal dynamics of attention, object of attention, aperture, and effort.\", \"Table 3 lists study design features for a mindfulness-based intervention, including teacher information, practice information, instructor adherence, control group, randomization/allocation method, adverse events monitored, inclusion/exclusion criteria, prior meditation experience, and conflicts of interest.\"]}\n{\"claim_id\": \"claim-future-mindfulness-science-should-emphasize-preregistration-open-science-replica--ad9bbbab2603\", \"short_title\": \"Future science needs rigor\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Future mindfulness science should emphasize preregistration, open-science replications, stronger clinical controls, adverse-event warnings, and modest communication of neuroimaging results.\", \"evidence_excerpts\": [\"Future studies of mindfulness should conform to lessons from the replication crisis, including preregistered experiments and open-science replications, while clinical applications should seek more uniformity and better control.\"]}\n{\"claim_id\": \"claim-higher-naturally-occurring-or-experimentally-induced-alpha-power-reduces-visual--3884cfa09119\", \"short_title\": \"Alpha lowers visual excitability\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Higher naturally occurring or experimentally induced alpha power reduces visual cortical excitability and predicts weaker perceptual detection.\", \"evidence_excerpts\": [\"Romei et al. found that 10 Hz TMS impaired visual detection contralateral to stimulation, improved ipsilateral detection, and produced no comparable effects at 5 or 20 Hz.\"]}\n{\"claim_id\": \"claim-in-intersensory-attention-tasks-attending-to-audition-increases-8-14-hz-parieto--6ff6ff285662\", \"short_title\": \"Auditory attention gates vision\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"In intersensory attention tasks, attending to audition increases 8-14 Hz parieto-occipital alpha activity before the audiovisual target, consistent with anticipatory gating of visual processing.\", \"evidence_excerpts\": [\"Figure 1 describes greater 8-14 Hz alpha activity in the 300 ms before the compound S2 when attention is cued to the auditory modality rather than the visual modality.\"]}\n{\"claim_id\": \"claim-instructional-cuing-paradigms-distinguish-distracter-suppression-from-probabilis--af0b5b81b7e7\", \"short_title\": \"Instructional cues isolate distractors\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Instructional cuing paradigms distinguish distracter suppression from probabilistic orienting because uncued locations never require a response.\", \"evidence_excerpts\": [\"In instructional cuing, participants respond only to targets at the cued location and ignore uncued locations completely, turning uncued locations into sources of potential distraction.\"]}\n{\"claim_id\": \"claim-intention-motivation-attention-regulation-emotion-regulation-extinction-and-reco--002095abdbf2\", \"short_title\": \"Multiple mechanisms support S-ART\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Intention, motivation, attention regulation, emotion regulation, extinction and reconsolidation, prosociality, non-attachment, and decentering are proposed as interdependent mechanisms supporting S-ART.\", \"evidence_excerpts\": [\"These mechanisms include intention and motivation, attention and emotion regulation, extinction and reconsolidation, prosociality, non-attachment, and de-centering.\"]}\n{\"claim_id\": \"claim-meditation-can-be-associated-with-clinically-significant-adverse-experiences-and--ee33e7577df8\", \"short_title\": \"Meditation can harm\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Meditation can be associated with clinically significant adverse experiences, and assumptions of minimal adverse effects rest more on lack of research than substantive evidence.\", \"evidence_excerpts\": [\"Meditation-related experiences serious or distressing enough to warrant additional treatment or medical attention have been reported in more than 20 published case reports or observational studies.\"]}\n{\"claim_id\": \"claim-meditation-practice-is-associated-with-physiological-profiles-of-relaxed-alertne--a46fa752f290\", \"short_title\": \"Meditation shifts physiology\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Meditation practice is associated with physiological profiles of relaxed alertness, including reduced sympathetic markers and increased parasympathetic activity.\", \"evidence_excerpts\": [\"Studies comparing experienced meditators to controls or short-term meditators have demonstrated a particular physiological profile across styles of practice suggestive of an alert, but hypometabolic state in which there is decreased sympathetic nervous system activity, and increased parasympathetic activity.\"]}\n{\"claim_id\": \"claim-meditation-related-adverse-effects-are-under-assessed-in-current-trials-so-claim--ce66cec14da3\", \"short_title\": \"Adverse effects are underassessed\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Meditation-related adverse effects are under-assessed in current trials, so claims that meditation is free of adverse effects rest on inadequate evidence.\", \"evidence_excerpts\": [\"Less than 25% of meditation trials actively assess adverse effects, compared to 100% of pharmacology trials, and many rely on spontaneous reporting that may underestimate adverse-effect frequency by more than 20-fold.\", \"The article states that the assumption of minimal adverse effects associated with meditation is largely based on a lack of research rather than substantive evidence.\"]}\n{\"claim_id\": \"claim-mindfulness-and-meditation-practices-can-be-contraindicated-for-some-psychiatric--6fe966926b20\", \"short_title\": \"Meditation has contraindications\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness and meditation practices can be contraindicated for some psychiatric conditions and vulnerable populations without appropriate clinical monitoring.\", \"evidence_excerpts\": [\"Official standards of practice for MBSR exclude suicidality and the presence of any psychiatric disorder, with case-by-case exceptions requiring adequate medical treatment or sufficient clinical training by the instructor.\", \"The American Psychiatric Association, the U.S. National Institutes of Health, and leading researchers have expressed concerns that meditation may be contraindicated under several circumstances, including schizophrenia spectrum disorders, bipolar disorder, post-traumatic stress disorder, depression, and risk factors for psychosis.\"]}\n{\"claim_id\": \"claim-mindfulness-based-interventions-show-a-mixed-pattern-of-moderate-low-or-absent-e--2eba873d6241\", \"short_title\": \"Efficacy is mixed\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness-based interventions show a mixed pattern of moderate, low, or absent efficacy depending on outcome and disorder.\", \"evidence_excerpts\": [\"Compared to active controls, MBIs were found to have a mixture of only moderate, low, or no efficacy depending on the disorder being treated.\"]}\n{\"claim_id\": \"claim-mindfulness-based-interventions-show-mixed-and-condition-dependent-clinical-effi--ada76b44a400\", \"short_title\": \"MBI efficacy is mixed\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness-based interventions show mixed and condition-dependent clinical efficacy rather than uniformly strong therapeutic benefit.\", \"evidence_excerpts\": [\"A review and meta-analysis commissioned by the U.S. Agency for Healthcare Research and Quality found that MBIs compared to active controls had a mixture of only moderate, low, or no efficacy depending on the disorder being treated.\", \"The source reports moderate efficacy for reducing anxiety, depression, and pain symptoms; low efficacy for reducing stress and improving quality of life; and no effect or insufficient evidence for attention, positive mood, substance abuse, eating habits, sleep, and weight control.\"]}\n{\"claim_id\": \"claim-mindfulness-based-interventions-vary-substantially-in-content-delivery-instructo--8ecee4c072be\", \"short_title\": \"Interventions vary substantially\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness-based interventions vary substantially in content, delivery, instructor training, homework, and participant population, limiting broad efficacy claims across interventions.\", \"evidence_excerpts\": [\"The varieties of interventions labeled as mindful differ in content, meeting type and frequency, instructions, homework, readings, instructor or therapist training, and accessibility.\"]}\n{\"claim_id\": \"claim-mindfulness-based-meditation-is-proposed-to-modulate-self-specifying-and-narrati--0ff3acc89706\", \"short_title\": \"Fronto-parietal control integrates self\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Mindfulness-based meditation is proposed to modulate self-specifying and narrative self networks through an integrative fronto-parietal control network.\", \"evidence_excerpts\": [\"The development of S-ART through meditation is proposed to modulate self-specifying and narrative self-networks through an integrative fronto-parietal control network.\"]}\n{\"claim_id\": \"claim-mindfulness-based-stress-reduction-and-compassion-meditation-have-been-reported--d470d02dbd8f\", \"short_title\": \"Practice alters stress markers\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Mindfulness-based stress reduction and compassion meditation have been reported to influence immune and stress-reactivity markers.\", \"evidence_excerpts\": [\"Davidson and colleagues (2003b) found that MBSR produced significant increases in antibody titers to influenza vaccine compared with those subjects in a wait-list control group.\", \"Pace and colleagues (2010) reported that after 6-weeks of compassion meditation practice, there were reduced innate cytokine (IL-6) and subjective distress responses to a standardized laboratory psychosocial stressor [Trier Social Stress Test (TSST)].\"]}\n{\"claim_id\": \"claim-mindfulness-can-be-modeled-as-systematic-mental-training-that-reduces-biased-sel--6f2cabe951a3\", \"short_title\": \"Mindfulness reduces self-bias\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Mindfulness can be modeled as systematic mental training that reduces biased self-processing by developing self-awareness, self-regulation, and self-transcendence.\", \"evidence_excerpts\": [\"Within this framework, mindfulness is described to reduce such biases through specific forms of mental training that develop meta-awareness of self (self-awareness), an ability to effectively manage or alter one’s responses and impulses (self-regulation), and the development of a positive relationship between self and other that transcends self-focused needs and increases prosocial characteristics (self-transcendence).\"]}\n{\"claim_id\": \"claim-mindfulness-definition-is-ambiguous--4f220365d6f4\", \"short_title\": \"Mindfulness is ambiguous\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"The term mindfulness lacks a universally accepted technical definition and often conflates heterogeneous mental faculties, practices, interventions, and measurement targets.\", \"evidence_excerpts\": [\"There is neither one universally accepted technical definition of “mindfulness” nor any broad agreement about detailed aspects of the underlying concept to which it refers.\", \"A 5-minute meditation exercise from a popular phone application might be treated the same as a 3-month meditation retreat, and a self-report questionnaire might be equated with the characteristics of someone who has spent decades practicing.\"]}\n{\"claim_id\": \"claim-mindfulness-hype-can-create-opportunity-costs-by-diverting-people-from-establish--1a47df8a5e6d\", \"short_title\": \"Hype imposes opportunity costs\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness hype can create opportunity costs by diverting people from established treatments or other activities more likely to help their condition.\", \"evidence_excerpts\": [\"The article defines opportunity cost as time and money invested in a treatment approach with little to no therapeutic benefit relative to a treatment more likely to yield improvement, and says opportunity cost may be a widespread side effect of MBI hype.\", \"The source warns that exaggerated claims may mislead vulnerable patients with serious diseases and divert them from more traditional activities, psychotherapy, or pharmacotherapy.\"]}\n{\"claim_id\": \"claim-mindfulness-hype-exceeds-evidence--96cb023af909\", \"short_title\": \"Hype exceeds evidence\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness and meditation have become widely promoted in clinical, educational, corporate, military, and media contexts despite an evidence base that remains uneven and vulnerable to exaggeration.\", \"evidence_excerpts\": [\"Fig. 1 tracks scientific and news media articles on mindfulness and/or meditation by year from 1970 to 2015, using Scopus for empirical scientific articles and LexisNexis for newspaper media pieces.\", \"During the past two decades, mindfulness meditation has gone from being a fringe topic of scientific investigation to being an occasional replacement for psychotherapy, tool of corporate well-being, widely implemented educational practice, and “key to building more resilient soldiers.”\"]}\n{\"claim_id\": \"claim-mindfulness-is-not-a-unitary-construct-it-is-an-umbrella-term-spanning-diverse-p--ab25afeeb846\", \"short_title\": \"Mindfulness is semantically broad\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness is not a unitary construct; it is an umbrella term spanning diverse practices, processes, and characteristics related to attention, awareness, memory, acceptance, and discernment.\", \"evidence_excerpts\": [\"Mindfulness is an umbrella term used to characterize a large number of practices, processes, and characteristics, largely defined in relation to the capacities of attention, awareness, memory/retention, and acceptance/discernment.\", \"Consensus about the semantic ambiguity of mindfulness. Mindfulness does not constitute a unitary construct, though it frequently includes aspects of paying attention in a specific, sustained, nonjudgmental way.\"]}\n{\"claim_id\": \"claim-mindfulness-lacks-a-universally-accepted-technical-definition-so-empirical-findi--b873cbc87071\", \"short_title\": \"Mindfulness lacks shared definition\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness lacks a universally accepted technical definition, so empirical findings require careful specification of the mental states, practices, and interventions under study.\", \"evidence_excerpts\": [\"There is neither one universally accepted technical definition of mindfulness nor any broad agreement about detailed aspects of the underlying concept to which it refers.\"]}\n{\"claim_id\": \"claim-mindfulness-research-should-adopt-preregistration-open-science-replication-caref--5f747418bb67\", \"short_title\": \"Rigor should increase\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness research should adopt preregistration, open-science replication, careful terminology, stronger controls, systematic adverse-event assessment, and modest reporting of neuroimaging results.\", \"evidence_excerpts\": [\"The conclusion recommends nuanced terminology for distinct mental and physical states and behaviors associated with mindfulness, preregistered experiments, open-science replications, uniform and better controlled clinical applications, warnings about generalization to clinical practice, and modest reporting of contemplative-neuroscience findings.\", \"The source says no amount of sophisticated statistical prowess can correct results from faulty or confounded methods.\"]}\n{\"claim_id\": \"claim-mindfulness-training-can-improve-attention-related-behavior-by-changing-specific--f9e8e6ee54d7\", \"short_title\": \"Training modifies attention subsystems\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"Mindfulness training can improve attention-related behavior by changing specific attentional subsystems rather than producing a single global attention benefit.\", \"evidence_excerpts\": [\"The study examined alerting, orienting, and conflict monitoring with the Attention Network Test before and after mindfulness training, and the authors report different post-training effects for MBSR and retreat participants.\"]}\n{\"claim_id\": \"claim-neuroimaging-findings-about-mindfulness-are-preliminary-and-vulnerable-to-oversi--d3431c27c5c9\", \"short_title\": \"Brain findings stay preliminary\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Neuroimaging findings about mindfulness are preliminary and vulnerable to oversimplification, group-level confounding, physical artifacts, and unclear practical significance.\", \"evidence_excerpts\": [\"Representative pictures from fMRI and other neuroimaging methods do not clearly convey the complex chain of biological and computational steps that lead to inferences about changes in brain structure and function.\"]}\n{\"claim_id\": \"claim-neuroimaging-requires-caution--201770958900\", \"short_title\": \"Neuroimaging requires caution\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Neuroimaging evidence on meditation can suggest modest brain differences, but group averages, cross-sectional designs, cardiorespiratory artifacts, head motion, and interpretive oversimplification limit causal and practical conclusions.\", \"evidence_excerpts\": [\"Representative pictures from fMRI and other neuroimaging methods do not clearly convey the complex chain of biological and computational steps that lead to inferences about brain structure and function.\", \"Many neuroimaging studies have used cross-sectional designs, precluding possible inferences about underlying cause-and-effect relationships.\"]}\n{\"claim_id\": \"claim-participants-with-prior-concentrative-meditation-experience-show-reduced-conflic--7b44607a9505\", \"short_title\": \"Experience reduces conflict\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"Participants with prior concentrative meditation experience show reduced conflict-monitoring interference at baseline relative to meditation-naive participants.\", \"evidence_excerpts\": [\"At Time 1, the retreat group differed from the combined control and MBSR participants for conflict monitoring in RT [t(1,49) = 2.22, p = .03] and accuracy [t(1,49) = 5.62, p < .001].\"]}\n{\"claim_id\": \"claim-post-training-conflict-monitoring-differences-are-not-detected-among-the-mbsr-re--62de62c3ee08\", \"short_title\": \"Conflict gains fade\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"Post-training conflict-monitoring differences are not detected among the MBSR, retreat, and control groups, possibly because task repetition improves conflict scores in controls.\", \"evidence_excerpts\": [\"An ANOVA for the conflict monitoring component RT and accuracy difference scores revealed no significant main effects and no significant effects on any of the paired contrasts (p > .36).\"]}\n{\"claim_id\": \"claim-research-needs-prescriptive-reform--79c0d54db997\", \"short_title\": \"Research needs reform\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Future mindfulness research should use precise terminology, stronger construct measures, active controls, preregistration, adverse-event monitoring, detailed intervention reporting, and cautious public communication.\", \"evidence_excerpts\": [\"Table 3 proposes study design features for mindfulness-based interventions, including teacher information, practice information, instructor adherence, control group use, randomization, adverse-event monitoring, participant criteria, prior meditation experience, and conflicts of interest.\", \"Researchers should adopt more nuanced terminology, follow replication-crisis lessons such as preregistered experiments and open-science replications, and report contemplative-neuroscience findings with due modesty.\"]}\n{\"claim_id\": \"claim-research-on-mindfulness-should-shift-from-seeking-one-unitary-mindfulness-measur--210f23dc10a0\", \"short_title\": \"Specific functions should replace unity\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Research on mindfulness should shift from seeking one unitary mindfulness measure toward measuring specific biological, emotional, cognitive, behavioral, and social functions changed by training.\", \"evidence_excerpts\": [\"Scientific research on the aggregate of mental states labeled by mindfulness would benefit from redirecting attempts to directly measure mindfulness toward measuring supporting mental faculties.\"]}\n{\"claim_id\": \"claim-reticular-sensory-afferent-motor-efferent-and-subcortical-loop-activity-can-modu--173db43834c9\", \"short_title\": \"Ports influence without belonging\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Reticular, sensory afferent, motor efferent, and subcortical loop activity can modulate or affect the thalamocortical main complex without directly contributing to conscious experience.\", \"evidence_excerpts\": [\"Neural elements that have widespread and effective connections to a main complex of high Φ may nevertheless remain informationally excluded from it.\", \"Elements in afferent pathways can affect the main complex without belonging to it.\"]}\n{\"claim_id\": \"claim-s-art-distinguishes-experiential-enactive-experiential-phenomenological-and-narr--3e3013b46122\", \"short_title\": \"Self-processing has three systems\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"S-ART distinguishes experiential enactive, experiential phenomenological, and narrative self-processing systems as targets of mindfulness-related modulation.\", \"evidence_excerpts\": [\"The networks identified in the S-ART framework elaborates upon past conceptualizations of self and distinguishes between two functional aspects of self-specifying processes, (1) non-conscious sensory-affective-motor processing, referred to here as the experiential enactive self (EES); (2) an agentic, self-as-subject acting as awareness in the present moment, referred to as an experiential phenomenological self (EPS). The S-ART also distinguishes between self-specifying processes and self-related processes, which refer to the evaluative self-as-object, reflecting the autobiographical narrative reconstructed from the past or projected into the future.\"]}\n{\"claim_id\": \"claim-s-art-treats-mindfulness-as-a-multidimensional-skillset-rather-than-a-single-uni--019ffda0022f\", \"short_title\": \"Mindfulness is multidimensional\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"S-ART treats mindfulness as a multidimensional skillset rather than a single unitary cognitive capacity.\", \"evidence_excerpts\": [\"Thus, rather than reducing mindfulness down to a unitary dimension, the S-ART describes mindfulness in a broader framework of perceptual, physiological, cognitive, emotional, and behavioral component processes.\"]}\n{\"claim_id\": \"claim-self-report-measures-lack-validity--56550542660a\", \"short_title\": \"Self reports lack validity\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Self-report mindfulness questionnaires often have weak construct validity because scale meanings, factor structures, item interpretation, social desirability, and introspective limitations vary across participants and practice histories.\", \"evidence_excerpts\": [\"Table 1 lists multiple mindfulness measures with different theoretical contexts and factor structures, including FMI, MAAS, KIMS, FFMQ, TMS, CAMS-R, PHLMS, SMQ, and SMS.\", \"Several of these scales exhibit different factor structures and response properties between meditators and nonmeditators, as well as before and after mindfulness training.\"]}\n{\"claim_id\": \"claim-short-mindfulness-interventions-have-been-reported-to-improve-clinical-symptoms--38a77abb1074\", \"short_title\": \"Brief training can change outcomes\", \"source_id\": \"source-05-self-awareness-self-regulation-and-self-transcendence-s-art-a-framework-for-unde-w2005022581--615ee4e1923f\", \"text\": \"Short mindfulness interventions have been reported to improve clinical symptoms, executive function, and white matter connectivity, although dosage and quality questions remain unresolved.\", \"evidence_excerpts\": [\"In fact, there have been reported improvements in clinical symptoms and executive function in short-term training of specific mindfulness-based practices as short as three 20 min sessions (Zeidan et al., 2010) and changes in white matter connectivity after 11 h of training (Tang et al., 2010).\"]}\n{\"claim_id\": \"claim-strongly-modular-neural-architectures-can-be-computationally-sophisticated-yet-c--212c143093c3\", \"short_title\": \"Modularity lowers conscious integration\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"Strongly modular neural architectures can be computationally sophisticated yet contribute little to consciousness because they generate many small low-Φ complexes rather than one high-Φ complex.\", \"evidence_excerpts\": [\"A strongly modular network, consisting of three modules of eight strongly interconnected elements each, yields Φ = 20 bits for each of its three modules.\", \"The large complex encompassing all the elements has an extremely low Φ value of 5 bits.\"]}\n{\"claim_id\": \"claim-sustained-focal-alpha-increases-above-pre-cue-baseline-during-rapid-bilateral-st--8699d621dccc\", \"short_title\": \"Alpha is active suppression\", \"source_id\": \"source-03-the-role-of-alpha-band-brain-oscillations-as-a-sensory-suppression-mechanism-dur-w2005105933--7b6b7d5bc8b9\", \"text\": \"Sustained focal alpha increases above pre-cue baseline during rapid bilateral stimulation support an active suppression account rather than a mere return to cortical idling.\", \"evidence_excerpts\": [\"In the Kelly et al. rapid bilateral letter-stream experiment, alpha power ipsilateral to attention rose above pre-cue baseline while bilateral stimulation continued, and contralateral decreases were not observed.\"]}\n{\"claim_id\": \"claim-the-attention-network-test-separates-alerting-orienting-and-conflict-monitoring--08b2302acb19\", \"short_title\": \"ANT partitions attention\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"The Attention Network Test separates alerting, orienting, and conflict monitoring by subtracting performance across predefined cue and target conditions.\", \"evidence_excerpts\": [\"Alerting was indexed by subtracting performance measures on double-cue trials from those on no-cue trials; orienting by subtracting spatial-cue trials from center-cue trials; and conflict monitoring by subtracting congruent target trials from incongruent target trials.\"]}\n{\"claim_id\": \"claim-the-attentional-effects-should-be-treated-as-preliminary-because-the-study-used--8a181621f4d7\", \"short_title\": \"Findings require caution\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"The attentional effects should be treated as preliminary because the study used small groups, no active-training control, behavioral measures only, and imperfect control over training protocols.\", \"evidence_excerpts\": [\"The discussion states that the results should be interpreted cautiously, that the training groups included relatively small numbers of participants, and that future work should include an active-training control group and neural measurements.\"]}\n{\"claim_id\": \"claim-the-clinical-evidence-base-for-mindfulness-based-interventions-is-too-immature-t--464dc35b525d\", \"short_title\": \"Clinical evidence remains immature\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"The clinical evidence base for mindfulness-based interventions is too immature to justify broad real-world implementation without stronger controls and later-stage research.\", \"evidence_excerpts\": [\"Only 30% of research using mindfulness-based interventions has moved beyond Stage 1; 9% of the total has been conducted at Stage 2b, and only 1% has been conducted outside research contexts.\"]}\n{\"claim_id\": \"claim-the-clinical-evidence-base-for-mindfulness-based-interventions-remains-insuffici--fd5df4ed74a7\", \"short_title\": \"Clinical evidence remains immature\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"The clinical evidence base for mindfulness-based interventions remains insufficiently mature for broad routine clinical implementation.\", \"evidence_excerpts\": [\"Dimidjian and Segal estimate, using the NIH stage model, that only 30% of research using mindfulness-based interventions has moved beyond Stage 1, with 20% at Stage 2a, 9% at Stage 2b, and only 1% conducted outside research contexts.\", \"The article states that this is a woefully inadequate research base to inform whether MBIs are ready for use in regular clinical practice.\"]}\n{\"claim_id\": \"claim-the-quality-of-consciousness-is-specified-by-the-informational-relationships-amo--52a77799b51d\", \"short_title\": \"Qualia space determines quality\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"The quality of consciousness is specified by the informational relationships among the elements of a complex, represented as an effective-information-defined qualia space.\", \"evidence_excerpts\": [\"The values of effective information among the elements of a complex, by defining the relationships among these dimensions, specify the structure of this space.\", \"The effective information matrix defines the set of informational relationships, or “qualia space” for each complex.\"]}\n{\"claim_id\": \"claim-the-quantity-of-consciousness-available-to-a-system-is-measured-by-the-value-of--48abc06d417d\", \"short_title\": \"Phi measures conscious quantity\", \"source_id\": \"source-01-an-information-integration-theory-of-consciousness-w2114900706--09db8f102f39\", \"text\": \"The quantity of consciousness available to a system is measured by the Φ value of a complex, where Φ is effective information across the minimum information bipartition.\", \"evidence_excerpts\": [\"Φ is the amount of effective information that can be exchanged across the minimum information bipartition of a complex.\", \"The minimum information bipartition MIB(S) is the bipartition for which the normalized effective information reaches a minimum, and the corresponding value is Φ(S).\"]}\n{\"claim_id\": \"claim-therapeutic-benefits-are-condition-specific--201401200700\", \"short_title\": \"Benefits are condition specific\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Mindfulness-based therapies may help some people and conditions, particularly some depression-related contexts, but they should not be treated as broadly superior to established treatments.\", \"evidence_excerpts\": [\"MBCT may be modestly helpful for some individuals with residual symptoms of depression, and some guidelines endorse MBCT for preventing relapse in remitted patients with three or more previous depressive episodes.\", \"Head-to-head comparisons of MBIs to other evidence-based practices have resulted in mixed findings, and direct comparisons of MBIs to empirically established treatments are limited.\"]}\n{\"claim_id\": \"claim-undifferentiated-use-of-mindfulness-and-meditation-can-make-brief-app-exercises--0796f143a40c\", \"short_title\": \"Umbrella labels distort comparison\", \"source_id\": \"source-04-mind-the-hype-a-critical-evaluation-and-prescriptive-agenda-for-research-on-mind-w2761197918--79c0d54db997\", \"text\": \"Undifferentiated use of mindfulness and meditation can make brief app exercises, intensive retreats, questionnaires, and long-term practice appear falsely comparable.\", \"evidence_excerpts\": [\"With current use of umbrella terms, a 5-minute meditation exercise from a popular phone application might be treated the same as a 3-month meditation retreat, and a self-report questionnaire might be equated with decades of meditation practice.\"]}\n{\"claim_id\": \"claim-within-the-retreat-group-greater-prior-meditation-experience-predicts-a-smaller--3ca73021a60e\", \"short_title\": \"Experience predicts alerting\", \"source_id\": \"source-02-mindfulness-training-modifies-subsystems-of-attention-w2132002500--696402dc8f78\", \"text\": \"Within the retreat group, greater prior meditation experience predicts a smaller Time 2 alerting score, consistent with a more readied attentional state.\", \"evidence_excerpts\": [\"The correlation value (R = -.52) was significant (t = 2.4, p = .03), indicating a significant reduction in alerting score with increased meditation experience in the retreat group.\"]}\n\nRELATIONS\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-neuroimaging-requires-caution--201770958900\", \"dst_claim_ref\": \"6\", \"last_evaluated_run_id\": null, \"rationale\": \"The recommendation for cautious public communication follows from the limits of neuroimaging interpretation.\", \"relation_file_id\": \"rel-1b789e43587c4c5dfb00a072c0a138a8789a98712fd6bbdc07b3e533210904c4\", \"relation_id\": \"derived_from:claim-research-needs-prescriptive-reform--79c0d54db997->claim-neuroimaging-requires-caution--201770958900\", \"relation_type\": \"derived_from\", \"src_claim_id\": \"claim-research-needs-prescriptive-reform--79c0d54db997\", \"src_claim_ref\": \"7\", \"status\": \"open\"}\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-mindfulness-research-should-adopt-preregistration-open-science-replication-caref--5f747418bb67\", \"dst_claim_ref\": \"9\", \"last_evaluated_run_id\": null, \"rationale\": \"Neuroimaging limitations motivate the broader agenda for modest reporting and stronger methods.\", \"relation_file_id\": \"rel-26dc7335e5cf2add18b2ae401420adcca4a78fbf8cda29ece7411bf120a5263a\", \"relation_id\": \"supports:claim-contemplative-neuroscience-findings-about-mindfulness-are-vulnerable-to-oversimp--944ad1b9ad23->claim-mind