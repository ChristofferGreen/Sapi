: \"claim-therapeutic-benefits-are-condition-specific--201401200700\", \"dst_claim_ref\": \"4\", \"last_evaluated_run_id\": null, \"rationale\": \"The preliminary clinical evidence base constrains claims about broad therapeutic benefit.\", \"relation_file_id\": \"rel-c876baee884235d0e58e5449c649efdeb15037e2530e5f45b09c760896159077\", \"relation_id\": \"supports:claim-clinical-evidence-remains-preliminary--117717456958->claim-therapeutic-benefits-are-condition-specific--201401200700\", \"relation_type\": \"supports\", \"src_claim_id\": \"claim-clinical-evidence-remains-preliminary--117717456958\", \"src_claim_ref\": \"3\", \"status\": \"open\"}\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-mindfulness-hype-exceeds-evidence--96cb023af909\", \"dst_claim_ref\": \"0\", \"last_evaluated_run_id\": null, \"rationale\": \"Undermeasured adverse effects raise the stakes of public hype and overconfident implementation.\", \"relation_file_id\": \"rel-cc7dcba6246f5cb4c4c953b50a73b2b6319b7d3711c277626681d9fa7172497f\", \"relation_id\": \"supports:claim-adverse-effects-are-undermeasured--25fa20260426->claim-mindfulness-hype-exceeds-evidence--96cb023af909\", \"relation_type\": \"supports\", \"src_claim_id\": \"claim-adverse-effects-are-undermeasured--25fa20260426\", \"src_claim_ref\": \"5\", \"status\": \"open\"}\n{\"below_040_streak\": 0, \"contradiction_confidence_band\": \"unknown\", \"dst_claim_id\": \"claim-mindfulness-is-not-a-unitary-construct-it-is-an-umbrella-term-spanning-diverse-p--ab25afeeb846\", \"dst_claim_ref\": \"0\", \"last_evaluated_run_id\": null, \"rationale\": \"The proposed feature and protocol descriptions are a remedy for the claim that mindfulness is semantically broad.\", \"relation_file_id\": \"rel-f66b46ea2fa2d7c833eb7843e0cee4b8d86c4d1b6e3890b54b9740cac35a771d\", \"relation_id\": \"supports:claim-future-mindfulness-research-should-replace-generic-labels-with-precise-descripti--0291ee9277c4->claim-min