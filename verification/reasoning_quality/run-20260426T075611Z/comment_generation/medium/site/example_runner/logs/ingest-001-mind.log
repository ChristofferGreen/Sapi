      <div class="data"><div class="main-wrapper" role="main"><div class="main-content"><noscript><div class="h2"><span id="challenge-error-text">Enable JavaScript and cookies to continue</span></div></noscript></div></div><script>(function(){window._cf_chl_opt = {cFPWv: 'g',cH: 't0nQYClsuqmoEGXSwfht22fhYNXjR8WLkUWdcYW01Fo-1777189671-1.2.1.1-oT.2y3IOwV5HY7Ps6loZSg41ZMDAZ_Ys0aBl19S.XZOEseAPSlTZxBi96XJ1gKCF',cITimeS: '1777189671',cRay: '9f23fb578bbcec42',cTplB: '0',cTplC:1,cTplO:0,cTplV:5,cType: 'managed',cUPMDTk:"/backend-api/plugins/featured?platform=codex&__cf_chl_tk=rsLMD9OzfoCpCpdJxeIpe71HbYPlme.1Uw6CE_YsmRw-1777189671-1.0.1.1-RvYl9U_8DU3vZSXc17roR7qBi3mYYKTVQCm4TvyuuMk",cvId: '3',cZone: 'chatgpt.com',fa:"/backend-api/plugins/featured?platform=codex&__cf_chl_f_tk=rsLMD9OzfoCpCpdJxeIpe71HbYPlme.1Uw6CE_YsmRw-1777189671-1.0.1.1-RvYl9U_8DU3vZSXc17roR7qBi3mYYKTVQCm4TvyuuMk",md: 'urvJjMq9FzOBY4jwNvlh8kWQxPOxT.xZBjCb0SR4.1Q-1777189671-1.2.1.1-AfhN5MbE.myGSPp8uy3ZBWlrG942cJpy1qbtKwZyHPRCYMu16bVeKUzsohH6i7n21eJ1ZNsiCdgS7K8nqwVhcYCz0IQ8KK1p2hR8xuAX3UC.K5s_wQwqKgknpVt1ac6tx5.g.IFMYlTp2erUJJUnxwzdrCSwnnvXEObDq51az1ruu0l0Xb39a0AZJOpTkPtrjOVrx_RKQH8o.VLA8Gm3BrjQ2WC3uZh.R7LbmisnxObJa_uC17uLPtxwRCWrzEzuUEpJt3K80hilF1UCdCwRyv2aiUggzN.lZ1OIRdxOMI7fWto8dTcmzUjY2143V2QAGpOaDILk1aGRG4HZsLXUnrXe4p4XtXzA4cqD8YL4RHP22wJ4y6ggR8d.adqj8NYIVFCtlQDfpk6HIQF38GrzuyGGyDgyufANYcQjcb6v16pY0BBGlm3FOSMfickNdBeA1dmdbb5fppZ2l3DiLUXlZXTHRp1J4JkRILoHm4FusPy8ch4pi9pg2iEJSt.CDAJbcXFLyRRT_wAhAvzk10Z_T4BQiPCFCBfuz.cXcPM1qWqFzxgiN9MyyQF6HLFVkIW9yLnHgajibpY8HsV4bPy.uxZ.c2MjlRyXlLv1H5b1HIZ30bHthg6ZZYfRGcTTtv5h0e42iobexCSUkTWuml6dFMXWNVKjFtimGuhF.EGWezvmC4bXx1kl1SDO59rh5fcm91NIZumxA217.jmYj7LkdWE441sGrfeRzJ6mxvvI8f62Ec.g7tYKe3wxDO49.LYFjQ7lVjK8EGcEyz4EoC0o1xPL3nq_Bz_0VitCfFOVN07ZId8Sh8iN883Y20aQLUSbEZX6rX_.ROARirAeuTQHyxGhWZ_GdQPqn9i9OkTAtyndnY7W2fMWTx5xtmkLr2IxXxxaUhnRyZ72lpkHZ6IyocrtRiCHE96egW7y5wL.LO8Xke9_f_jYxnqzvUNabD21nxgCuliTpGaXERgYj8i.xdaRZm8HOcoZ..pP4lpPlJ66ZNZM5OVAdbkY0FahKJ2i',mdrd: 'UDeISpDrZa7O01